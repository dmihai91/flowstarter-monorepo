# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
bun.lock
/.sass-cache
/connect.lock
/coverage
/\.local
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Private keys / keystores (never commit)
*.pem
*.p12
*.pfx

.nx/cache
.nx/workspace-data
mprocs.log

# Environment files — NEVER commit secrets
# Ignore all .env files across the entire monorepo
.env
.env.*
!.env.example
!.env.*.example
!.env.shared.example
!.env.test.example

# Cloudflare Wrangler — local-only secrets for `wrangler dev`
**/.dev.vars

# E2E auth session data (contains tokens/cookies)
**/.auth/

# Playwright MCP / local agent logs
.playwright-mcp/

# Claude Code — machine-local overrides (paths, permissions)
**/.claude/settings.local.json

# M4 sync scripts
m4-sync.sh
m4-pull.sh
m4-dev.sh

# Test artifacts & screenshots
e2e/screenshots/
playwright-report/
test-results/

# Dev screenshots / artifacts
docs/screenshots/

# Next.js build output
.next/

# Coverage reports (nested)
**/coverage/

# Local Netlify folder
.netlify
