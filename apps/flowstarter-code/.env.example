CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Clerk satellite mode — shares sessions with the main platform app.
# CLERK_DOMAIN and SIGN_IN_URL must match the main app's Clerk instance.
NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_DOMAIN=.flowstarter.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://flowstarter.dev/team/login

# T3 Code host URL loaded inside the iframe.
# Next.js rewrites /t3/* → 127.0.0.1:3773 so the default works
# for both local dev and production behind Cloudflare.
FLOWSTARTER_CODE_URL=/t3

# Skip T3 Env validation (set to "1" in Docker builds or CI)
# SKIP_ENV_VALIDATION=1
