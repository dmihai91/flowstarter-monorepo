{
  "name": "@flowstarter/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Flowstarter editor — multitenant web GUI for the concierge service, forked from T3 Code (Electron stripped). Server + web + shared packages.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @flowstarter/editor-server --filter @flowstarter/editor-web --parallel run dev",
    "dev:server": "pnpm --filter @flowstarter/editor-server run dev",
    "dev:web": "pnpm --filter @flowstarter/editor-web run dev",
    "build": "pnpm --filter @flowstarter/editor-server --filter @flowstarter/editor-web run build",
    "typecheck": "pnpm --filter './server' --filter './web' --filter './packages/*' run typecheck",
    "test": "pnpm --filter './server' --filter './web' --filter './packages/*' run test"
  },
  "engines": {
    "node": ">=22"
  }
}
