# Editor server env — copy this to `.env` and fill in.
#
# `pnpm dev:editor` will also pick up the main app's `.env.local` /
# `.env` automatically (envBootstrap.ts), so for local dev you can leave
# this file empty as long as those exist with the keys below.

# -- Local server port ----------------------------------------------------
# T3 Code's upstream default is 3773. The Flowstarter team typically runs
# the upstream T3 Code Electron app on this port locally, so the editor
# fork uses 5773 to avoid the collision. Web vite stays on 5733.

T3CODE_PORT=5773

# -- Local state dir ------------------------------------------------------
# Upstream T3 Code stores its sqlite + settings under ~/.t3. Sharing that
# with the upstream T3 Code Electron app causes schema-mismatch decode
# errors (Flowstarter fork drifts independently). Keep state isolated.

T3CODE_HOME=~/.flowstarter-editor

# -- Anthropic agent (required) -------------------------------------------
# The editor's coding agent talks to Anthropic directly (separate billing
# from the OpenRouter-backed admin AI helpers in flowstarter-main).

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # optional override

# -- Clerk auth gate ------------------------------------------------------
# Required for the Clerk auto-pair flow. Without these the editor falls
# back to T3's manual pairing UI.

# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...               # optional, hardens SDK
# CLERK_SIGN_IN_URL=https://flowstarter.dev/login # default is fine
# CLERK_AUTHORIZED_PARTIES=https://editor.flowstarter.app
#
# LAN / iPad: mirror the main app's public URLs (envBootstrap loads main .env too).
# NEXT_PUBLIC_SITE_URL=http://192.168.1.5:3000
# CLERK_SIGN_IN_URL=http://192.168.1.5:3000/login   # optional override if bootstrap default is wrong
#
# If you keep localhost in CLERK_SIGN_IN_URL but open the editor from another device,
# set both flags so sign-in and ClerkProvider use your LAN host (main app must listen on :3000).
# EDITOR_ASSUME_MAIN_ON_SAME_HOST=true
# (web/.env.local) VITE_ASSUME_MAIN_ON_SAME_HOST=true
#
# Browser / pairing links when the server binds to 0.0.0.0 but you open from another device:
# T3CODE_BROWSER_BASE_URL=http://192.168.1.5:5773
#
# Web dev server (apps/flowstarter-editor/web): listens on 0.0.0.0 by default; set HOST=localhost to restrict.
# In web/.env.local you can set VITE_CLERK_SIGN_IN_URL=http://192.168.1.5:3000/login or rely on NEXT_PUBLIC_SITE_URL at vite build time.

# -- Supabase (workspace lookup) ------------------------------------------
# Required so the auth gate can resolve role + tier + workspace memberships.

# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
