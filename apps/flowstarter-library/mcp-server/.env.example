# Authentication (configure Clerk for users, the internal token for workers,
# or both). The internal value must be an independent 32+ character secret.
# Get these from https://dashboard.clerk.com

CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
FLOWSTARTER_MCP_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

# HTTP Server Configuration (for --mode=http)
HTTP_PORT=3001
HTTP_HOST=0.0.0.0
CORS_ORIGIN=*

# For local testing only - bypasses Clerk authentication
# NEVER use this in production!
# DISABLE_AUTH=true

# Supabase Configuration (REQUIRED for project management)
# Get these from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
