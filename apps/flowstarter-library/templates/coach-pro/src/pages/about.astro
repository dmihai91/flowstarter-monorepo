---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import StatsRow from '../../../shared/dorin-ds/components/StatsRow.astro';
import QuoteBlock from '../../../shared/dorin-ds/components/QuoteBlock.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import GalleryGrid from '../../../shared/dorin-ds/components/GalleryGrid.astro';
import { frontmatter as galleryData } from '../../content/gallery.md';

interface GalleryItem {
  src: string;
  alt: string;
  span?: string;
  aspect?: string;
  tag?: string;
  caption?: string;
}
interface GalleryContent {
  eyebrow?: string;
  title?: string;
  side_note?: string;
  items?: GalleryItem[];
}

const gallery = galleryData as GalleryContent;

const journey = [
  {
    number: '2014',
    title: 'Started in operations',
    description:
      'After Harvard MBA, I joined a Series B startup as Chief of Staff. Built systems, ran ops, watched leaders flounder. Realized the bottleneck was rarely strategy — it was the operator.',
  },
  {
    number: '2017',
    title: 'First coaching engagements',
    description:
      'Began informal coaching with founders in my network. Watched the same patterns repeat: capable people stuck in their own loops. Started studying the practice formally.',
  },
  {
    number: '2019',
    title: 'ICF certification',
    description:
      'Completed Columbia University Executive Coaching certification. ICF Professional Certified Coach (PCC) credential. Began full-time practice.',
  },
  {
    number: 'Today',
    title: '500+ engagements later',
    description:
      'Working with leaders across tech, finance, and healthcare. 96% of my clients hit the goals we set in the first 90 days. The work is rigorous and unsentimental, and that is exactly the point.',
  },
];

const credentials = [
  'ICF Professional Certified Coach (PCC) — 2019',
  'Certified Executive Coach — Columbia University, 2018',
  'MBA — Harvard Business School, 2014',
  'BA in Behavioral Economics — Stanford University, 2010',
  'Member, International Coaching Federation',
  "Co-author, “The Operator’s Playbook” (2022)",
];

const stats = [
  { number: '500+', label: 'Coaching engagements' },
  { number: '96%', label: 'Goal achievement rate' },
  { number: '12', label: 'Years in practice' },
  { number: '$48M+', label: "Aggregate client revenue lift" },
];
---

<Layout
  title="About — Mara Petrescu"
  description="Twelve years coaching leaders, founders, and operators. ICF certified, Harvard MBA, no nonsense."
  activeIndex={2}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="cp-about-hero">
      <div class="cp-about-hero__copy">
        <OverlineText text="About" tone="accent" />
        <h1 class="cp-about-hero__title">
          Twelve years of<br />
          rigorous, unsentimental<br />
          <em>coaching</em>.
        </h1>
        <p class="cp-about-hero__lede">
          I'm Mara Petrescu. I help leaders and operators do what they
          already know they should be doing — clearly, consistently, and
          without the usual amount of self-deception.
        </p>
      </div>
      <div class="cp-about-hero__plate" aria-hidden="true">
        <div class="cp-about-hero__plate-image"></div>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Quote ───────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="compact">
    <Container className="cp-about-quote">
      <QuoteBlock
        quote="Most of my clients don't need new information. They need someone who will hold them accountable to the information they already have."
      />
    </Container>
  </SectionBlock>

  <!-- ─── Stats ───────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="Track record"
        title="Twelve years, in numbers."
        align="center"
      />
      <StatsRow items={stats} />
    </Container>
  </SectionBlock>

  <!-- ─── Approach ────────────────────────────────────────── -->
  <SectionBlock id="approach" tone="dark" padding="default">
    <Container className="cp-about-approach">
      <div class="cp-about-approach__heading">
        <OverlineText text="My approach" tone="accent" />
        <h2 class="section-title cp-about-approach__title">
          What I actually do<br />when we work together.
        </h2>
      </div>
      <div class="cp-about-approach__copy">
        <p>
          I am not a cheerleader, and I am not a therapist. My job is to be
          the most thoughtful, persistent question you have access to —
          someone who notices what you stop saying mid-sentence, what you
          rationalize, and what you keep avoiding even when you've named it.
        </p>
        <p>
          The methodology blends three things. <strong>Cognitive
          behavioral techniques</strong> for the patterns that repeat across
          contexts. <strong>Strategic thinking</strong> for the decisions
          that matter. <strong>Operating discipline</strong> — the boring,
          essential rigor of doing what you said you'd do.
        </p>
        <p>
          You'll leave each session with one or two specific commitments.
          We'll review them next week. If you didn't do them, we'll talk
          honestly about why. There is no judgment, but there is also no
          slack.
        </p>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Journey ─────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="cp-about-journey">
      <div class="cp-about-journey__heading">
        <OverlineText text="Journey" />
        <h2 class="section-title">How I got here.</h2>
      </div>
      <div class="cp-about-journey__list">
        {
          journey.map((j) => (
            <NumberedFeatureItem
              number={j.number}
              title={j.title}
              description={j.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Credentials ─────────────────────────────────────── -->
  <SectionBlock id="credentials" tone="subtle" padding="default">
    <Container>
      <SectionHeading
        label="Credentials"
        title="Training & affiliations."
        align="center"
      />
      <ul class="cp-about-credentials">
        {
          credentials.map((c) => (
            <li class="cp-about-credentials__item">
              <span class="cp-about-credentials__mark" aria-hidden="true">
                ◆
              </span>
              {c}
            </li>
          ))
        }
      </ul>
    </Container>
  </SectionBlock>

  <!-- ─── Gallery ─────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default" topBorder>
    <Container>
      <GalleryGrid
        eyebrow={gallery.eyebrow}
        title={gallery.title}
        sideNote={gallery.side_note}
        items={gallery.items ?? []}
      />
    </Container>
  </SectionBlock>

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="cp-about-cta">
      <h2 class="cp-about-cta__title">Ready to see if we're a fit?</h2>
      <p class="cp-about-cta__lede">
        The discovery call is 30 minutes, free, and pressure-free. If we're
        not a match, I'll point you to a coach who is.
      </p>
      <ActionButton
        href="/contact"
        label="Book discovery call"
        variant="primary-light"
        size="large"
        className="fs-book-btn"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .cp-about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .cp-about-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .cp-about-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .cp-about-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 56ch;
  }

  .cp-about-hero__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .cp-about-hero__plate-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=900&h=1100&fit=crop');
    background-size: cover;
    background-position: center;
    filter: contrast(1.04) saturate(0.9);
  }

  /* Quote */
  .cp-about-quote {
    max-width: 920px;
  }

  /* Approach */
  .cp-about-approach {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 80px;
  }

  .cp-about-approach__heading {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .cp-about-approach__title {
    color: var(--text-on-dark);
    margin-top: 16px;
    max-width: 16ch;
  }

  .cp-about-approach__copy {
    display: grid;
    gap: 24px;
    max-width: 64ch;
  }

  .cp-about-approach__copy p {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--text-on-dark);
  }

  .cp-about-approach__copy strong {
    color: var(--brand-primary);
    font-weight: var(--fw-semibold);
  }

  /* Journey */
  .cp-about-journey {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 80px;
    align-items: start;
  }

  .cp-about-journey__heading {
    position: sticky;
    top: 100px;
  }

  .cp-about-journey__heading .section-title {
    margin-top: 16px;
    max-width: 12ch;
  }

  .cp-about-journey__list {
    border-top: 1px solid var(--surface-subtle-border);
  }

  /* Credentials */
  .cp-about-credentials {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 40px;
    max-width: 820px;
    margin: 0 auto;
  }

  .cp-about-credentials__item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 12px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .cp-about-credentials__mark {
    color: var(--brand-primary);
    font-size: 0.75em;
    line-height: 1.5;
  }

  /* CTA */
  .cp-about-cta {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cp-about-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .cp-about-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-nav);
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .cp-about-hero,
    .cp-about-approach,
    .cp-about-journey {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .cp-about-approach__heading,
    .cp-about-journey__heading {
      position: static;
    }

    .cp-about-credentials {
      grid-template-columns: 1fr;
    }
  }
</style>
