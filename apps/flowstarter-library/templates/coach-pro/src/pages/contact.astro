---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ContactCard from '../../../shared/dorin-ds/components/ContactCard.astro';
import FormField from '../../../shared/dorin-ds/components/FormField.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface BookingContent {
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

const booking = bookingData as BookingContent;
---

<Layout
  title="Contact — James Parker Coaching"
  description="Book a 30-minute discovery call. Tell me about your goals and we'll figure out if coaching is the right fit."
  activeIndex={3}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="cp-contact-hero">
      <OverlineText text="Get in touch" tone="accent" />
      <h1 class="cp-contact-hero__title">
        Let's see if we're<br />
        <em>the right fit</em>.
      </h1>
      <p class="cp-contact-hero__lede">
        The first conversation is a 30-minute discovery call — free, no
        commitment, no sales pitch. Tell me what you're working on, and
        I'll tell you honestly whether I can help.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── Cal.com booking ─────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default">
    <Container className="cp-contact-cal">
      <CalBookingBlock
        variant="inline"
        calLink={booking.cal_link}
        eventLabel={booking.cal_event_label}
        title={booking.title}
        subtitle={booking.description}
        durationLabel={booking.cal_duration_label}
        layout={booking.cal_layout}
      />
    </Container>
  </SectionBlock>

  <!-- ─── Contact (form + info) ───────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="cp-contact-grid">
      <div class="cp-contact-grid__form-col">
        <h2 class="cp-contact-grid__form-title">Book a discovery call</h2>
        <p class="cp-contact-grid__form-lede">
          Fill this in and I'll reach out within 24 hours to schedule. The
          more you tell me about your situation, the more useful our first
          conversation will be.
        </p>

        <div
          id="form-success"
          class="cp-contact-grid__alert cp-contact-grid__alert--success"
          hidden
        >
          Thank you — I'll be in touch within 24 hours.
        </div>
        <div
          id="form-error"
          class="cp-contact-grid__alert cp-contact-grid__alert--error"
          hidden
        >
          Something went wrong. Please try again or email me directly.
        </div>

        <form
          id="contact-form"
          data-contact-form
          data-success-message="Thank you — I'll be in touch within 24 hours."
          class="cp-contact-grid__form"
        >
          <input type="hidden" name="_template" value="" />
          <input type="hidden" name="_source" value="" />

          <div class="cp-contact-grid__row">
            <FormField
              type="text"
              name="firstName"
              label="First name"
              placeholder="Your first name"
              required
            />
            <FormField
              type="text"
              name="lastName"
              label="Last name"
              placeholder="Your last name"
              required
            />
          </div>

          <FormField
            type="email"
            name="email"
            label="Email"
            placeholder="you@example.com"
            required
          />

          <FormField
            type="tel"
            name="phone"
            label="Phone (optional)"
            placeholder="(555) 234-5678"
          />

          <FormField
            type="textarea"
            name="message"
            label="What are you working on?"
            placeholder="Tell me about your goals, what's blocking you, and what you've already tried..."
            required
          />

          <button type="submit" class="cp-contact-grid__submit">
            Request discovery call
          </button>

          <p class="cp-contact-grid__note">
            Your information is kept strictly confidential. You'll hear back
            within one business day.
          </p>
        </form>
      </div>

      <aside class="cp-contact-grid__info-col">
        <h3 class="cp-contact-grid__info-title">Or reach out directly</h3>
        <div class="cp-contact-grid__info-cards">
          <ContactCard
            label="Email"
            value="coach@jamesparker.com"
            href="mailto:coach@jamesparker.com"
            hint="Replies within 24 hours, weekdays"
          />
          <ContactCard
            label="Phone"
            value="(555) 234-5678"
            href="tel:+15552345678"
            hint="Mon–Fri, 8am–6pm CT"
          />
          <ContactCard
            label="Office"
            value="Austin, TX"
            hint="456 Executive Blvd, Suite 300 — in-person sessions by appointment"
          />
        </div>

        <div class="cp-contact-grid__hours">
          <span class="cp-contact-grid__hours-label">Coaching hours</span>
          <ul class="cp-contact-grid__hours-list">
            <li><span>Mon — Fri</span><span>8:00 — 18:00 CT</span></li>
            <li><span>Saturday</span><span>By appointment</span></li>
            <li><span>Sunday</span><span>Closed</span></li>
          </ul>
        </div>
      </aside>
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .cp-contact-hero {
    max-width: 880px;
  }

  .cp-contact-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .cp-contact-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .cp-contact-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 60ch;
  }

  /* Grid */
  .cp-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .cp-contact-grid__form-title {
    font-size: var(--fs-h3);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--bg-dark);
    margin-bottom: 16px;
  }

  .cp-contact-grid__form-lede {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .cp-contact-grid__form {
    display: grid;
    gap: 20px;
  }

  .cp-contact-grid__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .cp-contact-grid__alert {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    margin-bottom: 24px;
  }

  .cp-contact-grid__alert[hidden] {
    display: none;
  }

  .cp-contact-grid__alert--success {
    background: rgba(124, 152, 133, 0.16);
    color: #3a5544;
    border: 1px solid rgba(124, 152, 133, 0.32);
  }

  .cp-contact-grid__alert--error {
    background: rgba(220, 80, 80, 0.12);
    color: #8a2a2a;
    border: 1px solid rgba(220, 80, 80, 0.32);
  }

  .cp-contact-grid__submit {
    margin-top: 8px;
    padding: 18px 32px;
    font-family: var(--font-button);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border: 1px solid var(--bg-dark);
    transition: opacity var(--transition);
  }

  .cp-contact-grid__submit:hover {
    opacity: 0.85;
  }

  .cp-contact-grid__note {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
  }

  /* Info column */
  .cp-contact-grid__info-title {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .cp-contact-grid__info-cards {
    display: grid;
    gap: 16px;
    margin-bottom: 40px;
  }

  .cp-contact-grid__hours {
    padding: 28px 24px;
    background: var(--surface-subtle);
    border-radius: var(--radius-md);
  }

  .cp-contact-grid__hours-label {
    display: block;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .cp-contact-grid__hours-list {
    display: grid;
    gap: 8px;
  }

  .cp-contact-grid__hours-list li {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 6px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .cp-contact-grid__hours-list li:last-child {
    border-bottom: none;
  }

  @media (max-width: 1024px) {
    .cp-contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 600px) {
    .cp-contact-grid__row {
      grid-template-columns: 1fr;
    }
  }
</style>
