---
import Layout from '../layouts/Layout.astro';
import '../../../shared/editorial.css';

const nav = [
  { label: 'Coaching', href: '#work' },
  { label: 'Approach', href: '#studio' },
  { label: 'Programs', href: '#fees' },
  { label: 'Contact', href: '#contact' },
];
const stats = [
  { n: '120+', l: 'Leaders coached' },
  { n: '94%', l: 'Clients rebook' },
  { n: '6 mo', l: 'Typical engagement' },
];
const work = [
  { src: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=1400&h=1750&fit=crop', alt: 'A founder in a working session', tag: 'Founders', place: 'Seed → Series B', span: 'tall' },
  { src: 'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=1400&h=1050&fit=crop', alt: 'A leadership conversation', tag: 'Operators', place: 'Scaling teams', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=1200&h=1500&fit=crop', alt: 'Notes during a strategy call', tag: 'New managers', place: 'First 90 days', span: 'reg' },
  { src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1400&h=1050&fit=crop', alt: 'A founder, considered', tag: 'Executives', place: 'High-stakes calls', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=1200&h=1500&fit=crop', alt: 'A coaching session in progress', tag: 'Boards', place: 'Hard conversations', span: 'tall' },
];
const offerings = [
  { k: '01', name: '1:1 coaching', body: 'A standing weekly hour for the decisions and conversations that don\'t wait.', price: 'from €420 / mo' },
  { k: '02', name: 'The intensive', body: 'A focused two-day reset for a specific transition — a raise, a restructure, a hard pivot.', price: 'from €2,400' },
  { k: '03', name: 'Retainer advisory', body: 'On-call thinking partner for the founder who needs a steady outside voice.', price: 'from €1,800 / mo' },
  { k: '04', name: 'Team workshops', body: 'Practical sessions on feedback, decisions, and difficult conversations for the whole team.', price: 'on request' },
];
---
<Layout>
  <div class="grain" aria-hidden="true"></div>
  <header class="nav">
    <a href="#top" class="brand"><span class="brand__mark" aria-hidden="true"></span>Mara&nbsp;Petrescu</a>
    <nav class="nav__links" aria-label="Primary">{nav.map((i) => <a href={i.href}>{i.label}</a>)}</nav>
    <div class="nav__right">
      <button type="button" class="themer" data-themer aria-label="Toggle dark mode"><span class="themer__dot"></span></button>
      <a href="#contact" class="btn btn--sm">Book a strategy call</a>
    </div>
  </header>
  <main id="top">
    <section class="hero">
      <div class="hero__copy reveal">
        <p class="eyebrow">Executive coaching — Lisbon &amp; online</p>
        <h1 class="display">Lead with<br />more<br /><em>clarity.</em></h1>
        <p class="lede">I'm Mara Petrescu. I help founders, operators, and newly stretched leaders think more clearly, make cleaner decisions, and lead without living in a permanent state of tension.</p>
        <div class="hero__cta">
          <a href="#contact" class="btn">Book a strategy call</a>
          <a href="#work" class="link-arrow">See client wins →</a>
        </div>
        <dl class="stats">{stats.map((s) => (<div><dt>{s.n}</dt><dd>{s.l}</dd></div>))}</dl>
      </div>
      <figure class="hero__plate reveal" style="--d:.15s">
        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1100&h=1450&fit=crop" alt="Mara Petrescu, executive coach" loading="eager" />
        <figcaption><span>ICF ACC</span> 120+ leaders coached</figcaption>
      </figure>
    </section>
    <div class="strip" aria-hidden="true"><div class="strip__row">
      <span>Founders</span><span class="dot">✦</span><span>Operators</span><span class="dot">✦</span><span>New managers</span><span class="dot">✦</span><span>Hard conversations</span><span class="dot">✦</span><span>Decisions</span><span class="dot">✦</span>
      <span>Founders</span><span class="dot">✦</span><span>Operators</span><span class="dot">✦</span><span>New managers</span><span class="dot">✦</span><span>Hard conversations</span><span class="dot">✦</span><span>Decisions</span><span class="dot">✦</span>
    </div></div>
    <section class="section" id="work">
      <div class="section__head"><p class="eyebrow">Who I work with</p><h2 class="h2">Leaders carrying more than they signed up for.</h2></div>
      <div class="gallery">{work.map((w, i) => (
        <figure class={`gal gal--${w.span} reveal`} style={`--d:${i * 0.06}s`}><img src={w.src} alt={w.alt} loading="lazy" /><figcaption><span class="gal__tag">{w.tag}</span><span class="gal__place">{w.place}</span></figcaption></figure>
      ))}</div>
    </section>
    <section class="section studio" id="studio">
      <figure class="studio__img reveal"><img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=1000&h=1250&fit=crop" alt="Mara Petrescu" loading="lazy" /></figure>
      <div class="studio__copy reveal" style="--d:.1s">
        <p class="eyebrow">How I work</p>
        <h2 class="h2">Direct, warm,<br />and practical.</h2>
        <p>Fifteen years operating and advising taught me that most leadership problems aren't strategy problems — they're clarity problems. We cut through the noise to the two or three things that actually move, then build the habits to hold them.</p>
        <p>Sessions are confidential, candid, and structured around what's live for you that week. No frameworks for the sake of frameworks. You leave each call knowing exactly what you're doing next, and why.</p>
        <p class="sig">— Mara</p>
      </div>
    </section>
    <section class="section" id="fees">
      <div class="section__head"><p class="eyebrow">Programs</p><h2 class="h2">Ways to work together.</h2></div>
      <ul class="offer">{offerings.map((o) => (
        <li class="offer__row reveal"><span class="offer__k">{o.k}</span><span class="offer__name">{o.name}</span><span class="offer__body">{o.body}</span><span class="offer__price">{o.price}</span></li>
      ))}</ul>
      <p class="offer__note">Every engagement opens with a free 30-minute strategy call and a written plan. No templates, no pitch decks.</p>
    </section>
    <section class="quote reveal">
      <blockquote>“Three months in, my leadership team stopped waiting on me for every call. Mara didn't give me a framework — she gave me back my judgement.”</blockquote>
      <cite>David Chen — founder &amp; CEO</cite>
    </section>
    <section class="cta" id="contact">
      <p class="eyebrow eyebrow--accent">A free 30-minute strategy call</p>
      <h2 class="display cta__title">Let's get<br />to&nbsp;clarity.</h2>
      <p class="cta__lede">Tell me what's on your plate. We'll spend 30 minutes on the real problem and you'll leave with something useful whether or not we work together.</p>
      <div class="cta__actions"><a href="mailto:hello@marapetrescu.com" class="btn btn--lg">Book a strategy call</a><a href="tel:+351912000000" class="link-arrow">+351 912 000 000</a></div>
    </section>
  </main>
  <footer class="foot">
    <div class="foot__top">
      <div class="foot__brand">Mara Petrescu</div>
      <div class="foot__cols">
        <div><h4>Coaching</h4><a href="#fees">1:1 coaching</a><a href="#fees">The intensive</a><a href="#fees">Retainer</a></div>
        <div><h4>About</h4><a href="#studio">Approach</a><a href="#fees">Programs</a><a href="#contact">Contact</a></div>
        <div><h4>Elsewhere</h4><a href="#">LinkedIn</a><a href="#">Substack</a><a href="mailto:hello@marapetrescu.com">Email</a></div>
      </div>
    </div>
    <div class="foot__base"><span>© 2026 Mara Petrescu Advisory</span><span>Lisbon · Online across Europe</span></div>
  </footer>
  <script is:inline>
    (function () { var btn = document.querySelector('[data-themer]'); if (btn) btn.addEventListener('click', function () { var dark = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', dark); document.documentElement.classList.toggle('dark', dark); try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (_) {} }); })();
    (function () { var els = document.querySelectorAll('.reveal'); if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; } var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.12 }); els.forEach(function (e) { io.observe(e); }); })();
  </script>
  <style is:global>
    :root { --bg:#eef0f7; --bg-2:#e3e7f3; --surface:#f8f9fd; --ink:#191c28; --ink-soft:#414659; --muted:#787f96; --accent:#4a5ed8; --accent-2:#6f80ea; --line:rgba(25,28,40,.13); --line-soft:rgba(25,28,40,.07); --shadow:0 30px 70px -30px rgba(25,28,40,.42); --grain:.035; }
    html.theme-dark, html.dark { --bg:#0e1018; --bg-2:#141726; --surface:#161a28; --ink:#eef0f8; --ink-soft:#cdd2e3; --muted:#8b92aa; --accent:#8c98f2; --accent-2:#a6b0f6; --line:rgba(238,240,248,.15); --line-soft:rgba(238,240,248,.08); --shadow:0 30px 80px -30px rgba(0,0,0,.7); --grain:.06; }
  </style>
</Layout>
