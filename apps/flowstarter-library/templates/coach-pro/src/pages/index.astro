---
import Layout from '../layouts/Layout.astro';

const nav = [
  { label: 'Outcomes', href: '#outcomes' },
  { label: 'Method', href: '#method' },
  { label: 'Coaching', href: '#coaching' },
  { label: 'Book', href: '#book' },
];

const cred = [
  { n: '11 yrs', l: 'Coaching leaders' },
  { n: '200+', l: 'Managers & founders' },
  { n: '9 / 10', l: 'Would refer me' },
];

const stats = [
  { n: '200+', l: 'Leaders coached since 2015' },
  { n: '11', l: 'Years inside scaling teams' },
  { n: '9/10', l: 'Clients who refer me on' },
  { n: '6 wk', l: 'To a sharper decision rhythm' },
];

const method = [
  { n: '01', t: 'Map', b: 'We start with what is actually on your plate. The decisions you keep avoiding, the people problems draining you, where your week really goes.' },
  { n: '02', t: 'Focus', b: 'We name the two or three things that move the most. No twenty-point plan, just the few changes that change everything else.' },
  { n: '03', t: 'Practice', b: 'You try them in real situations between sessions: a hard conversation, a delegation call, a board update. We debrief what happened.' },
  { n: '04', t: 'Sustain', b: 'We build the habits and guardrails so the gains hold after we stop. You leave with a way of working, not a dependency on me.' },
];

const audience = [
  { t: 'New managers', b: 'First-time leads who were great ICs and now have to get work done through other people, without burning out or micromanaging.' },
  { t: 'Founders & operators', b: 'Running fast, carrying everything, making big calls with thin information. We build the judgment and calm to do it well.' },
  { t: 'Senior ICs stepping up', b: 'Staff engineers, principals, and leads moving into scope and influence beyond their own output, and the politics that comes with it.' },
];

const packages = [
  {
    k: '01', name: '1:1 coaching', cadence: 'Monthly', price: '€480', per: '/ month',
    body: 'Two 60-minute sessions a month, async support between them. The core engagement for steady, compounding change. Most clients stay 4 to 6 months.',
    points: ['2 sessions / month', 'Voice & message support', 'Shared notes and actions'],
    cta: 'Book an intro call', featured: true,
  },
  {
    k: '02', name: 'Focused intensive', cadence: '6 weeks', price: '€1,450', per: 'fixed',
    body: 'A short, sharp block for one real problem: a reorg, a promotion, a co-founder conflict, a make-or-break quarter. Weekly sessions, fast.',
    points: ['6 weekly sessions', 'A clear plan by week two', 'Direct, time-boxed scope'],
    cta: 'Discuss an intensive', featured: false,
  },
  {
    k: '03', name: 'Team workshops', cadence: 'On request', price: 'From €2,200', per: '/ day',
    body: 'Half- or full-day sessions for leadership teams: decision-making, feedback, running meetings that earn their hour. Built around your context.',
    points: ['On-site or online', 'Tailored to your team', 'Follow-up notes & actions'],
    cta: 'Ask about a workshop', featured: false,
  },
];
---
<Layout>
  <header class="nav">
    <a href="#top" class="brand">Mara Petrescu<span class="brand__dot"></span></a>
    <nav class="nav__links">{nav.map((i) => <a href={i.href}>{i.label}</a>)}</nav>
    <div class="nav__right">
      <button type="button" class="themer" data-themer aria-label="Toggle theme">
        <svg class="ic ic-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
        <svg class="ic ic-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <a href="#book" class="cta">Book an intro call</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__copy">
        <p class="eyebrow reveal">Leadership &amp; career coaching · online across Europe</p>
        <h1 class="hero__title reveal" style="--d:.06s">Better decisions, calmer teams, faster careers.</h1>
        <p class="hero__lede reveal" style="--d:.14s">
          I coach managers and founders through the parts of the job no one trained
          them for: the hard conversations, the calls made on thin information, the
          weeks that get away from them. We work on a few real things at a time, and
          we make them stick.
        </p>
        <div class="hero__cta reveal" style="--d:.2s">
          <a href="#book" class="cta cta--lg">Book an intro call</a>
          <a href="#method" class="textlink">See how I work →</a>
        </div>
        <div class="hero__cred reveal" style="--d:.28s">
          {cred.map((c) => (
            <div class="hero__cred-item">
              <span class="hero__cred-n">{c.n}</span>
              <span class="hero__cred-l">{c.l}</span>
            </div>
          ))}
        </div>
      </div>
      <figure class="hero__shot reveal" style="--d:.16s">
        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=1000&h=1250&fit=crop" alt="Mara Petrescu, leadership and career coach" loading="eager" />
        <figcaption class="hero__tag">Mara Petrescu · Coach since 2015</figcaption>
      </figure>
    </section>

    <!-- OVERSIZED OUTCOME STATS -->
    <section class="stats" id="outcomes">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--d:${i * 0.06}s`}>
          <span class="stat__n">{s.n}</span>
          <span class="stat__l">{s.l}</span>
        </div>
      ))}
    </section>

    <!-- METHOD -->
    <section class="section method" id="method">
      <div class="head">
        <span class="head__idx">How it works</span>
        <h2 class="h2">A clear method, not a vibe.</h2>
        <p class="head__sub">Four stages over a few months. Practical, structured, and built around what you actually do at work.</p>
      </div>
      <div class="method__grid">
        {method.map((m, i) => (
          <div class="mcol reveal" style={`--d:${i * 0.07}s`}>
            <span class="mcol__n">{m.n}</span>
            <div class="mcol__bar" aria-hidden="true"></div>
            <h3>{m.t}</h3>
            <p>{m.b}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- WHO I WORK WITH -->
    <section class="section who">
      <div class="head">
        <span class="head__idx">Who I work with</span>
        <h2 class="h2">People stepping into more responsibility.</h2>
      </div>
      <div class="who__grid">
        {audience.map((a, i) => (
          <article class="who__card reveal" style={`--d:${i * 0.07}s`}>
            <h3>{a.t}</h3>
            <p>{a.b}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- COACHING OPTIONS -->
    <section class="section coaching" id="coaching">
      <div class="head">
        <span class="head__idx">Coaching</span>
        <h2 class="h2">Ways to work together.</h2>
        <p class="head__sub">Every engagement starts with a free 30-minute intro call, so we both know it is a fit before any money changes hands.</p>
      </div>
      <div class="pkg__grid">
        {packages.map((p, i) => (
          <article class={`pkg reveal${p.featured ? ' pkg--featured' : ''}`} style={`--d:${i * 0.07}s`}>
            {p.featured && <span class="pkg__flag">Most chosen</span>}
            <div class="pkg__top">
              <span class="pkg__k">{p.k}</span>
              <span class="pkg__cadence">{p.cadence}</span>
            </div>
            <h3 class="pkg__name">{p.name}</h3>
            <div class="pkg__price">{p.price}<small>{p.per}</small></div>
            <p class="pkg__body">{p.body}</p>
            <ul class="pkg__points">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a href="#book" class={`pkg__cta${p.featured ? ' pkg__cta--solid' : ''}`}>{p.cta} →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section class="testi">
      <div class="testi__inner reveal">
        <p class="testi__mark" aria-hidden="true">“</p>
        <blockquote>
          I came in drowning in a team of fourteen I had no idea how to lead. In four
          months Mara helped me stop being the bottleneck, run a one-on-one that
          isn&apos;t a status update, and actually delegate. We shipped our biggest
          release with me out two days that week, and nothing fell over.
        </blockquote>
        <cite>
          <span class="testi__name">Ioana D.</span>
          <span class="testi__role">VP Engineering, fintech (Series B)</span>
        </cite>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band">
      <div class="cta-band__inner">
        <p class="eyebrow eyebrow--on">A free 30-minute call</p>
        <h2 class="cta-band__title">Let&apos;s see if I can help.</h2>
        <p class="cta-band__lede">No pitch, no obligation. We talk through what you&apos;re facing and I tell you honestly whether coaching is the right move, or what is.</p>
        <a href="#book" class="cta cta--lg cta--inv">Book an intro call ↓</a>
      </div>
    </section>

    <!-- BOOK (Cal.com) -->
    <section class="section book" id="book">
      <div class="head">
        <span class="head__idx">Book</span>
        <h2 class="h2">Grab a free intro call.</h2>
        <p class="head__sub">30 minutes, online, no charge. Pick a time and I&apos;ll send a calendar invite with a video link.</p>
      </div>
      <div class="bookwrap reveal">
        <div id="cal-inline" class="cal-inline"></div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot__top">
      <div class="foot__brand">
        <span class="foot__name">Mara Petrescu</span>
        <p class="foot__blurb">Leadership and career coaching for managers and founders. 1:1, intensives, and team workshops. Online across Europe.</p>
      </div>
      <div class="foot__cols">
        <div><h4>Work with me</h4><a href="#coaching">1:1 coaching</a><a href="#coaching">Focused intensive</a><a href="#coaching">Team workshops</a></div>
        <div><h4>About</h4><a href="#method">Method</a><a href="#outcomes">Outcomes</a><a href="#book">Book a call</a></div>
        <div><h4>Get in touch</h4><a href="mailto:hello@marapetrescu.com">hello@marapetrescu.com</a><a href="#">LinkedIn</a><a href="#book">Intro call</a></div>
      </div>
    </div>
    <div class="foot__base"><span>© 2026 Mara Petrescu</span><span>Online across Europe · based in Lisbon</span></div>
  </footer>

  <script is:inline>
    (function () { var b = document.querySelector('[data-themer]'); if (b) b.addEventListener('click', function () { var d = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', d); document.documentElement.classList.toggle('dark', d); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (_) {} }); })();
    (function () { var els = document.querySelectorAll('.reveal'); if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; } var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.1 }); els.forEach(function (e) { io.observe(e); }); })();
  </script>

  <!-- Cal.com inline booking. Swap calLink to the client's own Cal handle
       (e.g. "mara-petrescu/intro-call"); "rick" is Cal's public demo page so the
       template renders a real, working calendar out of the box. -->
  <script is:inline>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    (function () {
      try {
        var dark = document.documentElement.classList.contains('theme-dark');
        Cal("init", "intro", { origin: "https://cal.com" });
        Cal.ns.intro("inline", { elementOrSelector: "#cal-inline", config: { layout: "month_view" }, calLink: "rick" });
        Cal.ns.intro("ui", { theme: dark ? "dark" : "light", cssVarsPerTheme: { light: { "cal-brand": "#3b46d1" }, dark: { "cal-brand": "#6d8bff" } }, hideEventTypeDetails: true, layout: "month_view" });
      } catch (e) {}
    })();
  </script>

  <style is:global>
    /* DARK is default (:root). LIGHT overrides under html:not(.theme-dark):not(.dark). */
    :root {
      --bg: #0c0e14; --raise: #141823; --ink: #eef1f7; --dim: #9aa3b8;
      --accent: #6d8bff; --accent-2: #8aa0ff; --on-accent: #0c0e14;
      --line: rgba(238,241,247,.12); --line-2: rgba(238,241,247,.07);
      --disp: 'Sora', -apple-system, system-ui, sans-serif;
      --body: 'Plus Jakarta Sans', -apple-system, system-ui, sans-serif;
    }
    html:not(.theme-dark):not(.dark) {
      --bg: #f5f6f8; --raise: #ffffff; --ink: #14161c; --dim: #5b6276;
      --accent: #3b46d1; --accent-2: #2c36b8; --on-accent: #ffffff;
      --line: rgba(20,22,28,.12); --line-2: rgba(20,22,28,.06);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 17px; line-height: 1.62; -webkit-font-smoothing: antialiased; overflow-x: hidden; transition: background .4s, color .4s; }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    ::selection { background: var(--accent); color: var(--on-accent); }
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.8,.2,1) var(--d,0s), transform .7s cubic-bezier(.2,.8,.2,1) var(--d,0s); }
    .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce){ .reveal{opacity:1;transform:none;transition:none} }

    .eyebrow { font-family: var(--disp); text-transform: uppercase; letter-spacing: .16em; font-size: .72rem; font-weight: 600; color: var(--accent); margin: 0 0 1.4rem; }
    .eyebrow--on { color: var(--accent); }
    .h2 { font-family: var(--disp); font-weight: 700; font-size: clamp(1.9rem,3.6vw,3.05rem); line-height: 1.05; letter-spacing: -.02em; margin: 0; max-width: 18ch; }
    .accent { color: var(--accent); }

    .cta { display: inline-flex; align-items: center; font-family: var(--disp); letter-spacing: .005em; font-weight: 600; font-size: .9rem; background: var(--accent); color: var(--on-accent); padding: .72rem 1.25rem; border: 0; border-radius: 9px; cursor: pointer; transition: transform .2s, background .2s, box-shadow .2s; box-shadow: 0 1px 0 rgba(0,0,0,.04); }
    .cta:hover { transform: translateY(-2px); background: var(--accent-2); }
    .cta--lg { padding: .95rem 1.7rem; font-size: .98rem; border-radius: 11px; }
    .cta--inv { background: var(--ink); color: var(--bg); }
    .cta--inv:hover { background: var(--accent); color: var(--on-accent); }
    .textlink { font-family: var(--disp); font-weight: 600; font-size: .92rem; color: var(--ink); border-bottom: 2px solid var(--accent); padding-bottom: 2px; transition: color .2s; }
    .textlink:hover { color: var(--accent); }

    /* NAV */
    .nav { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1rem clamp(1.2rem,5vw,4rem); background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
    .brand { font-family: var(--disp); font-weight: 700; font-size: 1.18rem; letter-spacing: -.02em; display: inline-flex; align-items: center; gap: .45rem; }
    .brand__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); display: inline-block; }
    .nav__links { display: flex; gap: 1.9rem; }
    .nav__links a { font-family: var(--disp); font-size: .88rem; font-weight: 500; color: var(--dim); transition: color .2s; }
    .nav__links a:hover { color: var(--ink); }
    .nav__right { display: flex; align-items: center; gap: 1rem; }
    .themer { width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 9px; background: transparent; color: var(--ink); cursor: pointer; display: grid; place-items: center; transition: border-color .2s, color .2s; }
    .themer:hover { border-color: var(--accent); color: var(--accent); }
    .themer .ic { grid-area: 1 / 1; }
    .themer .ic-moon { display: none; }
    html.theme-dark .themer .ic-sun, html.dark .themer .ic-sun { display: none; }
    html.theme-dark .themer .ic-moon, html.dark .themer .ic-moon { display: block; }

    /* HERO */
    .hero { display: grid; grid-template-columns: 1.12fr .88fr; gap: clamp(2.5rem,5vw,5rem); align-items: center; padding: clamp(3rem,6vw,6rem) clamp(1.2rem,5vw,4rem) clamp(2.5rem,5vw,4.5rem); max-width: 1320px; margin: 0 auto; }
    .hero__title { font-family: var(--disp); font-weight: 700; font-size: clamp(2.5rem,5.4vw,4.4rem); line-height: 1.02; letter-spacing: -.03em; margin: 0 0 1.5rem; }
    .hero__lede { font-size: 1.12rem; color: var(--dim); max-width: 50ch; margin: 0 0 2rem; }
    .hero__cta { display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap; }
    .hero__cred { display: flex; gap: clamp(1.6rem,3vw,2.8rem); margin-top: 2.6rem; padding-top: 1.8rem; border-top: 1px solid var(--line); }
    .hero__cred-item { display: flex; flex-direction: column; }
    .hero__cred-n { font-family: var(--disp); font-weight: 700; font-size: 1.35rem; letter-spacing: -.02em; }
    .hero__cred-l { font-size: .82rem; color: var(--dim); margin-top: .2rem; }
    .hero__shot { position: relative; margin: 0; }
    .hero__shot img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 16px; border: 1px solid var(--line); }
    .hero__shot::before { content: ''; position: absolute; inset: -10px -10px auto auto; width: 62%; height: 62%; border-radius: 18px; background: var(--accent); opacity: .14; z-index: -1; }
    .hero__tag { position: absolute; left: 14px; bottom: 14px; background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(8px); border: 1px solid var(--line); color: var(--ink); font-family: var(--disp); font-weight: 600; font-size: .76rem; padding: .45rem .8rem; border-radius: 8px; }

    /* STATS */
    .stats { display: grid; grid-template-columns: repeat(4,1fr); max-width: 1320px; margin: 0 auto; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .stat { padding: clamp(2rem,4vw,3.4rem) clamp(1.2rem,2.5vw,2rem); border-right: 1px solid var(--line-2); }
    .stat:last-child { border-right: 0; }
    .stat__n { display: block; font-family: var(--disp); font-weight: 700; font-size: clamp(3rem,6.2vw,5.2rem); line-height: .96; letter-spacing: -.04em; color: var(--accent); }
    .stat__l { font-size: .9rem; color: var(--dim); margin-top: .8rem; display: block; max-width: 22ch; }

    /* SECTIONS */
    .section { max-width: 1320px; margin: 0 auto; padding: clamp(4rem,7vw,7rem) clamp(1.2rem,5vw,4rem); }
    .head { margin-bottom: clamp(2.5rem,4vw,3.5rem); max-width: 70ch; }
    .head__idx { font-family: var(--disp); color: var(--accent); letter-spacing: .14em; text-transform: uppercase; font-size: .74rem; font-weight: 600; display: block; margin-bottom: 1rem; }
    .head__sub { color: var(--dim); font-size: 1.05rem; margin: 1.1rem 0 0; max-width: 56ch; }

    /* METHOD */
    .method__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: clamp(1.5rem,2.5vw,2.4rem); }
    .mcol { background: var(--raise); border: 1px solid var(--line); border-radius: 14px; padding: 1.8rem 1.6rem 2rem; transition: transform .25s, border-color .25s; }
    .mcol:hover { transform: translateY(-4px); border-color: var(--accent); }
    .mcol__n { font-family: var(--disp); font-weight: 700; font-size: 1.05rem; color: var(--accent); letter-spacing: .04em; }
    .mcol__bar { width: 36px; height: 3px; border-radius: 3px; background: var(--accent); margin: .9rem 0 1.1rem; }
    .mcol h3 { font-family: var(--disp); font-size: 1.3rem; font-weight: 700; letter-spacing: -.01em; margin: 0 0 .7rem; }
    .mcol p { color: var(--dim); margin: 0; font-size: .96rem; }
    @media (max-width:980px){ .method__grid{grid-template-columns:repeat(2,1fr)} }

    /* WHO */
    .who__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(1.2rem,2.5vw,2rem); }
    .who__card { border-top: 3px solid var(--accent); padding: 1.5rem 0 0; }
    .who__card h3 { font-family: var(--disp); font-size: 1.4rem; font-weight: 700; letter-spacing: -.01em; margin: 0 0 .7rem; }
    .who__card p { color: var(--dim); margin: 0; font-size: .98rem; }
    @media (max-width:860px){ .who__grid{grid-template-columns:1fr; gap:1.8rem} }

    /* COACHING / PACKAGES */
    .pkg__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(1.2rem,2vw,1.6rem); align-items: stretch; }
    .pkg { display: flex; flex-direction: column; background: var(--raise); border: 1px solid var(--line); border-radius: 16px; padding: 1.9rem 1.7rem 1.9rem; position: relative; transition: transform .25s, border-color .25s, box-shadow .25s; }
    .pkg:hover { transform: translateY(-4px); }
    .pkg--featured { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 22px 50px -28px color-mix(in srgb, var(--accent) 70%, transparent); }
    .pkg__flag { position: absolute; top: -12px; left: 1.7rem; background: var(--accent); color: var(--on-accent); font-family: var(--disp); font-weight: 600; font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; padding: .3rem .7rem; border-radius: 7px; }
    .pkg__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
    .pkg__k { font-family: var(--disp); font-weight: 700; font-size: 1rem; color: var(--accent); }
