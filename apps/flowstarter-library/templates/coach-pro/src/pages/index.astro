---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import ServiceCard from '../../../shared/dorin-ds/components/ServiceCard.astro';
import StatsRow from '../../../shared/dorin-ds/components/StatsRow.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import TestimonialBlock from '../../../shared/dorin-ds/components/TestimonialBlock.astro';
import FaqAccordionItem from '../../../shared/dorin-ds/components/FaqAccordionItem.astro';
import TagPill from '../../../shared/dorin-ds/components/TagPill.astro';
import HeroIntro from '../../../shared/dorin-ds/components/HeroIntro.astro';
import VideoBlock from '../../../shared/dorin-ds/components/VideoBlock.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';
import { frontmatter as heroData } from '../../content/hero.md';
import { frontmatter as servicesData } from '../../content/services.md';
import { frontmatter as testimonialsData } from '../../content/testimonials.md';
import { frontmatter as videoData } from '../../content/video.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface HeroStat { value: string; label: string }
interface HeroContent { stats?: HeroStat[] }
interface ServiceItem { icon: string; title: string; description: string; price: string }
interface ServicesContent { services?: ServiceItem[] }
interface TestimonialItem { quote: string; author: string; role: string; result: string }
interface TestimonialsContent { testimonials?: TestimonialItem[] }
interface VideoContent {
  eyebrow?: string;
  title: string;
  duration?: string;
  caption?: string;
  poster?: string;
  src: string;
  aspect?: '21/9' | '16/9' | '4/3' | '1/1';
}
interface BookingContent {
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

const hero = heroData as HeroContent;
const servicesContent = servicesData as ServicesContent;
const testimonialsContent = testimonialsData as TestimonialsContent;
const video = videoData as VideoContent;
const booking = bookingData as BookingContent;

// Map .md hero stats (value/label) to StatsRow's expected (number/label) shape.
const heroStats = (hero.stats ?? []).map((s) => ({
  number: s.value,
  label: s.label,
}));

// Inline SVG strings for each `lucide:*` icon name referenced in services.md.
// Kept here (not in the .md) so authors can edit copy without touching markup.
const lucideIcons: Record<string, string> = {
  'lucide:crown':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294zM5 21h14"/></svg>',
  'lucide:briefcase':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>',
  'lucide:heart':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676a.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>',
  'lucide:graduation-cap':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0zM22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>',
  'lucide:users':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3.128a4 4 0 0 1 0 7.744M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>',
  'lucide:sparkles':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594zM20 2v4m2-2h-4"/><circle cx="4" cy="20" r="2"/></svg>',
};

const services = (servicesContent.services ?? []).map((s) => ({
  icon: lucideIcons[s.icon] ?? '',
  title: s.title,
  description: s.description,
  meta: s.price,
}));

const testimonials = testimonialsContent.testimonials ?? [];

const approach = [
  {
    number: '01',
    title: 'Goal clarity',
    description:
      'We start by getting crystal clear on what you truly want. Through deep inquiry and assessment, we define your vision, identify obstacles, and create a compelling roadmap for your transformation.',
  },
  {
    number: '02',
    title: 'Accountability framework',
    description:
      'Structured accountability that keeps you on track. Weekly check-ins, progress tracking, and honest feedback ensure you follow through on your commitments and stay aligned with your goals.',
  },
  {
    number: '03',
    title: 'Mindset mastery',
    description:
      'We identify and rewire the limiting beliefs, patterns, and stories that hold you back. Through proven cognitive techniques, you develop an empowered mindset that supports lasting change.',
  },
  {
    number: '04',
    title: 'Action planning',
    description:
      'Every session ends with clear, actionable next steps. We break big goals into manageable milestones, so you always know exactly what to do next to move forward with confidence.',
  },
];

const faqs = [
  {
    question: 'What happens in a typical coaching session?',
    answer:
      'Each session begins with a check-in on your progress since our last meeting. We dive into the key challenges or opportunities you are facing, using targeted questions and exercises to create breakthroughs. Every session ends with clear action items and accountability commitments. Sessions are 60 minutes, video or in-person.',
  },
  {
    question: 'How often should I have coaching sessions?',
    answer:
      'Most clients see the best results with weekly or bi-weekly sessions. Weekly sessions create stronger momentum and faster results, while bi-weekly works well for maintenance and ongoing development. We will determine the right cadence during your discovery call.',
  },
  {
    question: 'What is the ROI of coaching?',
    answer:
      'The International Coaching Federation reports that 86% of companies that invested in coaching saw a positive ROI. My clients typically report salary increases of 20–50%, revenue growth, improved leadership effectiveness, better work-life balance, and greater clarity in decision-making.',
  },
  {
    question: 'Do you offer virtual coaching sessions?',
    answer:
      'Yes. The majority of my clients work with me virtually via secure video calls. Virtual coaching is just as effective as in-person and offers the flexibility to work together regardless of location. I also offer in-person sessions in Austin, TX for local clients.',
  },
  {
    question: 'How is coaching different from therapy?',
    answer:
      'Therapy typically focuses on healing past wounds and addressing mental health concerns. Coaching is future-focused and action-oriented — it assumes you are resourceful and capable, and helps you bridge the gap between where you are and where you want to be.',
  },
];

const credentials = [
  'ICF Professional Certified Coach (PCC)',
  'Certified Executive Coach — Columbia University',
  'MBA, Harvard Business School',
  '12+ years coaching experience',
];
---

<Layout
  title="James Parker — Executive & Life Coach"
  description="Executive, business, and life coaching for ambitious professionals ready to break through limitations and achieve extraordinary results."
  activeIndex={-1}
>
  <HeroIntro text="James Parker" />

  <!-- ─── Hero ──────────────────────────────────────────────── -->
  <SectionBlock id="home" tone="light" padding="hero" className="cp-hero">
    <Container className="cp-hero__inner">
      <div class="cp-hero__copy">
        <OverlineText text="ICF Certified · Austin, TX" tone="accent" />
        <h1 class="cp-hero__title">
          Unlock your true<br />
          <span class="cp-hero__title-accent">potential.</span>
        </h1>
        <p class="cp-hero__lede">
          I'm <strong>James Parker</strong> — I help ambitious professionals
          and entrepreneurs break through limitations, gain clarity, and
          achieve extraordinary results in life, career, and business.
        </p>
        <div class="cp-hero__actions">
          <ActionButton
            href="/contact"
            label="Book discovery call"
            variant="primary"
            size="large"
          />
          <ActionButton
            href="/services"
            label="Explore programs"
            variant="outline-dark"
            size="large"
          />
        </div>
        <div class="cp-hero__pills">
          <TagPill label="Virtual sessions worldwide" />
          <TagPill label="500+ clients coached" />
          <TagPill label="ICF accredited" />
        </div>
      </div>

      <div class="cp-hero__plate" aria-hidden="true">
        <div class="cp-hero__plate-image"></div>
        <span class="cp-hero__index">№ 01 — 2026</span>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Stats ────────────────────────────────────────────── -->
  <SectionBlock tone="accent-light" padding="compact" topBorder>
    <Container>
      <StatsRow items={heroStats} />
    </Container>
  </SectionBlock>

  <!-- ─── About ────────────────────────────────────────────── -->
  <SectionBlock id="about" tone="light" padding="default">
    <Container className="cp-about">
      <div class="cp-about__heading">
        <OverlineText text="About" />
        <h2 class="section-title cp-about__title">
          Your partner in<br />
          <em>transformation</em>.
        </h2>
      </div>
      <div class="cp-about__body">
        <p class="cp-about__intro">
          For over twelve years, I've coached leaders, entrepreneurs, and
          professionals through pivotal moments in their careers and lives.
          My approach blends strategic thinking with deep personal insight —
          rigorous, practical, and unsentimental.
        </p>
        <p class="cp-about__copy">
          I specialize in life transitions, leadership development, business
          growth, and career acceleration. Whether you're scaling a company,
          navigating a pivot, or seeking greater fulfillment, I'm here to help
          you achieve breakthrough results.
        </p>
        <ul class="cp-about__credentials" id="credentials">
          {
            credentials.map((c) => (
              <li class="cp-about__credential">
                <span class="cp-about__credential-mark" aria-hidden="true">
                  ◆
                </span>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Services ─────────────────────────────────────────── -->
  <SectionBlock id="services" tone="subtle" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="Programs"
        title="Coaching, designed for results."
        maxWidth="20ch"
      />
      <div class="cp-services-grid">
        {
          services.map((s) => (
            <ServiceCard
              icon={s.icon}
              title={s.title}
              description={s.description}
              meta={s.meta}
            />
          ))
        }
      </div>
      <div class="cp-services-cta">
        <ActionButton
          href="/services"
          label="See all coaching programs"
          variant="outline-dark"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Approach ─────────────────────────────────────────── -->
  <SectionBlock id="approach" tone="dark" padding="default">
    <Container className="cp-approach">
      <div class="cp-approach__heading">
        <OverlineText text="The framework" tone="accent" />
        <h2 class="section-title cp-approach__title">
          A proven four-pillar approach to lasting change.
        </h2>
      </div>
      <div class="cp-approach__list">
        {
          approach.map((a) => (
            <NumberedFeatureItem
              number={a.number}
              title={a.title}
              description={a.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Video ────────────────────────────────────────────── -->
  <SectionBlock id="video" tone="light" padding="default" topBorder>
    <Container className="cp-video">
      <VideoBlock
        src={video.src}
        poster={video.poster}
        title={video.title}
        caption={video.caption}
        eyebrow={video.eyebrow}
        duration={video.duration}
        aspect={video.aspect}
      />
    </Container>
  </SectionBlock>

  <!-- ─── Testimonials ─────────────────────────────────────── -->
  <SectionBlock id="testimonials" tone="light" padding="default">
    <Container>
      <SectionHeading label="Success stories" title="Client transformations." />
      <div class="cp-testimonials">
        {
          testimonials.map((t) => (
            <TestimonialBlock
              quote={t.quote}
              author={t.author}
              role={t.role}
              result={t.result}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── FAQ ──────────────────────────────────────────────── -->
  <SectionBlock id="faq" tone="light" padding="default" topBorder>
    <Container className="cp-faq">
      <SectionHeading label="FAQ" title="Common questions." />
      <div class="cp-faq__list">
        {faqs.map((f) => <FaqAccordionItem question={f.question} answer={f.answer} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA ──────────────────────────────────────────────── -->
  <SectionBlock id="contact" tone="dark" padding="default">
    <Container className="cp-cta">
      <h2 class="cp-cta__title">
        Ready to transform<br />your life and work?
      </h2>
      <p class="cp-cta__lede">
        The first step is a complimentary 30-minute discovery call. We'll
        discuss your goals, explore how coaching can help, and determine if
        we're the right fit to work together.
      </p>
      <div class="cp-cta__actions">
        <ActionButton
          href="/contact"
          label="Book discovery call"
          variant="primary-light"
          size="large"
          className="fs-book-btn"
        />
        <ActionButton
          href="mailto:coach@jamesparker.com"
          label="Send an email instead"
          variant="outline-light"
          size="large"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Cal.com booking CTA ──────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default" topBorder>
    <Container className="cp-cal-cta">
      <CalBookingBlock
        variant="cta"
        calLink={booking.cal_link}
        eventLabel={booking.cal_event_label}
        title={booking.title}
        subtitle={booking.description}
        durationLabel={booking.cal_duration_label}
        layout={booking.cal_layout}
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .cp-hero {
    position: relative;
    overflow: clip;
  }

  .cp-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 44%);
    gap: 64px;
    align-items: center;
    min-height: 76vh;
  }

  .cp-hero__copy {
    max-width: 620px;
  }

  .cp-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.8rem, 6.5vw, 5.4rem);
    font-weight: var(--fw-headline);
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .cp-hero__title-accent {
    color: var(--brand-primary);
    font-style: normal;
  }

  .cp-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-primary);
    max-width: 520px;
    margin-bottom: 36px;
  }

  .cp-hero__lede strong {
    font-weight: var(--fw-semibold);
  }

  .cp-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .cp-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Plate */
  .cp-hero__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .cp-hero__plate-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1560250097-0b93528c311a?w=900&h=1100&fit=crop&crop=faces');
    background-size: cover;
    background-position: center 30%;
    filter: contrast(1.04) saturate(0.92);
    transition: transform 1.2s var(--ease-emphasized);
  }

  .cp-hero:hover .cp-hero__plate-image {
    transform: scale(1.02);
  }

  .cp-hero__index {
    position: absolute;
    top: 18px;
    left: 18px;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-on-dark);
    background: var(--bg-dark);
    padding: 6px 10px;
    z-index: 1;
  }

  /* About */
  .cp-about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 80px;
    align-items: start;
  }

  .cp-about__heading {
    position: sticky;
    top: 100px;
  }

  .cp-about__title {
    margin-top: 16px;
  }

  .cp-about__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .cp-about__intro {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--bg-dark);
    margin-bottom: 24px;
    max-width: 56ch;
  }

  .cp-about__copy {
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--text-primary);
    max-width: 60ch;
    margin-bottom: 36px;
  }

  .cp-about__credentials {
    display: grid;
    gap: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--surface-subtle-border);
  }

  .cp-about__credential {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
  }

  .cp-about__credential-mark {
    color: var(--brand-primary);
    font-size: 0.8em;
    line-height: 1.5;
  }

  /* Services grid */
  .cp-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cp-services-cta {
    margin-top: 56px;
    text-align: center;
  }

  /* Approach (dark) */
  .cp-approach {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 80px;
  }

  .cp-approach__heading {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .cp-approach__title {
    color: var(--text-on-dark);
    margin-top: 16px;
    max-width: 18ch;
  }

  /* Testimonials */
  .cp-testimonials {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* FAQ */
  .cp-faq {
    max-width: 920px;
  }

  .cp-faq__list {
    display: grid;
    gap: 12px;
  }

  /* CTA */
  .cp-cta {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .cp-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: var(--fw-headline);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    margin-bottom: 28px;
  }

  .cp-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-nav);
    margin-bottom: 40px;
    max-width: 56ch;
    margin-left: auto;
    margin-right: auto;
  }

  .cp-cta__actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .cp-hero__inner {
      grid-template-columns: 1fr;
      gap: 48px;
      min-height: auto;
    }

    .cp-hero__plate {
      aspect-ratio: 16 / 11;
      max-width: 720px;
    }

    .cp-about,
    .cp-approach {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .cp-about__heading,
    .cp-approach__heading {
      position: static;
    }

    .cp-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cp-testimonials {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .cp-services-grid {
      grid-template-columns: 1fr;
    }

    .cp-hero__title {
      font-size: 2.6rem;
    }
  }
</style>
