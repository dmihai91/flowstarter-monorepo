---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import PricingCard from '../../../shared/dorin-ds/components/PricingCard.astro';
import FaqAccordionItem from '../../../shared/dorin-ds/components/FaqAccordionItem.astro';
import ProcessStep from '../../../shared/dorin-ds/components/ProcessStep.astro';
import { frontmatter as servicesData } from '../../content/services.md';
import { frontmatter as pricingData } from '../../content/pricing.md';

interface ServiceItem { icon: string; title: string; description: string; price: string }
interface ServicesContent { services?: ServiceItem[] }
interface PricingPlan {
  name: string;
  price: number | string;
  period: string;
  description: string;
  features: string[];
  cta: string;
  popular?: boolean;
}
interface PricingContent { plans?: PricingPlan[] }

const servicesContent = servicesData as ServicesContent;
const pricingContent = pricingData as PricingContent;

// Programs list pulls title + description from services.md, but the numbering
// is purely a visual scaffold owned by this page so it stays hardcoded.
const programs = (servicesContent.services ?? []).map((s, i) => ({
  number: String(i + 1).padStart(2, '0'),
  title: s.title,
  description: s.description,
}));

const pricing = (pricingContent.plans ?? []).map((p) => ({
  name: p.name,
  price: `$${p.price}`,
  cadence: p.period,
  description: p.description,
  features: p.features,
  ctaLabel: p.cta,
  ctaHref: '/contact',
  featured: !!p.popular,
}));

const process = [
  {
    step: 'Step 1',
    title: 'Discovery call',
    description:
      "30 minutes, free, no commitment. We'll discuss your goals, your blockers, and whether coaching is the right fit. If it's not, I'll point you to someone better.",
  },
  {
    step: 'Step 2',
    title: 'Onboarding',
    description:
      'A short intake form clarifies your starting point: where you are, where you want to go, and what you have already tried. We use this to design our first session.',
  },
  {
    step: 'Step 3',
    title: 'Coaching engagement',
    description:
      'Weekly 60-minute sessions, async support between, monthly milestone reviews. We adapt cadence and focus as your situation evolves.',
  },
  {
    step: 'Step 4',
    title: 'Continuation',
    description:
      'After your initial engagement, most clients move to a lighter check-in cadence (monthly or quarterly) to maintain momentum and accountability.',
  },
];

const faqs = [
  {
    question: 'How quickly will I see results?',
    answer:
      'Most clients report meaningful shifts within the first 4–6 weeks — typically clarity on what they actually want, identification of blocking patterns, and a structured plan. Substantial outcomes (career moves, revenue growth, leadership shifts) usually emerge in months 3–6.',
  },
  {
    question: 'Do you offer payment plans?',
    answer:
      'Yes. Three- and six-month engagements can be split into monthly installments at no extra cost. For longer engagements, we can structure quarterly payments. Talk to me on the discovery call.',
  },
  {
    question: 'What if I need to pause or stop early?',
    answer:
      'You can pause an engagement for up to 60 days for any reason. If you need to stop entirely, refunds are pro-rated for unused sessions. No questions asked, no hard feelings.',
  },
  {
    question: 'Do you work with teams or just individuals?',
    answer:
      "Both. Individual executive coaching is my main offering, but I also run leadership team workshops and 1:1 coaching for entire executive teams. Reach out to discuss team engagements.",
  },
  {
    question: 'How is this different from therapy?',
    answer:
      'Therapy heals; coaching builds. I assume you are mentally healthy and resourceful, and help you bridge the gap between where you are and where you want to be. If we discover therapy is what you need, I will refer you to a vetted therapist.',
  },
];
---

<Layout
  title="Coaching Programs — Mara Petrescu"
  description="Executive, business, career, and life coaching programs. Choose the cadence and depth that fits your goals."
  activeIndex={0}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="cp-services-hero">
      <OverlineText text="Coaching" tone="accent" />
      <h1 class="cp-services-hero__title">
        Programs designed for<br />
        <em>real, measurable</em> results.
      </h1>
      <p class="cp-services-hero__lede">
        Six core engagements, tuned for leaders, founders, and professionals
        at inflection points. Each one is rigorous, structured, and adapted
        to where you are right now.
      </p>
      <div class="cp-services-hero__actions">
        <ActionButton
          href="/contact"
          label="Book discovery call"
          variant="primary"
          size="large"
        />
        <ActionButton
          href="#pricing"
          label="See pricing"
          variant="outline-dark"
          size="large"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Programs list ────────────────────────────────────── -->
  <SectionBlock id="programs" tone="light" padding="default" topBorder>
    <Container className="cp-services-list">
      <div class="cp-services-list__heading">
        <OverlineText text="Programs" />
        <h2 class="section-title">Six ways to work together.</h2>
      </div>
      <div class="cp-services-list__items">
        {
          programs.map((p) => (
            <NumberedFeatureItem
              number={p.number}
              title={p.title}
              description={p.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Process ─────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default">
    <Container>
      <SectionHeading
        label="The process"
        title="Four steps from first call to outcomes."
        maxWidth="22ch"
      />
      <div class="cp-services-process">
        {
          process.map((s) => (
            <ProcessStep
              step={s.step}
              title={s.title}
              description={s.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Pricing ─────────────────────────────────────────── -->
  <SectionBlock id="pricing" tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="Pricing"
        title="Simple, transparent engagements."
        align="center"
        maxWidth="22ch"
      />
      <div class="cp-services-pricing">
        {pricing.map((p) => <PricingCard {...p} />)}
      </div>
      <p class="cp-services-pricing-note">
        Custom enterprise packages, team coaching, and intensive workshops
        available on request.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── FAQ ─────────────────────────────────────────────── -->
  <SectionBlock id="faq" tone="subtle" padding="default">
    <Container className="cp-services-faq">
      <SectionHeading label="FAQ" title="Practical questions, answered." />
      <div class="cp-services-faq__list">
        {faqs.map((f) => <FaqAccordionItem question={f.question} answer={f.answer} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="cp-services-cta">
      <h2 class="cp-services-cta__title">Not sure which is right for you?</h2>
      <p class="cp-services-cta__lede">
        Book a 30-minute discovery call. We'll figure it out together — and
        if I'm not the right coach for you, I'll point you to someone who is.
      </p>
      <ActionButton
        href="/contact"
        label="Book discovery call"
        variant="primary-light"
        size="large"
        className="fs-book-btn"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  .cp-services-hero {
    max-width: 880px;
  }

  .cp-services-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .cp-services-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .cp-services-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 60ch;
    margin-bottom: 36px;
  }

  .cp-services-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Programs list */
  .cp-services-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 80px;
    align-items: start;
  }

  .cp-services-list__heading {
    position: sticky;
    top: 100px;
  }

  .cp-services-list__heading .section-title {
    margin-top: 16px;
    max-width: 14ch;
  }

  .cp-services-list__items {
    border-top: 1px solid var(--surface-subtle-border);
  }

  /* Process */
  .cp-services-process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  /* Pricing */
  .cp-services-pricing {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .cp-services-pricing-note {
    margin-top: 40px;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* FAQ */
  .cp-services-faq {
    max-width: 920px;
  }

  .cp-services-faq__list {
    display: grid;
    gap: 12px;
  }

  /* CTA */
  .cp-services-cta {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cp-services-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .cp-services-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-nav);
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .cp-services-list {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .cp-services-list__heading {
      position: static;
    }

    .cp-services-process {
      grid-template-columns: repeat(2, 1fr);
    }

    .cp-services-pricing {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .cp-services-process {
      grid-template-columns: 1fr;
    }
  }
</style>
