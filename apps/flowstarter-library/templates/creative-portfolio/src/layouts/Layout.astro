---
import '../../../shared/dorin-ds/tokens.css';
import '../../../shared/dorin-ds/reset.css';
import DSHead from '../../../shared/dorin-ds/components/DSHead.astro';
import Header from '../../../shared/dorin-ds/components/Header.astro';
import Footer from '../../../shared/dorin-ds/components/Footer.astro';
import ContactScript from '../../../shared/ContactScript.astro';
import { frontmatter as contactFormData } from '../../content/integrations/contact-form.md';

interface Props {
  title?: string;
  description?: string;
  activeIndex?: number;
}

interface ContactFormContent {
  action_url?: string | null;
  success_message?: string | null;
}

const {
  title = 'Marcus Rivera — Visual Designer & Photographer',
  description = 'Visual design and photography for hospitality, fashion, and gallery clients. Studio in Mexico City and New York.',
  activeIndex = -1,
} = Astro.props;

const contactForm = contactFormData as ContactFormContent;
const contactFormActionUrl =
  typeof contactForm.action_url === 'string' ? contactForm.action_url : '';
const contactFormSuccessMessage =
  typeof contactForm.success_message === 'string' &&
  contactForm.success_message.length > 0
    ? contactForm.success_message
    : 'Thank you. The studio will be in touch within four business days.';

const navLinks = [
  { label: 'Work', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Contact', href: '/contact' },
];

const footerColumns = [
  {
    heading: 'Studio',
    links: [
      { label: 'Services', href: '/services' },
      { label: 'About', href: '/about' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    heading: 'Recognition',
    links: [
      { label: 'Forbes 30 under 30', href: '#' },
      { label: 'Wallpaper* contributor', href: '#' },
      { label: 'AIGA Eye on Design', href: '#' },
    ],
  },
  {
    heading: 'Press & social',
    links: [
      { label: 'Press kit', href: '#' },
      { label: 'Instagram', href: '#' },
      { label: 'LinkedIn', href: '#' },
      { label: 'studio@marcusrivera.com', href: 'mailto:studio@marcusrivera.com' },
    ],
  },
];

const socials = [
  {
    href: '#',
    ariaLabel: 'Instagram',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8A4 4 0 0 1 16 11.37m1.5-4.87h.01"/></g></svg>',
  },
  {
    href: '#',
    ariaLabel: 'Behance',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7V5h7v2zM10.5 8.5c1.93 0 3.5 1.57 3.5 3.5s-1.57 3.5-3.5 3.5H6V8.5h4.5zm-2 5h2c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5h-2v3zm10.5-1c1.66 0 3 1.34 3 3v.5h-5.91c.06.95.85 1.69 1.91 1.69.71 0 1.34-.36 1.71-.92h2.06c-.45 1.55-1.85 2.73-3.77 2.73-2.21 0-4-1.79-4-4s1.79-4 4-4zm0 2c-.83 0-1.55.5-1.84 1.21h3.69c-.3-.71-1.02-1.21-1.85-1.21z"/></svg>',
  },
  {
    href: '#',
    ariaLabel: 'LinkedIn',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  },
];
---

<!doctype html>
<html lang="en" data-template="creative-portfolio">
  <head>
    <DSHead title={title} description={description} fontPair="playfair-manrope" />
    <script is:inline>
      // Flowstarter preview iframe bridge
      (function () {
        if (window.self === window.top) return;
        document.documentElement.classList.add('fs-preview');
        window.parent.postMessage(
          { source: 'fs-template', type: 'ready' },
          '*',
        );
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.source !== 'fs-preview') return;
          var d = e.data;
          var root = document.documentElement;
          if (d.type === 'setTheme') {
            root.classList.toggle('theme-dark', d.value === 'dark');
            try {
              localStorage.setItem('theme', d.value);
            } catch (_) {}
          } else if (d.type === 'setPalette') {
            if (d.dark !== undefined) {
              root.classList.toggle('theme-dark', !!d.dark);
            }
            if (d.vars) {
              Object.keys(d.vars).forEach(function (k) {
                root.style.setProperty(k, d.vars[k]);
              });
            }
          } else if (d.type === 'setFont') {
            var existing = document.getElementById('fs-font-override');
            if (existing) existing.remove();
            if (d.url) {
              var link = document.createElement('link');
              link.id = 'fs-font-override';
              link.rel = 'stylesheet';
              link.href = d.url;
              document.head.appendChild(link);
            }
            if (d.heading)
              root.style.setProperty('--font-title', d.heading);
            if (d.body) root.style.setProperty('--font-body', d.body);
          }
        });
      })();
    </script>
  </head>
  <body>
    <Header
      brandLabel="Marcus Rivera"
      links={navLinks}
      ctaLabel="Commission a project"
      ctaHref="/contact"
      activeIndex={activeIndex}
    />
    <main class="ds-main">
      <slot />
    </main>
    <Footer
      brandLabel="Marcus Rivera"
      tagline="Visual design and photography for hospitality, fashion, and gallery clients. Studios in Mexico City and New York."
      columns={footerColumns}
      socials={socials}
      copyrightSuffix="Estudio Rivera. All rights reserved."
    />
    <ContactScript
      actionUrl={contactFormActionUrl}
      successMessage={contactFormSuccessMessage}
      templateName="creative-portfolio"
    />

    <style is:global>
      .ds-main {
        padding-top: 72px;
      }
    </style>
  </body>
</html>
