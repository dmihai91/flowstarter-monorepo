---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ContactCard from '../../../shared/dorin-ds/components/ContactCard.astro';
import FormField from '../../../shared/dorin-ds/components/FormField.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';

import { frontmatter as siteData } from '../../content/site.md';
import { frontmatter as contactData } from '../../content/contact.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface SiteContent {
  name?: string;
  description?: string;
}
interface ContactContent {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}
interface BookingContent {
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
  cta?: string;
}

const site = siteData as SiteContent;
const contact = contactData as ContactContent;
const booking = bookingData as BookingContent;

const heroEyebrow = contact.eyebrow ?? 'Get in touch';
const heroLede =
  contact.subtitle ??
  'New commissions begin with a 45-minute call. Tell us what you are making, where it lives, and the picture you have in mind. The studio replies within three business days.';

const pageTitle = `Contact — ${site.name ?? 'Studio Rivera'}`;
const pageDescription =
  site.description ??
  'Commission a project, request a press kit, or write directly. Studio Rivera is open by appointment.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  activeIndex={3}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="cv-contact-hero">
      <OverlineText text={heroEyebrow} tone="accent" />
      <h1 class="cv-contact-hero__title">
        Tell the studio<br />
        about <em>the room</em>.
      </h1>
      <p class="cv-contact-hero__lede">{heroLede}</p>
    </Container>
  </SectionBlock>

  <!-- ─── Cal.com booking (booking.md) ──────────────────── -->
  <SectionBlock tone="subtle" padding="default" topBorder>
    <Container className="cv-contact-booking">
      <CalBookingBlock
        variant="inline"
        calLink={booking.cal_link}
        eventLabel={booking.cal_event_label ?? 'Book a studio call'}
        title={booking.title ?? 'Open a slot for the project.'}
        subtitle={booking.description}
        durationLabel={booking.cal_duration_label}
        layout={booking.cal_layout}
      />
    </Container>
  </SectionBlock>

  <!-- ─── Contact (form + info) ───────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="cv-contact-grid">
      <div class="cv-contact-grid__form-col">
        <h2 class="cv-contact-grid__form-title">Commission a project</h2>
        <p class="cv-contact-grid__form-lede">
          The more specific the brief, the more useful the studio
          call. Include the room, the audience, and any reference
          imagery you have already gathered.
        </p>

        <div
          id="form-success"
          class="cv-contact-grid__alert cv-contact-grid__alert--success"
          hidden
        >
          Thank you. The studio will reply within three business days.
        </div>
        <div
          id="form-error"
          class="cv-contact-grid__alert cv-contact-grid__alert--error"
          hidden
        >
          Something went wrong. Please try again or write the studio directly.
        </div>

        <form
          id="contact-form"
          data-contact-form
          data-success-message="Thank you. The studio will reply within three business days."
          class="cv-contact-grid__form"
        >
          <input type="hidden" name="_template" value="" />
          <input type="hidden" name="_source" value="" />

          <div class="cv-contact-grid__row">
            <FormField
              type="text"
              name="firstName"
              label="First name"
              placeholder="Your first name"
              required
            />
            <FormField
              type="text"
              name="lastName"
              label="Last name"
              placeholder="Your last name"
              required
            />
          </div>

          <FormField
            type="email"
            name="email"
            label="Email"
            placeholder="you@studio.com"
            required
          />

          <FormField
            type="text"
            name="projectType"
            label="Commission type"
            placeholder="Brand identity, editorial, retainer, or press"
          />

          <FormField
            type="text"
            name="budget"
            label="Budget range"
            placeholder="Approximate range, in USD"
          />

          <FormField
            type="textarea"
            name="message"
            label="Tell the studio about the project"
            placeholder="Describe the room, the audience, the timeline, and any imagery you've already gathered..."
            required
          />

          <button type="submit" class="cv-contact-grid__submit">
            Send to the studio
          </button>

          <p class="cv-contact-grid__note">
            All inquiries are read by Marcus directly. Press requests
            should mention the publication and the deadline in the
            opening line.
          </p>
        </form>
      </div>

      <aside class="cv-contact-grid__info-col">
        <h3 class="cv-contact-grid__info-title">Studio details</h3>
        <div class="cv-contact-grid__info-cards">
          <ContactCard
            label="Studio"
            value="Estudio Rivera"
            hint="Río Lerma 232, Cuauhtémoc, Mexico City — by appointment"
          />
          <ContactCard
            label="Press"
            value="press@marcusrivera.com"
            href="mailto:press@marcusrivera.com"
            hint="Editorial requests, hi-res, and press kit"
          />
          <ContactCard
            label="Email"
            value="studio@marcusrivera.com"
            href="mailto:studio@marcusrivera.com"
            hint="General inquiries, replies within 3 business days"
          />
        </div>

        <div id="press" class="cv-contact-grid__hours">
          <span class="cv-contact-grid__hours-label">Studio hours</span>
          <ul class="cv-contact-grid__hours-list">
            <li><span>Mon — Fri</span><span>10:00 — 18:00 CT</span></li>
            <li><span>Saturday</span><span>By appointment</span></li>
            <li><span>Sunday</span><span>Closed</span></li>
          </ul>
          <p class="cv-contact-grid__hours-note">
            Open by appointment. New commissions begin four weeks out.
          </p>
        </div>

        <div class="cv-contact-grid__phone">
          <span class="cv-contact-grid__phone-label">Phone</span>
          <a class="cv-contact-grid__phone-value" href="tel:+525555500188">
            +52 55 5550 0188
          </a>
          <span class="cv-contact-grid__phone-hint">
            Calls are returned within one business day. Press is the only line answered same-day.
          </span>
        </div>
      </aside>
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .cv-contact-hero {
    max-width: 880px;
  }

  .cv-contact-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: var(--fw-headline);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .cv-contact-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .cv-contact-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.55;
    max-width: 60ch;
  }

  /* Booking */
  .cv-contact-booking {
    max-width: 980px;
    margin: 0 auto;
  }

  /* Grid */
  .cv-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .cv-contact-grid__form-title {
    font-size: var(--fs-h3);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--bg-dark);
    margin-bottom: 16px;
  }

  .cv-contact-grid__form-lede {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .cv-contact-grid__form {
    display: grid;
    gap: 20px;
  }

  .cv-contact-grid__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .cv-contact-grid__alert {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    margin-bottom: 24px;
  }

  .cv-contact-grid__alert[hidden] {
    display: none;
  }

  .cv-contact-grid__alert--success {
    background: rgba(212, 165, 116, 0.18);
    color: #5a4220;
    border: 1px solid rgba(212, 165, 116, 0.4);
  }

  .cv-contact-grid__alert--error {
    background: rgba(220, 80, 80, 0.12);
    color: #8a2a2a;
    border: 1px solid rgba(220, 80, 80, 0.32);
  }

  .cv-contact-grid__submit {
    margin-top: 8px;
    padding: 18px 32px;
    font-family: var(--font-button);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border: 1px solid var(--bg-dark);
    transition:
      background var(--transition),
      color var(--transition),
      border-color var(--transition),
      transform var(--transition);
  }

  .cv-contact-grid__submit:hover {
    background: var(--brand-primary);
    color: var(--bg-dark);
    border-color: var(--brand-primary);
    transform: translateY(-1px);
  }

  .cv-contact-grid__note {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
    line-height: 1.5;
  }

  /* Info column */
  .cv-contact-grid__info-title {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .cv-contact-grid__info-cards {
    display: grid;
    gap: 16px;
    margin-bottom: 32px;
  }

  .cv-contact-grid__hours {
    padding: 28px 24px;
    background: var(--surface-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 24px;
  }

  .cv-contact-grid__hours-label {
    display: block;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .cv-contact-grid__hours-list {
    display: grid;
    gap: 8px;
  }

  .cv-contact-grid__hours-list li {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 6px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .cv-contact-grid__hours-list li:last-child {
    border-bottom: none;
  }

  .cv-contact-grid__hours-note {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--surface-subtle-border);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-style: italic;
  }

  .cv-contact-grid__phone {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border: 1px solid var(--surface-subtle-border);
    border-radius: var(--radius-md);
  }

  .cv-contact-grid__phone-label {
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .cv-contact-grid__phone-value {
    font-family: var(--font-title);
    font-size: var(--fs-h5);
    font-weight: var(--fw-semibold);
    color: var(--bg-dark);
    transition: color var(--transition);
  }

  .cv-contact-grid__phone-value:hover {
    color: var(--brand-primary);
  }

  .cv-contact-grid__phone-hint {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .cv-contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 600px) {
    .cv-contact-grid__row {
      grid-template-columns: 1fr;
    }
  }
</style>
