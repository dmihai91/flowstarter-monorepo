---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import ServiceCard from '../../../shared/dorin-ds/components/ServiceCard.astro';
import StatsRow from '../../../shared/dorin-ds/components/StatsRow.astro';
import CaseStudyCard from '../../../shared/dorin-ds/components/CaseStudyCard.astro';
import TestimonialBlock from '../../../shared/dorin-ds/components/TestimonialBlock.astro';
import FaqAccordionItem from '../../../shared/dorin-ds/components/FaqAccordionItem.astro';
import TagPill from '../../../shared/dorin-ds/components/TagPill.astro';
import VideoBlock from '../../../shared/dorin-ds/components/VideoBlock.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';

import { frontmatter as siteData } from '../../content/site.md';
import { frontmatter as heroData } from '../../content/hero.md';
import { frontmatter as servicesData } from '../../content/services.md';
import { frontmatter as testimonialsData } from '../../content/testimonials.md';
import { frontmatter as videoData } from '../../content/video.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface SiteContent {
  name?: string;
  tagline?: string;
  description?: string;
  year?: number;
}
interface HeroStat { value?: string; label?: string }
interface HeroContent { stats?: HeroStat[] }
interface ServiceItem {
  icon?: string;
  title?: string;
  description?: string;
  price?: string;
}
interface ServicesContent { services?: ServiceItem[] }
interface TestimonialItem {
  quote?: string;
  author?: string;
  role?: string;
  result?: string;
}
interface TestimonialsContent { testimonials?: TestimonialItem[] }
interface VideoContent {
  eyebrow?: string;
  title?: string;
  duration?: string;
  caption?: string;
  poster?: string;
  src?: string;
  aspect?: '21/9' | '16/9' | '4/3' | '1/1' | string;
}
interface BookingContent {
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
  cta?: string;
}

const site = siteData as SiteContent;
const hero = heroData as HeroContent;
const servicesContent = servicesData as ServicesContent;
const testimonialsContent = testimonialsData as TestimonialsContent;
const video = videoData as VideoContent;
const booking = bookingData as BookingContent;

// Hero stats mapped from hero.md ({ value, label } -> { number, label })
const heroStats = (hero.stats ?? []).map((s) => ({
  number: s.value ?? '',
  label: s.label ?? '',
}));

// Hand-built selected work — no .md source, kept as-is.
const selectedWork = [
  {
    title: 'Casa Bruma',
    category: 'Hospitality · Identity & photography · 2025',
    imageSrc:
      'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=1200&h=1040&fit=crop',
    index: '№ 01',
  },
  {
    title: 'Maison Lune',
    category: 'Fashion · Editorial photography · 2025',
    imageSrc:
      'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1200&h=1040&fit=crop',
    index: '№ 02',
  },
  {
    title: 'Galería Norte',
    category: 'Gallery · Identity, print, web · 2024',
    imageSrc:
      'https://images.unsplash.com/photo-1577720580479-7d839d829c73?w=1200&h=1040&fit=crop',
    index: '№ 03',
  },
  {
    title: 'Atelier Vega',
    category: 'Hospitality · Brand & art direction · 2024',
    imageSrc:
      'https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=1200&h=1040&fit=crop',
    index: '№ 04',
  },
];

// Hardcoded SVG icon strings — keyed to lucide:* names in services.md.
// Per the rules: keep SVGs in code, only swap text fields from .md.
const ICONS: Record<string, string> = {
  'lucide:palette':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
  'lucide:camera':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="5" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M7 5l1.5-2h7L17 5"/></svg>',
  'lucide:monitor':
    '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="3" rx="2"/><path d="M3 10h18M7 17h10"/></svg>',
};
const FALLBACK_ICON =
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>';

// Home page features the first three services from services.md.
const previewServices = (servicesContent.services ?? []).slice(0, 3).map((s) => ({
  icon: (s.icon && ICONS[s.icon]) || FALLBACK_ICON,
  title: s.title ?? '',
  description: s.description ?? '',
  meta: s.price ?? '',
}));

const testimonials = (testimonialsContent.testimonials ?? []).slice(0, 3);

// FAQ — no .md source, kept as-is.
const faqs = [
  {
    question: 'How does a typical commission start?',
    answer:
      'A studio call, then a written proposal, then a deposit. The studio works on a four-week minimum lead time, longer for travel-heavy shoots. Most commissions start within four to six weeks of first contact.',
  },
  {
    question: 'Do you travel for shoots?',
    answer:
      'Yes. About a third of the studio\u2019s shoots happen on location. Travel is invoiced at cost, with a flat per-diem. The studio has worked across Mexico, Spain, Italy, Morocco, Japan, and the United States.',
  },
  {
    question: 'Do you license existing imagery?',
    answer:
      'A small selection of personal work is available for editorial license — write to the studio with the publication, run dates, and territory. Commercial usage of commissioned work is negotiated per project.',
  },
  {
    question: 'Do you work with agencies?',
    answer:
      'Sometimes. The studio takes on agency-routed work when the brief is interesting and the rights structure is clean. Direct-client commissions are the default and account for most of the year.',
  },
  {
    question: 'Where does the studio work from?',
    answer:
      'Estudio Rivera is on Río Lerma in Mexico City. The studio also keeps a small loft in Brooklyn for North American shoots. About a third of each year is on location.',
  },
];

const pageTitle = `${site.name ?? 'Marcus Rivera'} — Visual Designer & Photographer`;
const pageDescription =
  site.description ??
  'Visual design and photography for hospitality, fashion, and gallery clients.';

// Normalize aspect ratio; VideoBlock only accepts a known set.
const allowedAspects = new Set(['21/9', '16/9', '4/3', '1/1']);
const videoAspect = (allowedAspects.has(video.aspect ?? '')
  ? (video.aspect as '21/9' | '16/9' | '4/3' | '1/1')
  : '16/9');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  activeIndex={-1}
>
  <!-- ─── Hero ──────────────────────────────────────────────── -->
  <SectionBlock id="home" tone="light" padding="hero" className="cv-hero">
    <Container className="cv-hero__inner">
      <div class="cv-hero__copy">
        <OverlineText text="Estudio Rivera · Mexico City / NYC" tone="accent" />
        <h1 class="cv-hero__title">
          <span>A studio for</span>
          <span class="cv-hero__title-accent">photograph-led</span>
          <span>identity &amp; image.</span>
        </h1>
        <p class="cv-hero__lede">
          Marcus Rivera is a visual designer and photographer working with
          hospitality, fashion, and gallery clients. Six years of studio
          practice. Two passports' worth of frequent flyer miles.
        </p>
        <div class="cv-hero__actions">
          <ActionButton
            href="/contact"
            label="Commission a project"
            variant="primary"
            size="large"
          />
          <ActionButton
            href="/services"
            label="View the studio"
            variant="outline-dark"
            size="large"
          />
        </div>
        <div class="cv-hero__pills">
          <TagPill label="Hospitality" />
          <TagPill label="Fashion" />
          <TagPill label="Gallery" />
          <TagPill label="Booking 6 weeks out" />
        </div>
      </div>

      <figure class="cv-hero__plate" aria-hidden="true">
        <div class="cv-hero__plate-image"></div>
        <figcaption class="cv-hero__plate-caption">
          Casa Bruma · Tulum · 2025
        </figcaption>
        <span class="cv-hero__plate-tag">№ 001 / 200</span>
      </figure>
    </Container>
  </SectionBlock>

  <!-- ─── Stats (hero.md) ──────────────────────────────────── -->
  <SectionBlock tone="accent-light" padding="compact" topBorder>
    <Container>
      <StatsRow items={heroStats} />
    </Container>
  </SectionBlock>

  <!-- ─── Selected work ───────────────────────────────────── -->
  <SectionBlock id="work" tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="Selected work"
        title="Four recent commissions."
        maxWidth="22ch"
      />
      <div class="cv-work-grid">
        {
          selectedWork.map((w) => (
            <CaseStudyCard
              title={w.title}
              category={w.category}
              imageSrc={w.imageSrc}
              index={w.index}
              href="/services"
            />
          ))
        }
      </div>
      <div class="cv-work-cta">
        <ActionButton
          href="/services"
          label="See the studio archive"
          variant="outline-dark"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Editorial plate ─────────────────────────────────── -->
  <SectionBlock tone="dark" padding="none" className="cv-plate-section">
    <div class="cv-plate-section__plate" aria-hidden="true"></div>
    <Container className="cv-plate-section__caption">
      <OverlineText text="From the archive" tone="accent" />
      <p class="cv-plate-section__text">
        Maison Lune · Spring lookbook · Marrakech · 2025. Shot on Pentax
        67ii, scanned and graded in studio. Editorial license available.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── Services preview (services.md) ──────────────────── -->
  <SectionBlock id="services" tone="subtle" padding="default">
    <Container>
      <SectionHeading
        label="The studio offers"
        title="Three core practices."
        maxWidth="22ch"
      />
      <div class="cv-services-grid">
        {
          previewServices.map((s) => (
            <ServiceCard
              icon={s.icon}
              title={s.title}
              description={s.description}
              meta={s.meta}
            />
          ))
        }
      </div>
      <div class="cv-services-cta">
        <ActionButton
          href="/services"
          label="See all six practices"
          variant="outline-dark"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Process film (video.md) ──────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <VideoBlock
        src={video.src ?? ''}
        poster={video.poster}
        title={video.title ?? 'Watch the studio at work'}
        caption={video.caption}
        eyebrow={video.eyebrow}
        duration={video.duration}
        aspect={videoAspect}
      />
    </Container>
  </SectionBlock>

  <!-- ─── Testimonials (testimonials.md) ───────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading label="Said by clients" title="Words from the work." />
      <div class="cv-testimonials">
        {
          testimonials[0] && (
            <TestimonialBlock
              quote={testimonials[0].quote ?? ''}
              author={testimonials[0].author ?? ''}
              role={testimonials[0].role ?? ''}
              result={testimonials[0].result ?? ''}
              layout="spotlight"
              className="cv-testimonials__lead"
            />
          )
        }
        <div class="cv-testimonials__rest">
          {
            testimonials.slice(1).map((t) => (
              <TestimonialBlock
                quote={t.quote ?? ''}
                author={t.author ?? ''}
                role={t.role ?? ''}
                result={t.result ?? ''}
              />
            ))
          }
        </div>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── FAQ ──────────────────────────────────────────────── -->
  <SectionBlock id="faq" tone="subtle" padding="default" topBorder>
    <Container className="cv-faq">
      <SectionHeading label="FAQ" title="Practical questions." />
      <div class="cv-faq__list">
        {faqs.map((f) => <FaqAccordionItem question={f.question} answer={f.answer} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA — Cal.com booking (booking.md) ───────────────── -->
  <SectionBlock id="contact" tone="dark" padding="default">
    <Container>
      <CalBookingBlock
        variant="cta"
        calLink={booking.cal_link}
        eventLabel={booking.cal_event_label ?? booking.cta ?? 'Book a studio call'}
        title={booking.title ?? 'Open a slot for the project.'}
        subtitle={booking.description}
        durationLabel={booking.cal_duration_label}
        layout={booking.cal_layout}
        className="cv-cta-booking"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .cv-hero {
    position: relative;
    overflow: clip;
  }

  .cv-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 48%);
    gap: 80px;
    align-items: center;
    min-height: 84vh;
  }

  .cv-hero__copy {
    max-width: 640px;
  }

  .cv-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 7vw, 5.8rem);
    font-weight: var(--fw-headline);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 24px 0 32px;
    color: var(--bg-dark);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cv-hero__title-accent {
    font-family: 'Georgia', serif;
    font-style: italic;
    text-transform: none;
    color: var(--brand-primary);
    font-weight: var(--fw-regular);
    letter-spacing: -0.045em;
  }

  .cv-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-primary);
    max-width: 56ch;
    margin-bottom: 36px;
  }

  .cv-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .cv-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Plate */
  .cv-hero__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: 0;
  }

  .cv-hero__plate-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=900&h=1100&fit=crop&crop=face');
    background-size: cover;
    background-position: center;
    filter: contrast(1.06) saturate(0.9);
    transition: transform 1.4s var(--ease-emphasized);
  }

  .cv-hero:hover .cv-hero__plate-image {
    transform: scale(1.03);
  }

  .cv-hero__plate-caption {
    position: absolute;
    left: 18px;
    bottom: 18px;
    font-family: 'Georgia', serif;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--bg-dark);
    background: var(--surface-base);
    padding: 6px 12px;
    letter-spacing: 0;
  }

  .cv-hero__plate-tag {
    position: absolute;
    top: 18px;
    right: 18px;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-on-dark);
    background: var(--bg-dark);
    padding: 6px 10px;
  }

  /* Work grid */
  .cv-work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 56px 32px;
  }

  .cv-work-cta {
    margin-top: 64px;
    text-align: center;
  }

  /* Editorial plate section */
  .cv-plate-section {
    position: relative;
    overflow: clip;
  }

  .cv-plate-section__plate {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=2000&h=1125&fit=crop');
    background-size: cover;
    background-position: center;
    filter: contrast(1.06) saturate(0.85);
  }

  .cv-plate-section__caption {
    padding-top: 48px;
    padding-bottom: 80px;
    max-width: 760px;
  }

  .cv-plate-section__text {
    margin-top: 16px;
    font-family: 'Georgia', serif;
    font-style: italic;
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    line-height: 1.45;
    color: var(--text-on-dark);
  }

  /* Services */
  .cv-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cv-services-cta {
    margin-top: 56px;
    text-align: center;
  }

  /* Testimonials */
  .cv-testimonials {
    display: grid;
    gap: 24px;
  }

  .cv-testimonials__rest {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* FAQ */
  .cv-faq {
    max-width: 920px;
  }

  .cv-faq__list {
    display: grid;
    gap: 12px;
  }

  /* Booking CTA — keep the dark tone of the section, but let the
     CalBookingBlock card pop forward on top of it. */
  .cv-cta-booking {
    max-width: 980px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .cv-hero__inner {
      grid-template-columns: 1fr;
      gap: 48px;
      min-height: auto;
    }

    .cv-hero__plate {
      aspect-ratio: 16 / 11;
      max-width: 720px;
    }

    .cv-services-grid,
    .cv-work-grid,
    .cv-testimonials__rest {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cv-services-grid,
    .cv-work-grid,
    .cv-testimonials__rest {
      grid-template-columns: 1fr;
    }
  }
</style>
