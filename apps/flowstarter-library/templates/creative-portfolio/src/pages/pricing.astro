---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import PricingCard from '../../../shared/dorin-ds/components/PricingCard.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';

import { frontmatter as siteData } from '../../content/site.md';
import { frontmatter as pricingData } from '../../content/pricing.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface SiteContent {
  name?: string;
  description?: string;
}
interface PricingPlan {
  name?: string;
  price?: number | string;
  period?: string;
  description?: string;
  features?: string[];
  cta?: string;
  popular?: boolean;
}
interface PricingContent {
  title?: string;
  subtitle?: string;
  plans?: PricingPlan[];
  guarantee?: string;
}
interface BookingContent {
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
  cta?: string;
}

const site = siteData as SiteContent;
const pricing = pricingData as PricingContent;
const booking = bookingData as BookingContent;

const formatPrice = (p: number | string | undefined): string => {
  if (typeof p === 'number') return `$${p.toLocaleString()}`;
  if (typeof p === 'string' && p.length > 0) return p;
  return '—';
};

const cards = (pricing.plans ?? []).map((p) => ({
  name: p.name ?? '',
  price: formatPrice(p.price),
  cadence: p.period ?? '',
  description: p.description ?? '',
  features: p.features ?? [],
  ctaLabel: p.cta ?? 'Get in touch',
  ctaHref: '/contact',
  featured: Boolean(p.popular),
}));

const pageTitle = `Pricing — ${site.name ?? 'Studio Rivera'}`;
const pageDescription =
  site.description ??
  'Studio Rivera engagement pricing — editorial commissions, retainers, and custom installations.';
---

<Layout title={pageTitle} description={pageDescription} activeIndex={2}>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="cv-pricing-hero">
      <OverlineText text="Studio rates" tone="accent" />
      <h1 class="cv-pricing-hero__title">
        {pricing.title ?? 'Engagements, transparently priced.'}
      </h1>
      {
        pricing.subtitle && (
          <p class="cv-pricing-hero__lede">{pricing.subtitle}</p>
        )
      }
    </Container>
  </SectionBlock>

  <!-- ─── Pricing grid (pricing.md) ──────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <div class="cv-pricing-grid">
        {cards.map((c) => <PricingCard {...c} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Guarantee ──────────────────────────────────────── -->
  {
    pricing.guarantee && (
      <SectionBlock tone="subtle" padding="compact" topBorder>
        <Container className="cv-pricing-guarantee">
          <span class="cv-pricing-guarantee__mark" aria-hidden="true">◆</span>
          <p class="cv-pricing-guarantee__text">{pricing.guarantee}</p>
        </Container>
      </SectionBlock>
    )
  }

  <!-- ─── Final CTA — Cal.com booking (booking.md) ───────── -->
  <SectionBlock tone="dark" padding="default">
    <Container>
      <CalBookingBlock
        variant="cta"
        calLink={booking.cal_link}
        eventLabel={booking.cal_event_label ?? booking.cta ?? 'Book a studio call'}
        title={booking.title ?? 'Open a slot for the project.'}
        subtitle={booking.description}
        durationLabel={booking.cal_duration_label}
        layout={booking.cal_layout}
        className="cv-pricing-booking"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .cv-pricing-hero {
    max-width: 880px;
  }

  .cv-pricing-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
    max-width: 22ch;
  }

  .cv-pricing-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--text-primary);
    max-width: 60ch;
  }

  /* Pricing grid */
  .cv-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  /* Guarantee */
  .cv-pricing-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .cv-pricing-guarantee__mark {
    color: var(--brand-primary);
    font-size: 1rem;
    line-height: 1;
  }

  .cv-pricing-guarantee__text {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: var(--bg-dark);
    margin: 0;
  }

  .cv-pricing-booking {
    max-width: 980px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .cv-pricing-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .cv-pricing-guarantee {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
