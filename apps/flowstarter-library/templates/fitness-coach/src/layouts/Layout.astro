---
import '../../../shared/dorin-ds/tokens.css';
import '../../../shared/dorin-ds/reset.css';
import DSHead from '../../../shared/dorin-ds/components/DSHead.astro';
import Header from '../../../shared/dorin-ds/components/Header.astro';
import Footer from '../../../shared/dorin-ds/components/Footer.astro';
import ContactScript from '../../../shared/ContactScript.astro';
import { frontmatter as contactFormData } from '../../content/integrations/contact-form.md';

interface Props {
  title?: string;
  description?: string;
  activeIndex?: number;
}

interface ContactFormContent {
  action_url?: string | null;
  success_message?: string | null;
}

const {
  title = 'Mike Torres — Strength & Performance Coach, Austin TX',
  description = 'NASM-certified strength and performance coaching in Austin, TX. 1-on-1, group, and online programming for adults who want to get measurably stronger.',
  activeIndex = -1,
} = Astro.props;

const contactForm = contactFormData as ContactFormContent;
const contactFormActionUrl =
  typeof contactForm.action_url === 'string' ? contactForm.action_url : '';
const contactFormSuccessMessage =
  typeof contactForm.success_message === 'string'
    ? contactForm.success_message
    : "Got it. I'll be in touch within 24 hours to lock in your trial.";

const navLinks = [
  { label: 'Programs', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Contact', href: '/contact' },
];

const footerColumns = [
  {
    heading: 'Programs',
    links: [
      { label: '1-on-1 training', href: '/services#one-on-one' },
      { label: '12-week transformation', href: '/services#transformation' },
      { label: 'Online coaching', href: '/services#online' },
      { label: 'Strength & conditioning', href: '/services#strength' },
    ],
  },
  {
    heading: 'About',
    links: [
      { label: 'How I coach', href: '/about#approach' },
      { label: 'Credentials', href: '/about#credentials' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'FAQ', href: '/services#faq' },
    ],
  },
  {
    heading: 'Train',
    links: [
      { label: 'Book a free trial', href: '/contact' },
      { label: 'mike@torrescoaching.com', href: 'mailto:mike@torrescoaching.com' },
      { label: '(512) 555-0419', href: 'tel:+15125550419' },
    ],
  },
];

const socials = [
  {
    href: '#',
    ariaLabel: 'Instagram',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8A4 4 0 0 1 16 11.37m1.5-4.87h.01"/></g></svg>',
  },
  {
    href: '#',
    ariaLabel: 'YouTube',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21.582 6.186a2.506 2.506 0 0 0-1.768-1.768C18.254 4 12 4 12 4s-6.254 0-7.814.418A2.506 2.506 0 0 0 2.418 6.186C2 7.746 2 12 2 12s0 4.254.418 5.814a2.506 2.506 0 0 0 1.768 1.768C5.746 20 12 20 12 20s6.254 0 7.814-.418a2.506 2.506 0 0 0 1.768-1.768C22 16.254 22 12 22 12s0-4.254-.418-5.814zM10 15.464V8.536L16 12z"/></svg>',
  },
  {
    href: '#',
    ariaLabel: 'TikTok',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.79a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.22Z"/></svg>',
  },
];
---

<!doctype html>
<html lang="en" data-template="fitness-coach">
  <head>
    <DSHead title={title} description={description} fontPair="manrope-anton" />
    <script is:inline>
      // Flowstarter preview iframe bridge
      (function () {
        if (window.self === window.top) return;
        document.documentElement.classList.add('fs-preview');
        window.parent.postMessage(
          { source: 'fs-template', type: 'ready' },
          '*',
        );
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.source !== 'fs-preview') return;
          var d = e.data;
          var root = document.documentElement;
          if (d.type === 'setTheme') {
            root.classList.toggle('theme-dark', d.value === 'dark');
            try {
              localStorage.setItem('theme', d.value);
            } catch (_) {}
          } else if (d.type === 'setPalette') {
            if (d.dark !== undefined) {
              root.classList.toggle('theme-dark', !!d.dark);
            }
            if (d.vars) {
              Object.keys(d.vars).forEach(function (k) {
                root.style.setProperty(k, d.vars[k]);
              });
            }
          } else if (d.type === 'setFont') {
            var existing = document.getElementById('fs-font-override');
            if (existing) existing.remove();
            if (d.url) {
              var link = document.createElement('link');
              link.id = 'fs-font-override';
              link.rel = 'stylesheet';
              link.href = d.url;
              document.head.appendChild(link);
            }
            if (d.heading)
              root.style.setProperty('--font-title', d.heading);
            if (d.body) root.style.setProperty('--font-body', d.body);
          }
        });
      })();
    </script>
  </head>
  <body>
    <Header
      brandLabel="Mike Torres"
      links={navLinks}
      ctaLabel="Book a free trial"
      ctaHref="/contact"
      activeIndex={activeIndex}
    />
    <main class="ds-main">
      <slot />
    </main>
    <Footer
      brandLabel="Mike Torres"
      tagline="Strength and performance coaching out of Iron Forge in East Austin. Built for adults who want measurable results without the fluff."
      columns={footerColumns}
      socials={socials}
      copyrightSuffix="Torres Coaching. All rights reserved."
    />
    <ContactScript
      actionUrl={contactFormActionUrl}
      successMessage={contactFormSuccessMessage}
      templateName="fitness-coach"
    />

    <style is:global>
      .ds-main {
        padding-top: 72px;
      }
    </style>
  </body>
</html>
