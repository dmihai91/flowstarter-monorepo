---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ContactCard from '../../../shared/dorin-ds/components/ContactCard.astro';
import FormField from '../../../shared/dorin-ds/components/FormField.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';

import { frontmatter as siteData } from '../../content/site.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';
import { frontmatter as contactFormData } from '../../content/integrations/contact-form.md';

interface SiteContact {
  email?: string;
  phone?: string;
  address?: string;
}

interface SiteContent {
  name: string;
  description?: string;
  contact?: SiteContact;
}

interface BookingContent {
  enabled?: boolean;
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

interface FormFieldContent {
  name: string;
  label: string;
  placeholder?: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  required?: boolean;
  width?: 'half' | 'full';
  rows?: number;
}

interface ContactFormContent {
  title?: string;
  description?: string;
  fields?: FormFieldContent[];
  submit_text?: string;
}

const site = siteData as SiteContent;
const booking = bookingData as BookingContent;
const contactForm = contactFormData as ContactFormContent;
const showBooking = booking.enabled === true && Boolean(booking.cal_link);

const contactInfo = site.contact ?? {};

// Form layout: render half-width fields side-by-side, full-width on their
// own row. We skip "select" types because the DS FormField component does
// not yet support them — fall back to a text input so the form still works.
const fieldsRaw = (contactForm.fields ?? []).filter(
  (f): f is FormFieldContent => Boolean(f && f.name && f.label),
);

interface FormRow {
  fields: FormFieldContent[];
}
const rows: FormRow[] = [];
let buffer: FormFieldContent[] = [];
for (const field of fieldsRaw) {
  if ((field.width ?? 'full') === 'half') {
    buffer.push(field);
    if (buffer.length === 2) {
      rows.push({ fields: buffer });
      buffer = [];
    }
  } else {
    if (buffer.length > 0) {
      rows.push({ fields: buffer });
      buffer = [];
    }
    rows.push({ fields: [field] });
  }
}
if (buffer.length > 0) rows.push({ fields: buffer });

function fieldType(t?: string): 'text' | 'email' | 'tel' | 'textarea' {
  if (t === 'email' || t === 'tel' || t === 'textarea') return t;
  return 'text';
}

const submitLabel = contactForm.submit_text ?? 'Send Message';
const formTitle = contactForm.title ?? 'Reach out';
const formDescription =
  contactForm.description ??
  "Questions about training? Send a message — I'll respond within 24 hours.";

const phoneHref = contactInfo.phone
  ? `tel:${contactInfo.phone.replace(/[^+\d]/g, '')}`
  : undefined;
const emailHref = contactInfo.email ? `mailto:${contactInfo.email}` : undefined;
---

<Layout
  title={`Contact — ${site.name}`}
  description={booking.description ?? site.description}
  activeIndex={3}
>
  <!-- ─── Cal.com booking — top of page ───────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="fc-contact-hero">
      <header class="fc-contact-hero__head">
        <OverlineText text="Get in touch" tone="accent" />
        <h1 class="fc-contact-hero__title">
          Lock in your<br /><em>free assessment</em>.
        </h1>
        <p class="fc-contact-hero__lede">
          Send over your details and we'll set up a 45-minute movement-and-goals
          screen — in person in Cluj-Napoca or over video. You leave with a
          written next-step plan whether we keep training together or not.
        </p>
      </header>
      {
        showBooking && (
          <CalBookingBlock
            variant="inline"
            calLink={booking.cal_link}
            eventLabel={booking.cal_event_label ?? 'Free assessment session'}
            title={booking.title ?? 'Lock in your free assessment.'}
            subtitle={booking.description ??
              'Pick a time and we will run a 45-minute movement and goals assessment.'}
            durationLabel={booking.cal_duration_label ?? '45 minutes · in-person or video · free'}
            layout={booking.cal_layout ?? 'month_view'}
            className="fc-contact-hero__cal"
          />
        )
      }
    </Container>
  </SectionBlock>

  <!-- ─── Form + direct contact ──────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="fc-contact-grid">
      <div class="fc-contact-grid__form-col">
        <h2 class="fc-contact-grid__form-title">{formTitle}</h2>
        <p class="fc-contact-grid__form-lede">{formDescription}</p>

        <div
          id="form-success"
          class="fc-contact-grid__alert fc-contact-grid__alert--success"
          hidden
        >
          Thanks — message received. I'll be in touch within 24 hours.
        </div>
        <div
          id="form-error"
          class="fc-contact-grid__alert fc-contact-grid__alert--error"
          hidden
        >
          Something went wrong. Please try again or email me directly.
        </div>

        <form
          id="contact-form"
          data-contact-form
          data-success-message="Thanks — message received. I'll be in touch within 24 hours."
          class="fc-contact-grid__form"
        >
          <input type="hidden" name="_template" value="fitness-coach" />
          <input type="hidden" name="_source" value="contact" />

          {
            rows.map((row) => (
              <div
                class={`fc-contact-grid__row ${
                  row.fields.length === 2 ? 'fc-contact-grid__row--split' : ''
                }`}
              >
                {row.fields.map((field) => (
                  <FormField
                    type={fieldType(field.type)}
                    name={field.name}
                    label={field.label}
                    placeholder={field.placeholder ?? ''}
                    required={Boolean(field.required)}
                    rows={field.rows ?? 5}
                  />
                ))}
              </div>
            ))
          }

          <button type="submit" class="fc-contact-grid__submit">
            {submitLabel}
          </button>

          <p class="fc-contact-grid__note">
            All inquiries stay confidential. You'll hear back within one
            business day.
          </p>
        </form>
      </div>

      <aside class="fc-contact-grid__info-col">
        <h3 class="fc-contact-grid__info-title">Or reach out directly</h3>
        <div class="fc-contact-grid__info-cards">
          {
            contactInfo.email && (
              <ContactCard
                label="Email"
                value={contactInfo.email}
                href={emailHref}
                hint="Replies within 24 hours, weekdays"
              />
            )
          }
          {
            contactInfo.phone && (
              <ContactCard
                label="Phone"
                value={contactInfo.phone}
                href={phoneHref}
                hint="Mon–Fri, 8:00–18:00 EET"
              />
            )
          }
          {
            contactInfo.address && (
              <ContactCard
                label="Studio"
                value="Cluj-Napoca"
                hint={contactInfo.address}
              />
            )
          }
        </div>

        <div class="fc-contact-grid__hours">
          <span class="fc-contact-grid__hours-label">Coaching hours</span>
          <ul class="fc-contact-grid__hours-list">
            <li><span>Mon — Fri</span><span>7:00 — 19:00 EET</span></li>
            <li><span>Saturday</span><span>By appointment</span></li>
            <li><span>Sunday</span><span>Closed</span></li>
          </ul>
        </div>
      </aside>
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .fc-contact-hero {
    display: grid;
    gap: 48px;
  }

  .fc-contact-hero__head {
    max-width: 720px;
  }

  .fc-contact-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.6vw, 4.4rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 24px 0 24px;
    color: var(--bg-dark);
  }

  .fc-contact-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fc-contact-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 60ch;
    color: var(--text-primary);
  }

  /* Grid */
  .fc-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .fc-contact-grid__form-title {
    font-family: var(--font-title);
    font-size: var(--fs-h3);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--bg-dark);
    margin-bottom: 16px;
  }

  .fc-contact-grid__form-lede {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .fc-contact-grid__form {
    display: grid;
    gap: 20px;
  }

  .fc-contact-grid__row {
    display: grid;
    gap: 20px;
  }

  .fc-contact-grid__row--split {
    grid-template-columns: 1fr 1fr;
  }

  .fc-contact-grid__alert {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    margin-bottom: 24px;
  }

  .fc-contact-grid__alert[hidden] {
    display: none;
  }

  .fc-contact-grid__alert--success {
    background: rgba(124, 152, 133, 0.16);
    color: #3a5544;
    border: 1px solid rgba(124, 152, 133, 0.32);
  }

  .fc-contact-grid__alert--error {
    background: rgba(220, 80, 80, 0.12);
    color: #8a2a2a;
    border: 1px solid rgba(220, 80, 80, 0.32);
  }

  .fc-contact-grid__submit {
    margin-top: 8px;
    padding: 18px 32px;
    font-family: var(--font-button);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border: 1px solid var(--bg-dark);
    cursor: pointer;
    transition: opacity var(--transition);
  }

  .fc-contact-grid__submit:hover {
    opacity: 0.85;
  }

  .fc-contact-grid__note {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
  }

  /* Info column */
  .fc-contact-grid__info-title {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .fc-contact-grid__info-cards {
    display: grid;
    gap: 16px;
    margin-bottom: 40px;
  }

  .fc-contact-grid__hours {
    padding: 28px 24px;
    background: var(--surface-subtle);
    border-radius: var(--radius-md);
  }

  .fc-contact-grid__hours-label {
    display: block;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .fc-contact-grid__hours-list {
    display: grid;
    gap: 8px;
  }

  .fc-contact-grid__hours-list li {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 6px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .fc-contact-grid__hours-list li:last-child {
    border-bottom: none;
  }

  @media (max-width: 1024px) {
    .fc-contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 600px) {
    .fc-contact-grid__row--split {
      grid-template-columns: 1fr;
    }
  }
</style>
