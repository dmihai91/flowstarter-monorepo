---
import Layout from '../layouts/Layout.astro';
import '../../../shared/editorial.css';

const nav = [
  { label: 'Programs', href: '#fees' },
  { label: 'Coaching', href: '#work' },
  { label: 'Approach', href: '#studio' },
  { label: 'Contact', href: '#contact' },
];
const stats = [
  { n: '180+', l: 'Clients coached' },
  { n: 'NSCA-CPT', l: 'Certified' },
  { n: 'Hybrid', l: 'In-person + online' },
];
const work = [
  { src: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1400&h=1750&fit=crop', alt: 'Strength training session', tag: 'Strength', place: 'Build the base', span: 'tall' },
  { src: 'https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?w=1400&h=1050&fit=crop', alt: 'Coaching a lift', tag: 'Technique', place: 'Move well first', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=1200&h=1500&fit=crop', alt: 'Conditioning work', tag: 'Conditioning', place: 'Built to last', span: 'reg' },
  { src: 'https://images.unsplash.com/photo-1517438476312-10d79c077509?w=1400&h=1050&fit=crop', alt: 'Training the whole room', tag: 'Small group', place: 'Train together', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=1200&h=1500&fit=crop', alt: 'A client mid-session', tag: 'Results', place: 'Honest progress', span: 'tall' },
];
const offerings = [
  { k: '01', name: '1:1 in person', body: 'Private sessions in Cluj-Napoca, programmed and coached rep by rep.', price: 'from €45 / session' },
  { k: '02', name: 'Online programming', body: 'A custom plan in your pocket, updated weekly, with video feedback on your lifts.', price: 'from €120 / mo' },
  { k: '03', name: 'Hybrid coaching', body: 'In-person where it matters, online for the rest. The best of both.', price: 'from €240 / mo' },
  { k: '04', name: 'Small group', body: 'Train with two or three others on the same goal. Cheaper, and more fun.', price: 'from €25 / session' },
];
---
<Layout>
  <div class="grain" aria-hidden="true"></div>
  <header class="nav">
    <a href="#top" class="brand"><span class="brand__mark" aria-hidden="true"></span>Radu&nbsp;Stoica</a>
    <nav class="nav__links" aria-label="Primary">{nav.map((i) => <a href={i.href}>{i.label}</a>)}</nav>
    <div class="nav__right">
      <button type="button" class="themer" data-themer aria-label="Toggle dark mode"><span class="themer__dot"></span></button>
      <a href="#contact" class="btn btn--sm">Book a free trial</a>
    </div>
  </header>
  <main id="top">
    <section class="hero">
      <div class="hero__copy reveal">
        <p class="eyebrow">Strength coaching — Cluj-Napoca &amp; online</p>
        <h1 class="display">Train<br />with<br /><em>intent.</em></h1>
        <p class="lede">I'm Radu Stoica, a strength coach for busy adults. We build something you can actually use — more structure, better movement, and progress you can sustain past January.</p>
        <div class="hero__cta">
          <a href="#contact" class="btn">Book a free trial</a>
          <a href="#fees" class="link-arrow">See programs →</a>
        </div>
        <dl class="stats">{stats.map((s) => (<div><dt>{s.n}</dt><dd>{s.l}</dd></div>))}</dl>
      </div>
      <figure class="hero__plate reveal" style="--d:.15s">
        <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=1100&h=1450&fit=crop" alt="Strength training in the gym" loading="eager" />
        <figcaption><span>№ 01</span> Build the base, then build on it</figcaption>
      </figure>
    </section>
    <div class="strip" aria-hidden="true"><div class="strip__row">
      <span>Strength</span><span class="dot">✦</span><span>Conditioning</span><span class="dot">✦</span><span>Technique</span><span class="dot">✦</span><span>Mobility</span><span class="dot">✦</span><span>Sustainable</span><span class="dot">✦</span>
      <span>Strength</span><span class="dot">✦</span><span>Conditioning</span><span class="dot">✦</span><span>Technique</span><span class="dot">✦</span><span>Mobility</span><span class="dot">✦</span><span>Sustainable</span><span class="dot">✦</span>
    </div></div>
    <section class="section" id="work">
      <div class="section__head"><p class="eyebrow">The work</p><h2 class="h2">Build something you can use.</h2></div>
      <div class="gallery">{work.map((w, i) => (
        <figure class={`gal gal--${w.span} reveal`} style={`--d:${i * 0.06}s`}><img src={w.src} alt={w.alt} loading="lazy" /><figcaption><span class="gal__tag">{w.tag}</span><span class="gal__place">{w.place}</span></figcaption></figure>
      ))}</div>
    </section>
    <section class="section studio" id="studio">
      <figure class="studio__img reveal"><img src="https://images.unsplash.com/photo-1499914485622-a88fac536970?w=1000&h=1250&fit=crop" alt="Radu Stoica, strength coach" loading="lazy" /></figure>
      <div class="studio__copy reveal" style="--d:.1s">
        <p class="eyebrow">How I coach</p>
        <h2 class="h2">Less hype.<br />More progress.</h2>
        <p>Most people don't need a harder workout — they need a plan that fits their week and a coach who'll keep them honest. We start with how you move, build a base of real strength, and add load only when you've earned it.</p>
        <p>No crash plans, no fads. Just consistent, well-programmed training that compounds — so you're stronger at forty than you were at thirty, and you stay that way.</p>
        <p class="sig">— Radu</p>
      </div>
    </section>
    <section class="section" id="fees">
      <div class="section__head"><p class="eyebrow">Programs</p><h2 class="h2">Pick how you want to train.</h2></div>
      <ul class="offer">{offerings.map((o) => (
        <li class="offer__row reveal"><span class="offer__k">{o.k}</span><span class="offer__name">{o.name}</span><span class="offer__body">{o.body}</span><span class="offer__price">{o.price}</span></li>
      ))}</ul>
      <p class="offer__note">Every program starts with a free assessment session — movement screen, goals, and an honest plan. No lock-in.</p>
    </section>
    <section class="quote reveal">
      <blockquote>“I'd started and quit a dozen times. Radu built something that fit my actual life — eighteen months in, I'm still going, and I'm stronger than I've ever been.”</blockquote>
      <cite>Andrei T. — training since 2024</cite>
    </section>
    <section class="cta" id="contact">
      <p class="eyebrow eyebrow--accent">A free assessment session</p>
      <h2 class="display cta__title">Start<br />training.</h2>
      <p class="cta__lede">Come in for a free assessment — we'll screen your movement, talk through your goals, and map an honest plan. No pressure, no lock-in.</p>
      <div class="cta__actions"><a href="mailto:hello@radustoica.com" class="btn btn--lg">Book a free trial</a><a href="tel:+40740000000" class="link-arrow">+40 740 000 000</a></div>
    </section>
  </main>
  <footer class="foot">
    <div class="foot__top">
      <div class="foot__brand">Radu Stoica</div>
      <div class="foot__cols">
        <div><h4>Programs</h4><a href="#fees">1:1 in person</a><a href="#fees">Online</a><a href="#fees">Small group</a></div>
        <div><h4>About</h4><a href="#studio">Approach</a><a href="#work">The work</a><a href="#contact">Contact</a></div>
        <div><h4>Elsewhere</h4><a href="#">Instagram</a><a href="#">YouTube</a><a href="mailto:hello@radustoica.com">Email</a></div>
      </div>
    </div>
    <div class="foot__base"><span>© 2026 Radu Stoica</span><span>Cluj-Napoca · Online worldwide</span></div>
  </footer>
  <script is:inline>
    (function () { var btn = document.querySelector('[data-themer]'); if (btn) btn.addEventListener('click', function () { var dark = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', dark); document.documentElement.classList.toggle('dark', dark); try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (_) {} }); })();
    (function () { var els = document.querySelectorAll('.reveal'); if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; } var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.12 }); els.forEach(function (e) { io.observe(e); }); })();
  </script>
  <style is:global>
    :root { --bg:#f6f1ea; --bg-2:#efe5d8; --surface:#fcf8f2; --ink:#1d1814; --ink-soft:#473c33; --muted:#867565; --accent:#d6562a; --accent-2:#e8763f; --line:rgba(29,24,20,.14); --line-soft:rgba(29,24,20,.08); --shadow:0 30px 70px -30px rgba(29,24,20,.42); --grain:.04; }
    html.theme-dark, html.dark { --bg:#120f0c; --bg-2:#1a140f; --surface:#1c1611; --ink:#f4ece2; --ink-soft:#dccfc0; --muted:#9c8c7a; --accent:#f0824f; --accent-2:#f59a6e; --line:rgba(244,236,226,.15); --line-soft:rgba(244,236,226,.08); --shadow:0 30px 80px -30px rgba(0,0,0,.7); --grain:.065; }
  </style>
</Layout>
