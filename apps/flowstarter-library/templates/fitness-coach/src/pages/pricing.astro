---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import PricingCard from '../../../shared/dorin-ds/components/PricingCard.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';

import { frontmatter as siteData } from '../../content/site.md';
import { frontmatter as pricingData } from '../../content/pricing.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface SiteContent {
  name: string;
  description?: string;
}

interface PricingPlan {
  name: string;
  price: number | string;
  period?: string;
  description?: string;
  features: string[];
  cta: string;
  popular?: boolean;
}

interface PricingContent {
  title?: string;
  subtitle?: string;
  plans: PricingPlan[];
  guarantee?: string;
}

interface BookingContent {
  enabled?: boolean;
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

const site = siteData as SiteContent;
const pricing = pricingData as PricingContent;
const booking = bookingData as BookingContent;

function formatPrice(p: number | string): string {
  if (typeof p === 'number') return `$${p.toLocaleString('en-US')}`;
  const trimmed = String(p).trim();
  return trimmed.startsWith('$') ? trimmed : `$${trimmed}`;
}
---

<Layout
  title={`Pricing — ${site.name}`}
  description={site.description}
  activeIndex={2}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="fc-pricing-hero">
      <OverlineText text="Pricing" tone="accent" />
      <h1 class="fc-pricing-hero__title">
        {pricing.title ?? 'Investment in your training.'}
      </h1>
      {
        pricing.subtitle && (
          <p class="fc-pricing-hero__lede">{pricing.subtitle}</p>
        )
      }
    </Container>
  </SectionBlock>

  <!-- ─── Plans grid ────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <div class="fc-pricing-grid">
        {
          pricing.plans.map((plan) => (
            <PricingCard
              name={plan.name}
              price={formatPrice(plan.price)}
              cadence={plan.period ?? ''}
              description={plan.description ?? ''}
              features={plan.features}
              ctaLabel={plan.cta}
              ctaHref="/contact"
              featured={Boolean(plan.popular)}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Guarantee ─────────────────────────────────────── -->
  {
    pricing.guarantee && (
      <SectionBlock tone="accent-light" padding="compact" topBorder>
        <Container className="fc-pricing-guarantee">
          <span class="fc-pricing-guarantee__mark" aria-hidden="true">
            ●
          </span>
          <p class="fc-pricing-guarantee__text">{pricing.guarantee}</p>
        </Container>
      </SectionBlock>
    )
  }

  <!-- ─── CTA — Cal.com booking ────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="fc-pricing-cta">
      <CalBookingBlock
        variant="cta"
        calLink={booking.cal_link}
        eventLabel={booking.cal_event_label ?? 'Book a free trial'}
        title={booking.title ?? 'Try a session before you commit.'}
        subtitle={booking.description ??
          'The first assessment is on me. Pick a time and we will figure out which program fits.'}
        durationLabel={booking.cal_duration_label ?? '45 minutes · in-person or video · free'}
        layout={booking.cal_layout ?? 'month_view'}
        className="fc-pricing-cta__cal"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .fc-pricing-hero {
    max-width: 880px;
  }

  .fc-pricing-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 24px 0 24px;
    color: var(--bg-dark);
  }

  .fc-pricing-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 60ch;
    color: var(--text-primary);
  }

  /* Plans grid */
  .fc-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  /* Guarantee */
  .fc-pricing-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .fc-pricing-guarantee__mark {
    color: var(--brand-primary);
    font-size: 1rem;
    line-height: 1;
  }

  .fc-pricing-guarantee__text {
    font-family: var(--font-title);
    font-size: var(--fs-h5);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    line-height: 1.4;
  }

  /* CTA */
  .fc-pricing-cta {
    max-width: 1080px;
    margin: 0 auto;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .fc-pricing-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .fc-pricing-guarantee {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
