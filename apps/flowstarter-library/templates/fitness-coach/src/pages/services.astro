---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import ServiceCard from '../../../shared/dorin-ds/components/ServiceCard.astro';
import FaqAccordionItem from '../../../shared/dorin-ds/components/FaqAccordionItem.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';

import { frontmatter as siteData } from '../../content/site.md';
import { frontmatter as servicesData } from '../../content/services.md';

interface SiteContent {
  name: string;
  description?: string;
}

interface ServiceItem {
  icon: string;
  title: string;
  description: string;
  price?: string;
}

interface ServicesContent {
  title?: string;
  subtitle?: string;
  services: ServiceItem[];
}

const site = siteData as SiteContent;
const services = servicesData as ServicesContent;

// Hand-built SVG icon palette, paired by index with services.md so the
// content file stays clean (lucide:* tokens) while the visual identity
// remains hand-crafted.
const serviceIcons: string[] = [
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v16M18 4v16M3 8h3M3 16h3M18 8h3M18 16h3M9 6v12M15 6v12"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M12 3v18M9 8l3 3 3-3M9 16l3-3 3 3"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8m-4-3v3"/><path d="M7 9h10M7 13h6"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l5 3"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v6H4zM4 14h16v6H4zM8 4v6M16 4v6M8 14v6M16 14v6"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0-18 0z"/><path d="M12 7v5l3 2M8.5 14.5h7"/></svg>',
];

// Bespoke programme detail (no .md field) — describes how each block is run.
const blocks = [
  {
    number: '01',
    title: 'Movement assessment',
    description:
      'Every program starts with a 45-minute screen. Squat / hinge / push / pull / brace, joint by joint. We log mobility limits, asymmetries, and a strength baseline before we write a single set.',
  },
  {
    number: '02',
    title: 'Periodised blocks',
    description:
      'Three- to four-week blocks built around your goal. Volume rises, then intensity peaks, then we deload — on the calendar, not on a feeling. The structure is what makes progress safe.',
  },
  {
    number: '03',
    title: 'Tracked & reviewed',
    description:
      'RPE on every working set, video on the heavy lifts, weekly check-ins inside the app. Monthly review built into every program. Plateaus get diagnosed and broken with a deliberate change.',
  },
];

const faqs = [
  {
    question: 'Which program should I start with?',
    answer:
      "If you're new to lifting or returning from a layoff, start with 1-on-1 — the form coaching is irreplaceable in those first months. If you have a couple of years of training and you can move well, online coaching is the highest-leverage option.",
  },
  {
    question: 'Do you offer payment plans?',
    answer:
      'Yes for the 12-week transformation and any block of ten or more sessions. Half upfront, half at week six. No interest, no fees. Reach out via the contact form to set it up.',
  },
  {
    question: 'What if I have to cancel a session?',
    answer:
      "Twenty-four hours notice and we reschedule, no charge. Inside twenty-four hours the session counts unless it's an injury or emergency — that's the rule that makes the calendar work for everyone.",
  },
  {
    question: 'Can the programs work around an injury?',
    answer:
      "Yes — most clients are training around something. I'm trained in CSCS-level rehab progressions and stay in close communication with your PT or doc when one is involved. Pain is information; we route around it intelligently.",
  },
];

const heroPrice =
  services.services[0]?.price ?? 'Programs from $45';
---

<Layout
  title={`Programs — ${site.name}`}
  description={services.subtitle ??
    'Six ways to train under coaching. 1-on-1, group, online, transformation, strength & conditioning, and nutrition planning.'}
  activeIndex={0}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="fc-services-hero">
      <div class="fc-services-hero__copy">
        <OverlineText text="Programs" tone="accent" />
        <h1 class="fc-services-hero__title">
          {services.title ?? 'Six ways to train under coaching.'}
        </h1>
        {
          services.subtitle && (
            <p class="fc-services-hero__lede">{services.subtitle}</p>
          )
        }
        <div class="fc-services-hero__actions">
          <ActionButton
            href="/contact"
            label="Book a free trial"
            variant="primary"
            size="large"
          />
          <ActionButton
            href="/pricing"
            label="See pricing"
            variant="outline-dark"
            size="large"
          />
        </div>
      </div>
      <aside class="fc-services-hero__rail" aria-label="At a glance">
        <span class="fc-services-hero__rail-label">Starting at</span>
        <span class="fc-services-hero__rail-value">{heroPrice}</span>
        <span class="fc-services-hero__rail-note">
          One-off sessions, monthly memberships, and 12-week programs. Pricing
          on every card below.
        </span>
      </aside>
    </Container>
  </SectionBlock>

  <!-- ─── Programs grid ───────────────────────────────────── -->
  <SectionBlock id="programs" tone="subtle" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="Catalog"
        title="Every program, every cadence."
      />
      <div class="fc-services-grid">
        {
          services.services.map((s, i) => (
            <ServiceCard
              icon={serviceIcons[i % serviceIcons.length]}
              title={s.title}
              description={s.description}
              meta={s.price}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── How a block runs ───────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="fc-services-blocks">
      <div class="fc-services-blocks__heading">
        <OverlineText text="How a block runs" tone="accent" />
        <h2 class="section-title fc-services-blocks__title">
          The same method,<br />every program.
        </h2>
      </div>
      <div class="fc-services-blocks__list">
        {
          blocks.map((b) => (
            <NumberedFeatureItem
              number={b.number}
              title={b.title}
              description={b.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── FAQ ──────────────────────────────────────────────── -->
  <SectionBlock id="faq" tone="light" padding="default" topBorder>
    <Container className="fc-services-faq">
      <SectionHeading
        label="FAQ"
        title="Before you book."
        align="center"
      />
      <div class="fc-services-faq__list">
        {faqs.map((f) => <FaqAccordionItem question={f.question} answer={f.answer} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="fc-services-cta">
      <h2 class="fc-services-cta__title">
        Pick a program.<br />Book the trial.
      </h2>
      <p class="fc-services-cta__lede">
        First session is on me — full assessment, sample workout, plain
        conversation about which program fits.
      </p>
      <div class="fc-services-cta__actions">
        <ActionButton
          href="/contact"
          label="Book a free trial"
          variant="primary-light"
          size="large"
          className="fs-book-btn"
        />
        <ActionButton
          href="/pricing"
          label="See pricing"
          variant="outline-light"
          size="large"
        />
      </div>
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .fc-services-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr);
    gap: 64px;
    align-items: center;
  }

  .fc-services-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    font-weight: var(--fw-headline);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
    max-width: 18ch;
  }

  .fc-services-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 56ch;
    margin-bottom: 36px;
  }

  .fc-services-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .fc-services-hero__rail {
    display: grid;
    gap: 12px;
    padding: 32px 28px;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border-radius: var(--radius-md);
  }

  .fc-services-hero__rail-label {
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 1.6px;
    color: var(--brand-primary);
  }

  .fc-services-hero__rail-value {
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: var(--fw-headline);
    letter-spacing: -0.02em;
    color: var(--text-on-dark);
  }

  .fc-services-hero__rail-note {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-nav);
  }

  /* Grid */
  .fc-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Blocks (dark) */
  .fc-services-blocks {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 80px;
  }

  .fc-services-blocks__heading {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .fc-services-blocks__title {
    color: var(--text-on-dark);
    margin-top: 16px;
    max-width: 14ch;
  }

  /* FAQ */
  .fc-services-faq {
    max-width: 920px;
  }

  .fc-services-faq__list {
    display: grid;
    gap: 12px;
  }

  /* CTA */
  .fc-services-cta {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .fc-services-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: var(--fw-headline);
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .fc-services-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--text-nav);
    margin-bottom: 36px;
  }

  .fc-services-cta__actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .fc-services-hero,
    .fc-services-blocks {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .fc-services-blocks__heading {
      position: static;
    }

    .fc-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .fc-services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
