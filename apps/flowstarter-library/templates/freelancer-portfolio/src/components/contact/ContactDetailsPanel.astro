---
import ActionButton from '../design-system/ActionButton.astro';

interface Props {
  details: {
    emailLabel: string;
    emailValue: string;
    emailHref: string;
    phoneLabel: string;
    phoneValue: string;
    phoneHref: string;
    addressLabel: string;
    addressValue: string;
    mapEmbedUrl: string;
    strategicCallLabel: string;
    strategicCallHref: string;
  };
}

const { details } = Astro.props;
---

<aside class="contact-details-panel">
  <div class="contact-details-panel__details">
    <div class="contact-details-panel__block">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      <div class="contact-details-panel__text">
        <h5>{details.emailLabel}</h5>
        <a href={details.emailHref}>{details.emailValue}</a>
      </div>
    </div>
    <div class="contact-details-panel__block">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <div class="contact-details-panel__text">
        <h5>{details.phoneLabel}</h5>
        <a href={details.phoneHref}>{details.phoneValue}</a>
      </div>
    </div>
    <div class="contact-details-panel__block">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <div class="contact-details-panel__text">
        <h5>{details.addressLabel}</h5>
        <p>{details.addressValue}</p>
      </div>
    </div>
  </div>

  <div class="contact-details-panel__map-shell">
    <iframe
      class="contact-details-panel__map"
      src={details.mapEmbedUrl}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Map location"
    ></iframe>
  </div>

  <ActionButton
    href={details.strategicCallHref}
    label={details.strategicCallLabel}
    variant="outline"
    className="contact-details-panel__button ds-action-button--outline-dark ds-action-button--outline-thick"
  >
    <svg slot="prefix" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
  </ActionButton>
</aside>

<style>
  .contact-details-panel {
    --panel-padding: 32px;
    position: sticky;
    top: 104px;
    padding: var(--panel-padding);
    display: grid;
    gap: 28px;
    background: var(--surface-panel);
    backdrop-filter: blur(10px);
    border: 1px solid var(--surface-panel-border);
  }

  .contact-details-panel__details {
    display: grid;
    gap: 20px;
  }

  .contact-details-panel__block {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 12px;
    align-items: start;
    color: var(--bg-dark);
  }

  .contact-details-panel__text {
    display: grid;
    gap: 4px;
  }

  .contact-details-panel__block h5 {
    text-transform: uppercase;
    color: var(--bg-dark);
  }

  .contact-details-panel__block a,
  .contact-details-panel__block p {
    color: var(--bg-dark);
    line-height: 1.5;
  }

  .contact-details-panel__map-shell {
    overflow: hidden;
    border: 1px solid var(--surface-panel-border);
    background: var(--surface-field);
  }

  .contact-details-panel__map {
    width: 100%;
    height: 280px;
    border: 0;
    filter: grayscale(1) contrast(1.05);
  }

  :global(.contact-details-panel__button) {
    justify-self: stretch;
    justify-content: center;
    gap: 8px;
  }

  @media (max-width: 1024px) {
    .contact-details-panel {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .contact-details-panel {
      --panel-padding: 24px 20px;
      padding: var(--panel-padding);
    }

    :global(.contact-details-panel__button) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
