---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import StatsRow from '../../../shared/dorin-ds/components/StatsRow.astro';
import QuoteBlock from '../../../shared/dorin-ds/components/QuoteBlock.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import GalleryGrid from '../../../shared/dorin-ds/components/GalleryGrid.astro';
import { frontmatter as siteLabels } from '../content/site-labels.md';
import { frontmatter as galleryData } from '../../content/gallery.md';

interface JourneyEntry {
  year?: string;
  title?: string;
  description?: string;
}

interface SiteLabelsShape {
  aboutPage?: {
    journey?: { items?: JourneyEntry[] };
    backgroundExperience?: {
      uvps?: string[];
      reasons?: string[];
    };
  };
  stats?: { items?: Array<{ number?: string; label?: string }> };
}

interface GalleryItem {
  src?: string;
  alt?: string;
  span?: string;
  aspect?: string;
  tag?: string;
}

interface GalleryFrontmatter {
  eyebrow?: string;
  title?: string;
  side_note?: string;
  items?: GalleryItem[];
}

const labels = siteLabels as SiteLabelsShape;
const gallery = galleryData as GalleryFrontmatter;

const journeyItems = labels.aboutPage?.journey?.items ?? [];
const journey = journeyItems
  .map((j) => ({
    number: j?.year ?? '',
    title: j?.title ?? '',
    description: j?.description ?? '',
  }))
  // Drop placeholder rows like "[Year 1]" so the section degrades cleanly
  // when the user has not yet filled in real milestones.
  .filter((j) => j.number && !j.number.startsWith('['));

// Credentials live as two arrays in site-labels (uvps + reasons under
// backgroundExperience). We merge them; placeholders are filtered out.
const credentialPool = [
  ...(labels.aboutPage?.backgroundExperience?.uvps ?? []),
  ...(labels.aboutPage?.backgroundExperience?.reasons ?? []),
].filter((c): c is string => typeof c === 'string' && !c.startsWith('['));

const FALLBACK_CREDENTIALS = [
  'BFA Communication Design — Parsons, 2014',
  'IDEO — Senior Designer, 2015–2017',
  'Stripe — Brand Studio, 2017–2018',
  'AIGA Member · Brooklyn chapter',
  'Dribbble Top 100 · Selected 2024',
  'Awwwards Site of the Day × 4',
];
const credentials = credentialPool.length > 0 ? credentialPool : FALLBACK_CREDENTIALS;

const FALLBACK_JOURNEY = [
  {
    number: '2018',
    title: 'Out of agency, into independence',
    description:
      'Left a senior design role at a Brooklyn agency to take on direct client work. First six months were small marketing sites and a lot of late-night learning about pricing.',
  },
  {
    number: '2020',
    title: 'Found the SaaS niche',
    description:
      'Two early-stage fintech engagements turned into a referral chain. Stopped chasing every brief and started turning down anything that was not a real product surface.',
  },
  {
    number: '2022',
    title: 'Studio AM as a practice',
    description:
      'Renamed the practice, set rates that matched the work, capped engagements at four per quarter. The waitlist started here, and it has not been empty since.',
  },
  {
    number: '2024',
    title: 'Selected for Dribbble Top 100',
    description:
      'Recognition for a year of work that was almost entirely behind NDAs. Awwwards Site of the Day for the Marsh launch. Featured in Sidebar and Typewolf.',
  },
  {
    number: '2026',
    title: 'Sixty engagements in',
    description:
      'Roughly half product surfaces, a third brand systems, the rest custom marketing builds. The practice is small on purpose, and that is exactly the point.',
  },
];
const resolvedJourney = journey.length > 0 ? journey : FALLBACK_JOURNEY;

const FALLBACK_STATS = [
  { number: '60+', label: 'Shipped engagements' },
  { number: '8', label: 'Years independent' },
  { number: '12', label: 'Industries served' },
  { number: '92%', label: 'Repeat client rate' },
];
const labelStats = (labels.stats?.items ?? [])
  .filter((s) => s?.number && s?.label && !s.number.startsWith('['))
  .slice(0, 4)
  .map((s) => ({ number: s.number ?? '', label: s.label ?? '' }));
const stats = labelStats.length === 4 ? labelStats : FALLBACK_STATS;

const galleryItems = (gallery.items ?? [])
  .filter((i): i is GalleryItem => Boolean(i?.src))
  .map((i) => ({
    src: i.src ?? '',
    alt: i.alt ?? '',
    span: i.span,
    aspect: i.aspect,
    tag: i.tag,
  }));
---

<Layout
  title="About — Alex Morgan, Studio AM"
  description="Eight years of independent product design and development for SaaS startups. Brooklyn, NY."
  activeIndex={2}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="fp-about-hero">
      <div class="fp-about-hero__copy">
        <OverlineText text="About the studio" tone="accent" />
        <h1 class="fp-about-hero__title">
          Eight years of<br />
          deliberate, studio-led<br />
          <em>SaaS work</em>.
        </h1>
        <p class="fp-about-hero__lede">
          Studio AM is a one-person practice in Brooklyn. I take on three to
          four engagements a quarter — brand, product surface, or web — and
          ship them with the care of a small team you would otherwise have
          to hire.
        </p>
      </div>
      <div class="fp-about-hero__plate" aria-hidden="true">
        <div class="fp-about-hero__plate-image"></div>
        <span class="fp-about-hero__caption">Studio AM · 89 Bond St</span>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Quote ───────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="compact">
    <Container className="fp-about-quote">
      <QuoteBlock
        quote="I have stopped trying to be everything to everyone. The studio is small on purpose, and that is what makes the work good."
      />
    </Container>
  </SectionBlock>

  <!-- ─── Two-up imagery ──────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="The studio"
        title="A working space, not a brand asset."
        maxWidth="22ch"
      />
      <div class="fp-about-imagery">
        <div class="fp-about-imagery__plate fp-about-imagery__plate--a" aria-hidden="true"></div>
        <div class="fp-about-imagery__plate fp-about-imagery__plate--b" aria-hidden="true"></div>
      </div>
      <p class="fp-about-imagery__caption">
        Studio AM occupies a single room above a bookshop on Bond Street.
        One desk, one drawer of pens, one plant that has somehow survived
        three years.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── Stats ───────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="In numbers"
        title="Eight years, kept honest."
        align="center"
      />
      <StatsRow items={stats} />
    </Container>
  </SectionBlock>

  <!-- ─── Philosophy (dark) ───────────────────────────────── -->
  <SectionBlock id="philosophy" tone="dark" padding="default">
    <Container className="fp-about-philosophy">
      <div class="fp-about-philosophy__heading">
        <OverlineText text="The philosophy" tone="accent" />
        <h2 class="section-title fp-about-philosophy__title">
          Less work,<br />done better.
        </h2>
      </div>
      <div class="fp-about-philosophy__copy">
        <p>
          Most independent design practices try to scale by taking more
          clients. That model breaks the only thing clients pay for —
          your attention.
        </p>
        <p>
          Studio AM does the opposite. <strong>Three to four engagements
          a quarter, capped.</strong> Each one gets a real discovery
          phase, real iteration, and a written handoff that means your
          team is not back here in six months untangling something
          half-done.
        </p>
        <p>
          The price is that we never grow. The reward is that the work
          is genuinely good, and the people I work with become the
          referrals for the next year.
        </p>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Journey ─────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="fp-about-journey">
      <div class="fp-about-journey__heading">
        <OverlineText text="The journey" />
        <h2 class="section-title">From agency to studio.</h2>
      </div>
      <div class="fp-about-journey__list">
        {
          resolvedJourney.map((j) => (
            <NumberedFeatureItem
              number={j.number}
              title={j.title}
              description={j.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Credentials ─────────────────────────────────────── -->
  <SectionBlock id="credentials" tone="subtle" padding="default">
    <Container>
      <SectionHeading
        label="Credentials & affiliations"
        title="Background, in short."
        align="center"
      />
      <ul class="fp-about-credentials">
        {
          credentials.map((c) => (
            <li class="fp-about-credentials__item">
              <span class="fp-about-credentials__mark" aria-hidden="true">
                ◆
              </span>
              {c}
            </li>
          ))
        }
      </ul>
    </Container>
  </SectionBlock>

  <!-- ─── Gallery ─────────────────────────────────────────── -->
  {
    galleryItems.length > 0 && (
      <SectionBlock tone="subtle" padding="default" topBorder>
        <Container>
          <GalleryGrid
            items={galleryItems}
            eyebrow={gallery.eyebrow}
            title={gallery.title}
            sideNote={gallery.side_note}
          />
        </Container>
      </SectionBlock>
    )
  }

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="fp-about-cta">
      <h2 class="fp-about-cta__title">
        Have something<br />in <em>flight</em>?
      </h2>
      <p class="fp-about-cta__lede">
        I read every inquiry myself. Tell me what you're working on and
        what success looks like — I'll get back within two business days.
      </p>
      <ActionButton
        href="/contact"
        label="Start a project"
        variant="primary-light"
        size="large"
        className="fs-book-btn"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .fp-about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .fp-about-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .fp-about-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fp-about-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 56ch;
  }

  .fp-about-hero__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .fp-about-hero__plate-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1573497620053-ea5300f94f21?w=900&h=1100&fit=crop&crop=face');
    background-size: cover;
    background-position: center;
    filter: contrast(1.04) saturate(0.9);
  }

  .fp-about-hero__caption {
    position: absolute;
    bottom: 18px;
    left: 18px;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--bg-dark);
    background: var(--surface-base);
    padding: 6px 10px;
  }

  /* Quote */
  .fp-about-quote {
    max-width: 920px;
  }

  /* Two-up imagery */
  .fp-about-imagery {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
  }

  .fp-about-imagery__plate {
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-lg);
    filter: contrast(1.04) saturate(0.92);
  }

  .fp-about-imagery__plate--a {
    background-image: url('https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?w=1200&h=900&fit=crop');
  }

  .fp-about-imagery__plate--b {
    aspect-ratio: 3 / 4;
    background-image: url('https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=900&h=1200&fit=crop');
  }

  .fp-about-imagery__caption {
    margin-top: 24px;
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 60ch;
  }

  /* Philosophy */
  .fp-about-philosophy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 80px;
  }

  .fp-about-philosophy__heading {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .fp-about-philosophy__title {
    color: var(--text-on-dark);
    margin-top: 16px;
    max-width: 14ch;
  }

  .fp-about-philosophy__copy {
    display: grid;
    gap: 24px;
    max-width: 64ch;
  }

  .fp-about-philosophy__copy p {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--text-on-dark);
  }

  .fp-about-philosophy__copy strong {
    color: var(--brand-primary);
    font-weight: var(--fw-semibold);
  }

  /* Journey */
  .fp-about-journey {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 80px;
    align-items: start;
  }

  .fp-about-journey__heading {
    position: sticky;
    top: 100px;
  }

  .fp-about-journey__heading .section-title {
    margin-top: 16px;
    max-width: 12ch;
  }

  .fp-about-journey__list {
    border-top: 1px solid var(--surface-subtle-border);
  }

  /* Credentials */
  .fp-about-credentials {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 40px;
    max-width: 820px;
    margin: 0 auto;
  }

  .fp-about-credentials__item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 12px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .fp-about-credentials__mark {
    color: var(--brand-primary);
    font-size: 0.75em;
    line-height: 1.5;
  }

  /* CTA */
  .fp-about-cta {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .fp-about-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .fp-about-cta__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fp-about-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-nav);
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .fp-about-hero,
    .fp-about-philosophy,
    .fp-about-journey {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .fp-about-imagery {
      grid-template-columns: 1fr;
    }

    .fp-about-philosophy__heading,
    .fp-about-journey__heading {
      position: static;
    }

    .fp-about-credentials {
      grid-template-columns: 1fr;
    }
  }
</style>
