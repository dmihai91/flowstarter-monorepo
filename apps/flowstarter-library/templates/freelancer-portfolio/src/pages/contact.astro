---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ContactCard from '../../../shared/dorin-ds/components/ContactCard.astro';
import FormField from '../../../shared/dorin-ds/components/FormField.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';
import { frontmatter as siteLabels } from '../content/site-labels.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface SiteLabelsShape {
  contactPage?: {
    titleLines?: Array<{ text?: string; accent?: string }>;
    introText?: string;
    form?: {
      title?: string;
      note?: string;
      fullNameLabel?: string;
      fullNamePlaceholder?: string;
      emailLabel?: string;
      emailPlaceholder?: string;
      messageLabel?: string;
      messagePlaceholder?: string;
      submitLabel?: string;
      successMessage?: string;
    };
    details?: {
      emailLabel?: string;
      emailValue?: string;
      emailHref?: string;
      addressLabel?: string;
      addressValue?: string;
    };
  };
}

interface BookingFrontmatter {
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

const labels = siteLabels as SiteLabelsShape;
const booking = bookingData as BookingFrontmatter;

// site-labels.contactPage.form fields are wired into FormField labels
// where we can; the bespoke first/last/projectType/budget split below
// is preserved because site-labels uses a single fullName field and
// no project/budget concepts.
const form = labels.contactPage?.form ?? {};
const details = labels.contactPage?.details ?? {};

const successMessage =
  form.successMessage && !form.successMessage.startsWith('[')
    ? form.successMessage
    : "Thank you. I'll be in touch within two business days.";
---

<Layout
  title="Contact — Studio AM, Alex Morgan"
  description="Send a brief, book a working session. New projects start about two weeks out."
  activeIndex={4}
>
  <!-- ─── Cal.com booking (top of page) ──────────────────── -->
  <SectionBlock tone="subtle" padding="hero">
    <Container>
      <CalBookingBlock
        variant="inline"
        calLink={booking.cal_link}
        eventLabel={booking.cal_event_label}
        title={booking.title}
        subtitle={booking.description}
        durationLabel={booking.cal_duration_label}
        layout={booking.cal_layout}
      />
    </Container>
  </SectionBlock>

  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="fp-contact-hero">
      <OverlineText text="Start a project" tone="accent" />
      <h1 class="fp-contact-hero__title">
        Tell me what<br />
        you're <em>working on</em>.
      </h1>
      <p class="fp-contact-hero__lede">
        I read every brief myself. The more you can share — stage,
        timeline, what has already been tried — the more useful my reply
        will be. Most inquiries get a written response within two business
        days.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── Contact (form + info) ───────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="fp-contact-grid">
      <div class="fp-contact-grid__form-col">
        <h2 class="fp-contact-grid__form-title">Send a brief</h2>
        <p class="fp-contact-grid__form-lede">
          A short, written intake. Use plain prose — no need to format it
          for me. If you have a Notion doc or PDF, paste a link in the
          message field.
        </p>

        <div
          id="form-success"
          class="fp-contact-grid__alert fp-contact-grid__alert--success"
          hidden
        >
          {successMessage}
        </div>
        <div
          id="form-error"
          class="fp-contact-grid__alert fp-contact-grid__alert--error"
          hidden
        >
          Something went wrong. Please try again or email the studio
          directly.
        </div>

        <form
          id="contact-form"
          data-contact-form
          data-success-message={successMessage}
          class="fp-contact-grid__form"
        >
          <input type="hidden" name="_template" value="" />
          <input type="hidden" name="_source" value="" />

          <div class="fp-contact-grid__row">
            <FormField
              type="text"
              name="firstName"
              label="First name"
              placeholder="Your first name"
              required
            />
            <FormField
              type="text"
              name="lastName"
              label="Last name"
              placeholder="Your last name"
              required
            />
          </div>

          <FormField
            type="email"
            name="email"
            label="Email"
            placeholder="you@company.com"
            required
          />

          <div class="fp-contact-grid__row">
            <FormField
              type="text"
              name="projectType"
              label="Project type"
              placeholder="Brand, product, web, audit…"
              required
            />
            <FormField
              type="text"
              name="budget"
              label="Budget range"
              placeholder="$10k — $25k, etc."
            />
          </div>

          <FormField
            type="textarea"
            name="message"
            label="The brief"
            placeholder="What are you building, what stage are you at, and what does success look like? Links welcome."
            required
          />

          <button type="submit" class="fp-contact-grid__submit">
            Send the brief
          </button>

          <p class="fp-contact-grid__note">
            Your information stays with me. No newsletter, no list, no
            third-party tooling.
          </p>
        </form>
      </div>

      <aside class="fp-contact-grid__info-col">
        <h3 class="fp-contact-grid__info-title">Or reach out directly</h3>
        <div class="fp-contact-grid__info-cards">
          <ContactCard
            label={
              details.emailLabel && !details.emailLabel.startsWith('[')
                ? details.emailLabel
                : 'Email'
            }
            value={
              details.emailValue && !details.emailValue.startsWith('[')
                ? details.emailValue
                : 'hello@alexmorgan.studio'
            }
            href={
              details.emailHref && !details.emailHref.startsWith('mailto:[')
                ? details.emailHref
                : 'mailto:hello@alexmorgan.studio'
            }
            hint="Replies within two business days"
          />
          <ContactCard
            label="Calendar"
            value="Book a working session"
            href="/contact"
            hint="30-minute intro calls, Mon–Thu"
          />
          <ContactCard
            label={
              details.addressLabel && !details.addressLabel.startsWith('[')
                ? details.addressLabel
                : 'Studio'
            }
            value={
              details.addressValue && !details.addressValue.startsWith('[')
                ? details.addressValue
                : 'Brooklyn, NY'
            }
            hint="Studio AM, 89 Bond Street, Brooklyn, NY 11213 — visits by appointment"
          />
        </div>

        <div class="fp-contact-grid__hours">
          <span class="fp-contact-grid__hours-label">Studio hours</span>
          <ul class="fp-contact-grid__hours-list">
            <li><span>Mon — Thu</span><span>10:00 — 18:00 ET</span></li>
            <li><span>Friday</span><span>Async only</span></li>
            <li><span>Sat — Sun</span><span>Closed</span></li>
          </ul>
          <p class="fp-contact-grid__hours-note">
            New projects currently start about two weeks out.
          </p>
        </div>
      </aside>
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .fp-contact-hero {
    max-width: 880px;
  }

  .fp-contact-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .fp-contact-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fp-contact-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 60ch;
  }

  /* Grid */
  .fp-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .fp-contact-grid__form-title {
    font-size: var(--fs-h3);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--bg-dark);
    margin-bottom: 16px;
  }

  .fp-contact-grid__form-lede {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .fp-contact-grid__form {
    display: grid;
    gap: 20px;
  }

  .fp-contact-grid__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .fp-contact-grid__alert {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    margin-bottom: 24px;
  }

  .fp-contact-grid__alert[hidden] {
    display: none;
  }

  .fp-contact-grid__alert--success {
    background: var(--surface-brand-glow);
    color: var(--bg-dark);
    border: 1px solid var(--brand-primary);
  }

  .fp-contact-grid__alert--error {
    background: rgba(220, 80, 80, 0.12);
    color: #8a2a2a;
    border: 1px solid rgba(220, 80, 80, 0.32);
  }

  .fp-contact-grid__submit {
    margin-top: 8px;
    padding: 18px 32px;
    font-family: var(--font-button);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border: 1px solid var(--bg-dark);
    transition: opacity var(--transition);
  }

  .fp-contact-grid__submit:hover {
    opacity: 0.85;
  }

  .fp-contact-grid__note {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
  }

  /* Info column */
  .fp-contact-grid__info-title {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .fp-contact-grid__info-cards {
    display: grid;
    gap: 16px;
    margin-bottom: 40px;
  }

  .fp-contact-grid__hours {
    padding: 28px 24px;
    background: var(--surface-subtle);
    border-radius: var(--radius-md);
  }

  .fp-contact-grid__hours-label {
    display: block;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .fp-contact-grid__hours-list {
    display: grid;
    gap: 8px;
  }

  .fp-contact-grid__hours-list li {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 6px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .fp-contact-grid__hours-list li:last-child {
    border-bottom: none;
  }

  .fp-contact-grid__hours-note {
    margin-top: 16px;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .fp-contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 600px) {
    .fp-contact-grid__row {
      grid-template-columns: 1fr;
    }
  }
</style>
