---
import Layout from '../layouts/Layout.astro';

const nav = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Services', href: '#services' },
  { label: 'Contact', href: '#contact' },
];

const work = [
  {
    n: '01',
    name: 'Ledgerline',
    role: 'Product design, front-end',
    year: '2025',
    stack: 'React · TS · D3',
    note: 'A treasury dashboard for a Series A fintech. Reworked the cash-flow views and shipped the front-end with the founding team.',
    img: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=900&h=560&fit=crop',
  },
  {
    n: '02',
    name: 'Northwind site',
    role: 'Design, build',
    year: '2025',
    stack: 'Astro · Tailwind',
    note: 'Marketing site for a climate B2B platform. Designed and hand-built, from wireframe to deploy, in five weeks.',
    img: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=900&h=560&fit=crop',
  },
  {
    n: '03',
    name: 'Atlas DS',
    role: 'Design system',
    year: '2024',
    stack: 'Figma · React · Storybook',
    note: 'A component library and token set for a 14-person product team. Documented, versioned, and handed over with a build guide.',
    img: 'https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?w=900&h=560&fit=crop',
  },
  {
    n: '04',
    name: 'Cadence',
    role: 'Product design',
    year: '2024',
    stack: 'Figma · prototyping',
    note: 'End-to-end UX for a scheduling tool. Research, flows, and a clickable prototype the team used to close their seed round.',
    img: 'https://images.unsplash.com/photo-1517292987719-0369a794ec0f?w=900&h=560&fit=crop',
  },
  {
    n: '05',
    name: 'Harbor admin',
    role: 'Front-end',
    year: '2023',
    stack: 'Vue · Vite · CSS grid',
    note: 'Rebuilt an internal admin from a slow legacy stack. Same surface, half the bundle, and a layout the team could extend.',
    img: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=900&h=560&fit=crop',
  },
  {
    n: '06',
    name: 'Field notes',
    role: 'Design, build',
    year: '2023',
    stack: 'Next · MDX',
    note: 'A writing and docs site for an indie developer. Typographic, fast, and easy to keep updated without touching code.',
    img: 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=900&h=560&fit=crop',
  },
];

const services = [
  { k: '01', name: 'Product design', body: 'Research, flows, and interface for web apps. I work end to end and hand over files your engineers can build from.', price: 'from €4,000' },
  { k: '02', name: 'Website + build', body: 'A fast marketing site, designed and hand-coded. No page builder, no theme. Designed and shipped to your host.', price: 'from €3,200' },
  { k: '03', name: 'Design systems', body: 'Tokens, components, and docs your team can build on. Versioned in Figma and code, handed over with a guide.', price: 'from €5,500' },
  { k: '04', name: 'Fractional design', body: 'A few days a month as your embedded design partner. Good when you need consistency, not a one-off. Six-month minimum.', price: 'from €2,200 / mo' },
];

const tools = ['Figma', 'React / TS', 'Astro', 'Tailwind', 'Vite', 'Storybook'];
const principles = [
  'Ship the whole thing, not a handoff.',
  'Fewer screens, fewer states, less to maintain.',
  'Type and spacing carry most of the design.',
  'If it is slow, it is not done.',
];
---
<Layout>
  <a class="skip" href="#work">Skip to work</a>

  <!-- NAV -->
  <header class="nav">
    <a href="#top" class="brand">
      <span class="brand__mark" aria-hidden="true">DA</span>
      <span class="brand__name">Dorin Andrei</span>
    </a>
    <nav class="nav__links" aria-label="Primary">{nav.map((i) => <a href={i.href}>{i.label}</a>)}</nav>
    <div class="nav__right">
      <span class="nav__status" aria-hidden="true"><i></i>Available — Q3 2026</span>
      <button type="button" class="themer" data-themer aria-label="Toggle theme">
        <svg class="ic ic-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
        <svg class="ic ic-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <a href="#contact" class="cta cta--sm">Start a project</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__grid" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <div class="hero__inner">
        <p class="eyebrow reveal">
          <span>Product designer &amp; front-end developer</span>
          <span class="eyebrow__coord">46.77°N, 23.59°E · Remote</span>
        </p>
        <h1 class="hero__title reveal" style="--d:.06s">I design and build the whole thing.</h1>
        <p class="hero__lede reveal" style="--d:.14s">
          Independent designer and developer. I take products and marketing sites
          from a rough idea to a shipped, fast front-end, working with founders and
          small teams. No handoff gap, no theme to fight.
        </p>
        <div class="hero__cta reveal" style="--d:.2s">
          <a href="#work" class="cta">View selected work</a>
          <a href="#contact" class="ghost">Start a project →</a>
        </div>
        <div class="hero__meta reveal" style="--d:.26s">
          <div><span class="ml">Status</span><b>Available — Q3 2026</b></div>
          <div><span class="ml">Based</span><b>Cluj-Napoca</b></div>
          <div><span class="ml">Working</span><b>Worldwide</b></div>
          <div><span class="ml">Since</span><b>2017</b></div>
        </div>
      </div>
    </section>

    <!-- TICKER / SPEC STRIP -->
    <div class="strip">
      <span class="ml">Design</span><i>·</i>
      <span class="ml">Front-end</span><i>·</i>
      <span class="ml">Design systems</span><i>·</i>
      <span class="ml">Prototyping</span><i>·</i>
      <span class="ml">Performance</span><i>·</i>
      <span class="ml accent">Available for work</span>
    </div>

    <!-- WORK / CASE-STUDY INDEX -->
    <section class="section" id="work">
      <div class="head">
        <span class="ml accent">№ 01 — Selected work</span>
        <h2 class="h2">Six projects, designed and shipped.</h2>
      </div>

      <div class="table" role="table">
        <div class="table__head ml" role="row" aria-hidden="true">
          <span>№</span><span>Project</span><span>Role</span><span>Year</span><span>Stack</span><span></span>
        </div>
        {work.map((p, i) => (
          <a class="row reveal" href="#contact" style={`--d:${i * 0.04}s`} role="row">
            <span class="row__n ml" role="cell">{p.n}</span>
            <span class="row__name" role="cell">
              {p.name}
              <em class="row__note">{p.note}</em>
            </span>
            <span class="row__role ml" role="cell"><span class="kv">Role</span>{p.role}</span>
            <span class="row__year ml" role="cell"><span class="kv">Year</span>{p.year}</span>
            <span class="row__stack ml" role="cell"><span class="kv">Stack</span>{p.stack}</span>
            <span class="row__view ml" role="cell" aria-hidden="true">View →</span>
            <span class="row__thumb" aria-hidden="true"><img src={p.img} alt="" loading="lazy" /></span>
          </a>
        ))}
      </div>
    </section>

    <!-- ABOUT / HOW I WORK -->
    <section class="section about" id="about">
      <div class="about__grid">
        <div class="about__copy reveal">
          <span class="ml accent">№ 02 — How I work</span>
          <p class="about__lead">
            I am a designer who codes, which means the thing I design is the thing
            that ships. I do the research, the flows, the interface, and then I build
            the front-end myself, so nothing gets lost between a Figma file and
            production.
          </p>
          <p class="about__p">
            I work in small, honest scopes. We agree on what done looks like, I send
            real work early and often, and you get a fast, readable codebase you or
            your team can keep going without me.
          </p>
        </div>
        <div class="about__specs reveal" style="--d:.1s">
          <div class="spec">
            <span class="ml">Tools</span>
            <ul class="spec__list">{tools.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="spec">
            <span class="ml">Principles</span>
            <ul class="spec__list spec__list--full">{principles.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section services" id="services">
      <div class="head">
        <span class="ml accent">№ 03 — Engagements</span>
        <h2 class="h2">Ways we can work.</h2>
      </div>
      <ul class="svc">
        {services.map((s) => (
          <li class="svc__row reveal">
            <span class="svc__k ml">{s.k}</span>
            <span class="svc__name">{s.name}</span>
            <p class="svc__body">{s.body}</p>
            <span class="svc__price ml">{s.price}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- TESTIMONIAL / RESULT -->
    <section class="quote">
      <div class="quote__inner reveal">
        <span class="ml accent">№ 04 — Result</span>
        <blockquote>
          Dorin designed and shipped our whole product surface in two months.
          The handoff was the deploy. We have not had to redo a thing.
        </blockquote>
        <cite><b>Ioana R.</b><span class="ml">CEO, Ledgerline</span></cite>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section contact" id="contact">
      <div class="contact__grid">
        <div class="contact__left reveal">
          <span class="ml accent">№ 05 — Contact</span>
          <h2 class="contact__title">Have something to build?</h2>
          <p class="contact__lede">
            Send a couple of lines about the project and where it is now. I read
            everything and reply within a day or two.
          </p>
          <a href="mailto:hello@dorinandrei.com" class="contact__mail ml">hello@dorinandrei.com</a>
          <div class="contact__cta">
            <a href="mailto:hello@dorinandrei.com" class="cta cta--lg">Start a project</a>
            <a href="#" class="ghost">LinkedIn →</a>
          </div>
        </div>
        <div class="contact__right reveal" style="--d:.1s">
          <div class="kvrow"><span class="ml">Status</span><b><i class="dot"></i>Available — Q3 2026</b></div>
          <div class="kvrow"><span class="ml">Response</span><b>1–2 days</b></div>
          <div class="kvrow"><span class="ml">Engagements</span><b>Project · Fractional</b></div>
          <div class="kvrow"><span class="ml">Timezone</span><b>CET (UTC+2)</b></div>
          <div class="kvrow"><span class="ml">Email</span><b>hello@dorinandrei.com</b></div>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="foot__top">
      <div class="foot__brand">
        <span class="brand__mark" aria-hidden="true">DA</span>
        <div>
          <b>Dorin Andrei</b>
          <span class="ml">Product designer &amp; developer</span>
        </div>
      </div>
      <nav class="foot__nav" aria-label="Footer">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="mailto:hello@dorinandrei.com">Email</a>
        <a href="#">LinkedIn</a>
      </nav>
    </div>
    <div class="foot__base ml">
      <span>© 2026 Dorin Andrei</span>
      <span>46.77°N, 23.59°E</span>
      <span>Built from scratch</span>
    </div>
  </footer>

  <script is:inline>
    (function () { var b = document.querySelector('[data-themer]'); if (b) b.addEventListener('click', function () { var d = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', d); document.documentElement.classList.toggle('dark', d); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (_) {} }); })();
    (function () { var els = document.querySelectorAll('.reveal'); if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; } var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.1 }); els.forEach(function (e) { io.observe(e); }); })();
  </script>

  <style is:global>
    :root {
      /* DARK is the default */
      --bg: #0a0a0b; --raise: #101012; --ink: #f4f4f1; --dim: #8d8d96;
      --accent: #5a7dff; --line: rgba(244,244,241,.14); --line-2: rgba(244,244,241,.07);
      --disp: 'Space Grotesk', -apple-system, system-ui, sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
    }
    html:not(.theme-dark):not(.dark) {
      --bg: #fafafa; --raise: #ffffff; --ink: #0d0d0f; --dim: #66666e;
      --accent: #2f5bff; --line: rgba(13,13,15,.12); --line-2: rgba(13,13,15,.055);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--disp); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden; transition: background .35s, color .35s; }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    ::selection { background: var(--accent); color: #fff; }
    .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: #fff; padding: .6rem 1rem; z-index: 100; font-family: var(--mono); font-size: .75rem; }
    .skip:focus { left: 0; }

    .reveal { opacity: 0; transform: translateY(16px); transition: opacity .55s cubic-bezier(.2,.7,.2,1) var(--d,0s), transform .55s cubic-bezier(.2,.7,.2,1) var(--d,0s); }
    .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce){ .reveal{opacity:1;transform:none;transition:none} }

    /* mono micro-label */
    .ml { font-family: var(--mono); text-transform: uppercase; letter-spacing: .16em; font-size: .68rem; font-weight: 500; color: var(--dim); }
    .accent { color: var(--accent); }

    .h2 { font-family: var(--disp); font-weight: 600; font-size: clamp(1.9rem,4.2vw,3.1rem); line-height: 1.02; letter-spacing: -.02em; margin: .8rem 0 0; max-width: 16ch; }

    .cta { display: inline-flex; align-items: center; justify-content: center; font-family: var(--mono); text-transform: uppercase; letter-spacing: .1em; font-weight: 500; font-size: .72rem; background: var(--accent); color: #fff; padding: .8rem 1.3rem; border: 1px solid var(--accent); cursor: pointer; transition: filter .2s, transform .2s; }
    .cta:hover { filter: brightness(1.12); transform: translateY(-1px); }
    .cta--sm { padding: .55rem 1rem; }
    .cta--lg { padding: 1rem 1.7rem; font-size: .78rem; }
    .ghost { font-family: var(--mono); text-transform: uppercase; letter-spacing: .1em; font-weight: 500; font-size: .72rem; color: var(--ink); border-bottom: 1px solid var(--accent); padding-bottom: 2px; transition: color .2s; }
    .ghost:hover { color: var(--accent); }

    /* NAV */
    .nav { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: .85rem clamp(1rem,4vw,3rem); background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
    .brand { display: inline-flex; align-items: center; gap: .65rem; }
    .brand__mark { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--ink); font-family: var(--mono); font-weight: 600; font-size: .72rem; letter-spacing: .04em; }
    .brand__name { font-family: var(--disp); font-weight: 600; font-size: 1rem; letter-spacing: -.01em; }
    .nav__links { display: flex; gap: 1.6rem; }
    .nav__links a { font-family: var(--mono); text-transform: uppercase; letter-spacing: .14em; font-size: .68rem; color: var(--dim); transition: color .2s; }
    .nav__links a:hover { color: var(--ink); }
    .nav__right { display: flex; align-items: center; gap: 1rem; }
    .nav__status { display: inline-flex; align-items: center; gap: .45rem; font-family: var(--mono); text-transform: uppercase; letter-spacing: .12em; font-size: .64rem; color: var(--dim); }
    .nav__status i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
    .themer { width: 34px; height: 34px; border: 1px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; display: grid; place-items: center; transition: border-color .2s, color .2s; }
    .themer:hover { border-color: var(--accent); color: var(--accent); }
    .themer .ic { grid-area: 1 / 1; }
    .themer .ic-moon { display: none; }
    html.theme-dark .themer .ic-sun, html.dark .themer .ic-sun { display: none; }
    html.theme-dark .themer .ic-moon, html.dark .themer .ic-moon { display: block; }

    /* HERO */
    .hero { position: relative; border-bottom: 1px solid var(--line); overflow: hidden; }
    .hero__grid { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1320px; margin: 0 auto; pointer-events: none; }
    .hero__grid span { border-right: 1px solid var(--line-2); }
    .hero__grid span:first-child { border-left: 1px solid var(--line-2); }
    .hero__inner { position: relative; z-index: 1; max-width: 1320px; margin: 0 auto; padding: clamp(3.5rem,9vw,7rem) clamp(1.2rem,5vw,3.5rem) clamp(2.5rem,6vw,4rem); }
    .eyebrow { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; align-items: center; font-family: var(--mono); text-transform: uppercase; letter-spacing: .16em; font-size: .72rem; color: var(--accent); margin: 0 0 1.6rem; }
    .eyebrow__coord { color: var(--dim); }
    .hero__title { font-family: var(--disp); font-weight: 600; font-size: clamp(2.6rem,7.5vw,5.6rem); line-height: .98; letter-spacing: -.035em; margin: 0; max-width: 16ch; }
    .hero__lede { font-size: clamp(1rem,1.6vw,1.18rem); color: var(--dim); max-width: 56ch; margin: 1.6rem 0 2.2rem; line-height: 1.55; }
    .hero__cta { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
    .hero__meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: clamp(2.5rem,5vw,4rem); border-top: 1px solid var(--line); }
    .hero__meta > div { padding: 1.1rem 1.2rem 0 0; border-right: 1px solid var(--line); }
    .hero__meta > div:last-child { border-right: 0; }
    .hero__meta b { display: block; margin-top: .4rem; font-family: var(--disp); font-weight: 500; font-size: 1rem; letter-spacing: -.01em; }

    /* STRIP */
    .strip { display: flex; flex-wrap: wrap; align-items: center; gap: .9rem 1.2rem; padding: .9rem clamp(1.2rem,5vw,3.5rem); border-bottom: 1px solid var(--line); background: var(--raise); }
    .strip i { color: var(--dim); opacity: .5; }
    .strip .ml { font-size: .66rem; }

    /* SECTION */
    .section { max-width: 1320px; margin: 0 auto; padding: clamp(3.5rem,7vw,6.5rem) clamp(1.2rem,5vw,3.5rem); border-bottom: 1px solid var(--line); }
    .head { margin-bottom: clamp(2rem,4vw,3rem); }

    /* WORK TABLE */
    .table { border-top: 1px solid var(--ink); }
    .table__head { display: grid; grid-template-columns: 3.5rem minmax(0,1.5fr) 1.2fr .7fr 1.1fr 4.5rem; gap: 1.2rem; padding: .8rem .2rem; border-bottom: 1px solid var(--line); font-size: .62rem; }
    .row { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0,1.5fr) 1.2fr .7fr 1.1fr 4.5rem; gap: 1.2rem; align-items: start; padding: 1.5rem .2rem; border-bottom: 1px solid var(--line); transition: background .25s, color .25s, padding .25s; }
    .row:hover { background: var(--accent); color: #fff; padding-left: 1rem; padding-right: 1rem; }
    .row:hover .ml, .row:hover .row__note, .row:hover .kv { color: rgba(255,255,255,.82); }
    .row__n { padding-top: .35rem; }
    .row__name { font-family: var(--disp); font-weight: 600; font-size: 1.35rem; letter-spacing: -.02em; line-height: 1.1; }
    .row__note { display: block; font-family: var(--disp); font-weight: 400; font-style: normal; font-size: .82rem; color: var(--dim); margin-top: .5rem; letter-spacing: 0; line-height: 1.45; max-width: 42ch; }
    .row__role, .row__year, .row__stack { padding-top: .45rem; line-height: 1.5; }
    .kv { display: none; }
    .row__view { padding-top: .45rem; text-align: right; opacity: .4; transition: opacity .25s; }
    .row:hover .row__view { opacity: 1; }
    .row__thumb { position: absolute; right: 5.5rem; top: 50%; width: 188px; height: 116px; transform: translateY(-50%) scale(.96); border: 1px solid rgba(255,255,255,.45); box-shadow: 0 8px 30px rgba(0,0,0,.25); opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; overflow: hidden; z-index: 2; }
    .row__thumb img { width: 100%; height: 100%; object-fit: cover; }
    .row:hover .row__thumb { opacity: 1; transform: translateY(-50%) scale(1); }
    @media (hover: none){ .row__thumb { display: none; } }

    /* ABOUT */
    .about__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem,5vw,4.5rem); }
    .about__lead { font-family: var(--disp); font-weight: 500; font-size: clamp(1.3rem,2.4vw,1.85rem); line-height: 1.3; letter-spacing: -.02em; margin: 1.2rem 0 1.4rem; max-width: 30ch; }
    .about__p { color: var(--dim); max-width: 50ch; margin: 0; }
    .about__specs { display: flex; flex-direction: column; gap: 2rem; }
    .spec { border-top: 1px solid var(--line); padding-top: 1rem; }
    .spec__list { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: .55rem 1rem; }
    .spec__list--full { grid-template-columns: 1fr; }
    .spec__list li { font-family: var(--mono); font-size: .8rem; color: var(--ink); padding-left: 1.1rem; position: relative; line-height: 1.5; }
    .spec__list li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }

    /* SERVICES */
    .svc { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
    .svc__row { display: grid; grid-template-columns: 3.5rem minmax(0,1fr) minmax(0,1.6fr) auto; gap: 1.4rem; align-items: baseline; padding: 1.6rem .2rem; border-bottom: 1px solid var(--line); transition: padding .25s; }
    .svc__row:hover { padding-left: .8rem; }
    .svc__k { padding-top: .3rem; }
    .svc__name { font-family: var(--disp); font-weight: 600; font-size: 1.25rem; letter-spacing: -.02em; }
    .svc__body { color: var(--dim); font-size: .92rem; margin: 0; max-width: 48ch; line-height: 1.55; }
    .svc__price { font-size: .8rem; color: var(--ink); white-space: nowrap; text-align: right; }

    /* QUOTE */
    .quote { border-bottom: 1px solid var(--line); background: var(--raise); }
    .quote__inner { max-width: 1320px; margin: 0 auto; padding: clamp(3.5rem,7vw,6rem) clamp(1.2rem,5vw,3.5rem); }
    .quote blockquote { font-family: var(--disp); font-weight: 500; font-size: clamp(1.5rem,3.4vw,2.7rem); line-height: 1.22; letter-spacing: -.025em; margin: 1.2rem 0 1.8rem; max-width: 22ch; }
    .quote cite { font-style: normal; display: flex; flex-direction: column; gap: .3rem; }
    .quote cite b { font-family: var(--disp); font-weight: 600; font-size: .95rem; }

    /* CONTACT */
    .contact { border-bottom: 1px solid var(--line); }
    .contact__grid { display: grid; grid-template-columns: 1.3fr .9fr; gap: clamp(2rem,5vw,4.5rem); }
    .contact__title { font-family: var(--disp); font-weight: 600; font-size: clamp(2rem,4.5vw,3.3rem); line-height: 1.02; letter-spacing: -.03em; margin: 1rem 0 1.2rem; max-width: 14ch; }
    .contact__lede { color: var(--dim); max-width: 44ch; margin: 0 0 1.6rem; }
    .contact__mail { display: inline-block; font-size: .9rem; color: var(--accent); letter-spacing: .08em; margin-bottom: 2rem; border-bottom: 1px solid var(--line); padding-bottom: .3rem; }
    .contact__cta { display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; }
    .contact__right { border-top: 1px solid var(--ink); align-self: start; }
    .kvrow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .95rem 0; border-bottom: 1px solid var(--line); }
    .kvrow b { font-family: var(--disp); font-weight: 500; font-size: .92rem; display: inline-flex; align-items: center; gap: .5rem; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

    /* FOOTER */
    .foot { max-width: 1320px; margin: 0 auto; padding: clamp(2.5rem,5vw,4rem) clamp(1.2rem,5vw,3.5rem) 2rem; }
    .foot__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; flex-wrap: wrap; padding-bottom: 2.5rem; }
    .foot__brand { display: flex; align-items: center; gap: .75rem; }
    .foot__brand b { display: block; font-family: var(--disp); font-weight: 600; font-size: 1rem; }
    .foot__brand .ml { display: block; margin-top: .25rem; font-size: .62rem; }
    .foot__nav { display: flex; gap: 1.4rem; flex-wrap: wrap; }
    .foot__nav a { font-family: var(--mono); text-transform: uppercase; letter-spacing: .12em; font-size: .68rem; color: var(--dim); transition: color .2s; }
    .foot__nav a:hover { color: var(--ink); }
    .foot__base { display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: space-between; padding-top: 1.4rem; border-top: 1px solid var(--line); font-size: .62rem; }

    /* RESPONSIVE */
    @media (max-width: 900px){
      .nav__links, .nav__status { display: none; }
      .hero__meta { grid-template-columns: repeat(2, 1fr); }
      .hero__meta > div:nth-child(2n){ border-right: 0; }
      .hero__meta > div:nth-child(n+3){ border-top: 1px solid var(--line); }
      .about__grid, .contact__grid { grid-template-columns: 1fr; }
      .hero__grid { grid-template-columns: repeat(2, 1fr); }
      .hero__grid span:nth-child(n+3){ display: none; }
    }
    @media (max-width: 720px){
      .table { border-top: 1px solid var(--ink); }
      .table__head { display: none; }
      .row, .svc__row { grid-template-columns: 1fr; gap: .35rem; padding: 1.4rem 0; }
      .row { row-gap: .55rem; }
      .row:hover { padding-left: 0; padding-right: 0; }
      .row__n { padding-top: 0; }
      .row__role, .row__year, .row__stack { padding-top: 0; display: flex; gap: .6rem; }
      .kv { display: inline-block; min-width: 3.2rem; opacity: .65; }
      .row__view { display: none; }
      .svc__row { row-gap: .5rem; }
      .svc__price { text-align: left; }
      .spec__list { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
