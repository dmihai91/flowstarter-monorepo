---
import Layout from '../layouts/Layout.astro';
import '../../../shared/editorial.css';

const nav = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#studio' },
  { label: 'Services', href: '#fees' },
  { label: 'Contact', href: '#contact' },
];
const stats = [
  { n: '8 yrs', l: 'Designing & shipping' },
  { n: '40+', l: 'Projects launched' },
  { n: 'Remote', l: 'Worldwide' },
];
const work = [
  { src: 'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=1400&h=1750&fit=crop', alt: 'A product interface on screen', tag: 'Product', place: 'Fintech dashboard', span: 'tall' },
  { src: 'https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?w=1400&h=1050&fit=crop', alt: 'Design work on a laptop', tag: 'Web', place: 'Marketing site', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=1200&h=1500&fit=crop', alt: 'A design system in progress', tag: 'Systems', place: 'Component library', span: 'reg' },
  { src: 'https://images.unsplash.com/photo-1593720213428-28a5b9e94613?w=1400&h=1050&fit=crop', alt: 'Code and interface side by side', tag: 'Build', place: 'Design → shipped', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1486718448742-163732cd1544?w=1200&h=1500&fit=crop', alt: 'A considered workspace', tag: 'Brand', place: 'Identity & web', span: 'tall' },
];
const offerings = [
  { k: '01', name: 'Product design', body: 'End-to-end UX and UI for web apps — research, flows, interface, the lot.', price: 'from €4,000' },
  { k: '02', name: 'Website + build', body: 'A fast, hand-built marketing site. Designed and shipped, not templated.', price: 'from €3,200' },
  { k: '03', name: 'Design systems', body: 'A component library your team can actually build on, documented and handed over.', price: 'from €5,500' },
  { k: '04', name: 'Fractional design', body: 'A few days a month as your embedded design partner. Six-month minimum.', price: 'from €2,200 / mo' },
];
---
<Layout>
  <div class="grain" aria-hidden="true"></div>
  <header class="nav">
    <a href="#top" class="brand"><span class="brand__mark" aria-hidden="true"></span>Dorin&nbsp;Andrei</a>
    <nav class="nav__links" aria-label="Primary">{nav.map((i) => <a href={i.href}>{i.label}</a>)}</nav>
    <div class="nav__right">
      <button type="button" class="themer" data-themer aria-label="Toggle dark mode"><span class="themer__dot"></span></button>
      <a href="#contact" class="btn btn--sm">Start a project</a>
    </div>
  </header>
  <main id="top">
    <section class="hero">
      <div class="hero__copy reveal">
        <p class="eyebrow">Product designer &amp; developer — remote</p>
        <h1 class="display">Work that<br />does the<br /><em>talking.</em></h1>
        <p class="lede">I'm Dorin Andrei. I design and build products and portfolios from scratch — case studies are the page, everything else gets out of the way. Fast, lightweight, and made to age well.</p>
        <div class="hero__cta">
          <a href="#contact" class="btn">Start a project</a>
          <a href="#work" class="link-arrow">See the work →</a>
        </div>
        <dl class="stats">{stats.map((s) => (<div><dt>{s.n}</dt><dd>{s.l}</dd></div>))}</dl>
      </div>
      <figure class="hero__plate reveal" style="--d:.15s">
        <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=1100&h=1450&fit=crop" alt="A considered design workspace" loading="eager" />
        <figcaption><span>№ 01</span> Design that earns its keep</figcaption>
      </figure>
    </section>
    <div class="strip" aria-hidden="true"><div class="strip__row">
      <span>Product design</span><span class="dot">✦</span><span>Web</span><span class="dot">✦</span><span>Design systems</span><span class="dot">✦</span><span>Front-end</span><span class="dot">✦</span><span>Case studies</span><span class="dot">✦</span>
      <span>Product design</span><span class="dot">✦</span><span>Web</span><span class="dot">✦</span><span>Design systems</span><span class="dot">✦</span><span>Front-end</span><span class="dot">✦</span><span>Case studies</span><span class="dot">✦</span>
    </div></div>
    <section class="section" id="work">
      <div class="section__head"><p class="eyebrow">Selected work</p><h2 class="h2">Case studies do the talking.</h2></div>
      <div class="gallery">{work.map((w, i) => (
        <figure class={`gal gal--${w.span} reveal`} style={`--d:${i * 0.06}s`}><img src={w.src} alt={w.alt} loading="lazy" /><figcaption><span class="gal__tag">{w.tag}</span><span class="gal__place">{w.place}</span></figcaption></figure>
      ))}</div>
    </section>
    <section class="section studio" id="studio">
      <figure class="studio__img reveal"><img src="https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=1000&h=1250&fit=crop" alt="Dorin Andrei at work" loading="lazy" /></figure>
      <div class="studio__copy reveal" style="--d:.1s">
        <p class="eyebrow">How I work</p>
        <h2 class="h2">Hand-built.<br />No template feel.</h2>
        <p>I design and write the code myself, so there's no handoff gap and nothing gets lost in translation. Fast, lightweight pages with hand-written CSS — no utility-class soup, no bloated builders, nothing that looks like everyone else.</p>
        <p>Projects start with the work itself: what should the visitor understand, feel, and remember? Everything else — type, layout, motion — serves that. The result reads as considered, because it is.</p>
        <p class="sig">— Dorin</p>
      </div>
    </section>
    <section class="section" id="fees">
      <div class="section__head"><p class="eyebrow">Services</p><h2 class="h2">Ways to work together.</h2></div>
      <ul class="offer">{offerings.map((o) => (
        <li class="offer__row reveal"><span class="offer__k">{o.k}</span><span class="offer__name">{o.name}</span><span class="offer__body">{o.body}</span><span class="offer__price">{o.price}</span></li>
      ))}</ul>
      <p class="offer__note">Every project opens with a short call and a written proposal. Fixed scope, fixed price, no surprises.</p>
    </section>
    <section class="quote reveal">
      <blockquote>“Dorin shipped a site that actually looks like us — fast, sharp, and nothing like the template everyone else is using. Investors noticed.”</blockquote>
      <cite>Priya Sharma — founder, Lumina</cite>
    </section>
    <section class="cta" id="contact">
      <p class="eyebrow eyebrow--accent">Taking projects for next quarter</p>
      <h2 class="display cta__title">Let's build<br />something&nbsp;real.</h2>
      <p class="cta__lede">Tell me about the project — what it's for, who it's for, and roughly when. I'll come back with fit, scope, and a fixed quote.</p>
      <div class="cta__actions"><a href="mailto:hello@dorinandrei.com" class="btn btn--lg">Start a project</a><a href="https://github.com/DorinAndrei007" class="link-arrow">GitHub →</a></div>
    </section>
  </main>
  <footer class="foot">
    <div class="foot__top">
      <div class="foot__brand">Dorin Andrei</div>
      <div class="foot__cols">
        <div><h4>Work</h4><a href="#fees">Product design</a><a href="#fees">Web &amp; build</a><a href="#fees">Design systems</a></div>
        <div><h4>About</h4><a href="#studio">How I work</a><a href="#work">Case studies</a><a href="#contact">Contact</a></div>
        <div><h4>Elsewhere</h4><a href="#">GitHub</a><a href="#">LinkedIn</a><a href="mailto:hello@dorinandrei.com">Email</a></div>
      </div>
    </div>
    <div class="foot__base"><span>© 2026 Dorin Andrei</span><span>Remote · Working worldwide</span></div>
  </footer>
  <script is:inline>
    (function () { var btn = document.querySelector('[data-themer]'); if (btn) btn.addEventListener('click', function () { var dark = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', dark); document.documentElement.classList.toggle('dark', dark); try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (_) {} }); })();
    (function () { var els = document.querySelectorAll('.reveal'); if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; } var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.12 }); els.forEach(function (e) { io.observe(e); }); })();
  </script>
  <style is:global>
    :root { --bg:#eef0f4; --bg-2:#e3e7ee; --surface:#f8f9fc; --ink:#14161c; --ink-soft:#3c414e; --muted:#737a8a; --accent:#2f5bff; --accent-2:#5a7dff; --line:rgba(20,22,28,.13); --line-soft:rgba(20,22,28,.07); --shadow:0 30px 70px -30px rgba(20,22,28,.42); --grain:.035; }
    html.theme-dark, html.dark { --bg:#0b0d13; --bg-2:#11141d; --surface:#13161f; --ink:#eef0f6; --ink-soft:#cbd0dd; --muted:#878ea0; --accent:#6d8bff; --accent-2:#90a6ff; --line:rgba(238,240,246,.15); --line-soft:rgba(238,240,246,.08); --shadow:0 30px 80px -30px rgba(0,0,0,.7); --grain:.06; }
  </style>
</Layout>
