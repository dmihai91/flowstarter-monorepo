---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import PricingCard from '../../../shared/dorin-ds/components/PricingCard.astro';
import FaqAccordionItem from '../../../shared/dorin-ds/components/FaqAccordionItem.astro';
import ProcessStep from '../../../shared/dorin-ds/components/ProcessStep.astro';
import { frontmatter as siteLabels } from '../content/site-labels.md';

interface SiteLabelsShape {
  services?: { items?: Array<{ title?: string; description?: string }> };
  expertise?: {
    items?: Array<{ number?: string; title?: string; description?: string }>;
  };
  servicesPage?: {
    faq?: { items?: Array<{ question?: string; answer?: string }> };
  };
}

const labels = siteLabels as SiteLabelsShape;

const FALLBACK_SERVICES = [
  {
    number: '01',
    title: 'Brand strategy',
    description:
      'Positioning, narrative, and identity for early-stage SaaS. Naming, voice, visual system, and a working brand book — handed off so your next hire can extend the system, not relearn it.',
  },
  {
    number: '02',
    title: 'Product design',
    description:
      'Discovery, IA, flows, components, and shipped UI for SaaS products. Paired with a Figma library that maps cleanly to your codebase, and a written rationale for every decision.',
  },
  {
    number: '03',
    title: 'Web development',
    description:
      'Astro, Next.js, and Tailwind builds for marketing sites, docs portals, and product surfaces. Editable, performant, accessible — and yours to own after handoff, with no agency lock-in.',
  },
  {
    number: '04',
    title: 'Design systems',
    description:
      'Token systems, component libraries, and the documentation around them. For teams that have shipped enough to know their UI is drifting and want to fix it once, properly.',
  },
  {
    number: '05',
    title: 'Workshops',
    description:
      'Two- to three-day on-site or remote workshops for product teams. Brand sprints, design audits, accessibility reviews, or roadmap calibration. Outputs are written, not slides.',
  },
  {
    number: '06',
    title: 'Consulting',
    description:
      'Hourly advisory for founders making early hiring or build-versus-buy decisions about design and front-end. No deliverables, just sharp answers and a thinking partner.',
  },
];

const labelServices = (labels.services?.items ?? [])
  .filter((s) => s?.title && !s.title.startsWith('['))
  .map((s, i) => ({
    number: `0${i + 1}`,
    title: s?.title ?? '',
    description: s?.description ?? '',
  }));
const services = labelServices.length > 0 ? labelServices : FALLBACK_SERVICES;

// Pricing is intentionally hand-curated — site-labels.md does not yet
// define a pricing schema, and the dedicated /pricing page is the
// canonical source for plan data.
const pricing = [
  {
    name: 'Audit',
    price: '$1,500',
    cadence: 'fixed-fee',
    description:
      'A one-week written diagnosis of your product, brand, or marketing surface — for teams who want a senior outside eye before scoping a sprint.',
    features: [
      'One-week turnaround',
      'Written report (10–15 pages)',
      '90-minute walkthrough call',
      'Prioritized fix list',
    ],
    ctaLabel: 'Book an audit',
    ctaHref: '/contact',
  },
  {
    name: 'Sprint',
    price: '$7,500',
    cadence: 'four to six weeks',
    description:
      'The default engagement. One scope, one outcome, fixed fee. Most clients return for a second sprint within the same quarter.',
    features: [
      'Discovery & alignment week',
      'Paired design & build',
      'Weekly written check-ins',
      'Figma library handoff',
      'Two weeks of post-launch support',
    ],
    ctaLabel: 'Book a sprint',
    ctaHref: '/contact',
    featured: true,
  },
  {
    name: 'Retained',
    price: '$12k',
    cadence: 'per month',
    description:
      'For teams who want senior design and front-end on tap. Available after one completed sprint, capped to one retained client at a time.',
    features: [
      'Up to 60 hours per month',
      'Standing weekly working session',
      'Async Slack / Loom support',
      'Quarterly written roadmap',
      'Priority on rolling scopes',
    ],
    ctaLabel: 'Book a working session',
    ctaHref: '/contact',
  },
];

const FALLBACK_PROCESS = [
  {
    step: 'Step 1',
    title: 'Intro call',
    description:
      '30 minutes, free, no slide deck. Tell me the problem, the team, and the timeline. If we are a fit, you leave the call with a written recap and a proposal date.',
  },
  {
    step: 'Step 2',
    title: 'Scoped proposal',
    description:
      'Within two business days, a fixed-fee proposal with a clear scope, weekly milestones, and named outcomes. No options pricing, no padding.',
  },
  {
    step: 'Step 3',
    title: 'Working sprint',
    description:
      'Four to six weeks of paired design and build. Weekly written updates, mid-sprint review, and a clear last-mile process so launch is not a panic.',
  },
  {
    step: 'Step 4',
    title: 'Handoff & follow-up',
    description:
      'A written playbook, a recorded walkthrough, and two weeks of post-launch support. Most clients book a follow-up sprint here without me asking.',
  },
];

const labelProcess = (labels.expertise?.items ?? [])
  .filter((s) => s?.title && !s.title.startsWith('['))
  .slice(0, 4)
  .map((s) => ({
    step: `Step ${s?.number ?? ''}`.trim(),
    title: s?.title ?? '',
    description: s?.description ?? '',
  }));
const process = labelProcess.length === 4 ? labelProcess : FALLBACK_PROCESS;

const FALLBACK_FAQS = [
  {
    question: 'How quickly can you start?',
    answer:
      'Most engagements start within two to four weeks of the intro call. There is usually a small bench of dates that flex around active sprints. For audits and consulting, lead time is shorter — often a week.',
  },
  {
    question: 'Do you sign NDAs?',
    answer:
      'Yes, on request, before the intro call. About half of the work the studio ships is behind one. The case studies you see public are the ones clients have explicitly cleared.',
  },
  {
    question: 'Do you take equity?',
    answer:
      'Rarely. Cash is honest, equity is not, and the practice is small enough that I do not need to gamble. Two exceptions in eight years, both to founders I had already worked with.',
  },
  {
    question: 'What is your stack?',
    answer:
      'Figma for design, Astro and Next.js for the front end, Tailwind for utility CSS, and increasingly hand-authored CSS for editorial work. Backends are your team — I integrate with whatever you ship.',
  },
  {
    question: 'Do you work outside SaaS?',
    answer:
      'Occasionally. I take on the odd editorial or arts brief because it keeps the practice honest. If it is a product surface, I will probably take it. If it is a wedding site, gently no.',
  },
];

const labelFaqs = (labels.servicesPage?.faq?.items ?? [])
  .filter((f) => f?.question && !f.question.startsWith('['))
  .map((f) => ({ question: f?.question ?? '', answer: f?.answer ?? '' }));
const faqs = labelFaqs.length > 0 ? labelFaqs : FALLBACK_FAQS;
---

<Layout
  title="Services — Studio AM, Alex Morgan"
  description="Brand strategy, product design, web development, design systems, workshops, and consulting for SaaS startups."
  activeIndex={1}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="fp-services-hero">
      <OverlineText text="Services" tone="accent" />
      <h1 class="fp-services-hero__title">
        Six ways to work<br />
        with the <em>studio</em>.
      </h1>
      <p class="fp-services-hero__lede">
        Most engagements are sprints. A few are retained. The other
        offerings exist for the moments where a sprint is not the right
        shape — when a written audit, a workshop, or an hour on a call
        is what actually moves the work forward.
      </p>
      <div class="fp-services-hero__actions">
        <ActionButton
          href="/contact"
          label="Start a project"
          variant="primary"
          size="large"
        />
        <ActionButton
          href="#pricing"
          label="See pricing"
          variant="outline-dark"
          size="large"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Services list ────────────────────────────────────── -->
  <SectionBlock id="services" tone="light" padding="default" topBorder>
    <Container className="fp-services-list">
      <div class="fp-services-list__heading">
        <OverlineText text="The offerings" />
        <h2 class="section-title">Six services, one studio.</h2>
      </div>
      <div class="fp-services-list__items">
        {
          services.map((s) => (
            <NumberedFeatureItem
              number={s.number}
              title={s.title}
              description={s.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Process ─────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default">
    <Container>
      <SectionHeading
        label="The process"
        title="Four steps from intro to handoff."
        maxWidth="22ch"
      />
      <div class="fp-services-process">
        {
          process.map((s) => (
            <ProcessStep
              step={s.step}
              title={s.title}
              description={s.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Pricing ─────────────────────────────────────────── -->
  <SectionBlock id="pricing" tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="Pricing"
        title="Fixed fees, named outcomes."
        align="center"
        maxWidth="22ch"
      />
      <div class="fp-services-pricing">
        {pricing.map((p) => <PricingCard {...p} />)}
      </div>
      <p class="fp-services-pricing-note">
        All engagements are fixed-fee. Custom scopes, multi-sprint
        commitments, and equity discussions are available on request.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── FAQ ─────────────────────────────────────────────── -->
  <SectionBlock id="faq" tone="subtle" padding="default">
    <Container className="fp-services-faq">
      <SectionHeading label="FAQ" title="Practical answers." />
      <div class="fp-services-faq__list">
        {faqs.map((f) => <FaqAccordionItem question={f.question} answer={f.answer} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="fp-services-cta">
      <h2 class="fp-services-cta__title">
        Not sure which fits<br />the <em>moment</em>?
      </h2>
      <p class="fp-services-cta__lede">
        Tell me the rough shape and I'll point you to the engagement
        that actually fits — even if it is the audit instead of the
        sprint.
      </p>
      <ActionButton
        href="/contact"
        label="Book a working session"
        variant="primary-light"
        size="large"
        className="fs-book-btn"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  .fp-services-hero {
    max-width: 880px;
  }

  .fp-services-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .fp-services-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fp-services-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 60ch;
    margin-bottom: 36px;
  }

  .fp-services-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Services list */
  .fp-services-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 80px;
    align-items: start;
  }

  .fp-services-list__heading {
    position: sticky;
    top: 100px;
  }

  .fp-services-list__heading .section-title {
    margin-top: 16px;
    max-width: 14ch;
  }

  .fp-services-list__items {
    border-top: 1px solid var(--surface-subtle-border);
  }

  /* Process */
  .fp-services-process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  /* Pricing */
  .fp-services-pricing {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .fp-services-pricing-note {
    margin-top: 40px;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* FAQ */
  .fp-services-faq {
    max-width: 920px;
  }

  .fp-services-faq__list {
    display: grid;
    gap: 12px;
  }

  /* CTA */
  .fp-services-cta {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .fp-services-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .fp-services-cta__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fp-services-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-nav);
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .fp-services-list {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .fp-services-list__heading {
      position: static;
    }

    .fp-services-process {
      grid-template-columns: repeat(2, 1fr);
    }

    .fp-services-pricing {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .fp-services-process {
      grid-template-columns: 1fr;
    }
  }
</style>
