---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import CaseStudyCard from '../../../shared/dorin-ds/components/CaseStudyCard.astro';
import TagPill from '../../../shared/dorin-ds/components/TagPill.astro';
import { frontmatter as siteLabels } from '../content/site-labels.md';

interface SiteLabelsShape {
  caseStudies?: {
    projects?: Array<{
      title?: string;
      category?: string;
      description?: string;
      imageSrc?: string;
    }>;
  };
}

const labels = siteLabels as SiteLabelsShape;

const FALLBACK_WORK = [
  {
    title: 'Layered',
    category: 'Fintech · Brand & product surface · 2025',
    imageSrc:
      'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=900&h=780&fit=crop',
    index: '№ 01',
  },
  {
    title: 'Marsh',
    category: 'Climate · B2B platform · 2025',
    imageSrc:
      'https://images.unsplash.com/photo-1497436072909-60f360e1d4b1?w=900&h=780&fit=crop',
    index: '№ 02',
  },
  {
    title: 'Quorum',
    category: 'B2B SaaS · Design system · 2024',
    imageSrc:
      'https://images.unsplash.com/photo-1551434678-e076c223a692?w=900&h=780&fit=crop',
    index: '№ 03',
  },
  {
    title: 'Field Notes',
    category: 'Editorial · Web · 2024',
    imageSrc:
      'https://images.unsplash.com/photo-1517292987719-0369a794ec0f?w=900&h=780&fit=crop',
    index: '№ 04',
  },
  {
    title: 'Northwind',
    category: 'Fintech · Marketing site · 2024',
    imageSrc:
      'https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=900&h=780&fit=crop',
    index: '№ 05',
  },
  {
    title: 'Foreland',
    category: 'Climate · Brand & web · 2023',
    imageSrc:
      'https://images.unsplash.com/photo-1511497584788-876760111969?w=900&h=780&fit=crop',
    index: '№ 06',
  },
  {
    title: 'Mantis',
    category: 'Design tools · Product · 2023',
    imageSrc:
      'https://images.unsplash.com/photo-1559028012-481c04fa702d?w=900&h=780&fit=crop',
    index: '№ 07',
  },
  {
    title: 'Slate Atlas',
    category: 'B2B SaaS · Brand refresh · 2023',
    imageSrc:
      'https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=900&h=780&fit=crop',
    index: '№ 08',
  },
];

const labelWork = (labels.caseStudies?.projects ?? [])
  .filter((p) => p?.title && p?.imageSrc)
  .map((p, i) => ({
    title: p?.title ?? '',
    category: p?.category ?? '',
    imageSrc: p?.imageSrc ?? '',
    index: `№ 0${i + 1}`,
  }));
const work = labelWork.length > 0 ? labelWork : FALLBACK_WORK;
---

<Layout
  title="Work — Studio AM, Alex Morgan"
  description="Selected case studies across fintech, climate, B2B SaaS, and design tools. Brooklyn, NY."
  activeIndex={0}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="fp-work-hero">
      <OverlineText text="Selected work · 2023 — 2026" tone="accent" />
      <h1 class="fp-work-hero__title">
        Eight engagements,<br />
        <em>publicly visible</em>.
      </h1>
      <p class="fp-work-hero__lede">
        About half of the studio's work ships behind an NDA. These are the
        eight engagements I am free to show — fintech, climate, B2B SaaS,
        design tools, and the occasional editorial brief.
      </p>
      <div class="fp-work-hero__pills">
        <TagPill label="Fintech" tone="dark" />
        <TagPill label="Climate" />
        <TagPill label="B2B SaaS" />
        <TagPill label="Design tools" />
        <TagPill label="Editorial" />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Work grid ───────────────────────────────────────── -->
  <SectionBlock id="archive" tone="light" padding="default" topBorder>
    <Container>
      <div class="fp-work-grid">
        {
          work.map((w) => (
            <CaseStudyCard
              title={w.title}
              category={w.category}
              imageSrc={w.imageSrc}
              index={w.index}
              href="#"
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Currently scoping ─────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default" topBorder>
    <Container className="fp-work-scoping">
      <div class="fp-work-scoping__inner">
        <OverlineText text="Currently scoping" tone="accent" />
        <h2 class="fp-work-scoping__title">
          Two engagements opening in <em>Q3</em>.
        </h2>
        <p class="fp-work-scoping__copy">
          The studio caps at four engagements a quarter. As of the most
          recent newsletter, two slots are open in Q3 — typically a sprint
          and either an audit or a workshop. If you have a real shape in
          mind, this is the moment to send it.
        </p>
        <div class="fp-work-scoping__actions">
          <ActionButton
            href="/contact"
            label="Start a project"
            variant="primary"
            size="large"
          />
          <ActionButton
            href="/services#pricing"
            label="See pricing"
            variant="outline-dark"
            size="large"
          />
        </div>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="fp-work-cta">
      <h2 class="fp-work-cta__title">
        Want a private<br />walkthrough?
      </h2>
      <p class="fp-work-cta__lede">
        Several of the NDA case studies can be shown live on a call. Tell
        me what stage you are at and I'll prepare the most relevant ones.
      </p>
      <ActionButton
        href="/contact"
        label="Book a working session"
        variant="primary-light"
        size="large"
        className="fs-book-btn"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  /* Hero */
  .fp-work-hero {
    max-width: 880px;
  }

  .fp-work-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .fp-work-hero__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fp-work-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    max-width: 60ch;
    margin-bottom: 32px;
  }

  .fp-work-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Grid */
  .fp-work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 32px;
  }

  /* Currently scoping */
  .fp-work-scoping {
    display: flex;
    justify-content: center;
  }

  .fp-work-scoping__inner {
    max-width: 760px;
  }

  .fp-work-scoping__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--bg-dark);
    margin: 16px 0 24px;
  }

  .fp-work-scoping__title em {
    font-style: italic;
    font-family: 'Georgia', serif;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .fp-work-scoping__copy {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-primary);
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .fp-work-scoping__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* CTA */
  .fp-work-cta {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .fp-work-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .fp-work-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-nav);
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .fp-work-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 24px;
    }
  }

  @media (max-width: 600px) {
    .fp-work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
