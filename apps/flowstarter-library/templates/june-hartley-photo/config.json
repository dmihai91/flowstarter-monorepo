{
  "name": "June Hartley Photography",
  "slug": "june-hartley-photo",
  "description": "Editorial portfolio template for wedding and portrait photographers. Warm ivory palette, Fraunces serif, full-bleed galleries, collections pricing, and an inquiry flow built for booking dates.",
  "category": "photography",
  "tags": [
    "photographer",
    "wedding",
    "elopement",
    "portrait",
    "creative",
    "portfolio",
    "gallery",
    "studio"
  ],
  "framework": "astro",
  "features": [
    "Multi-page",
    "Gallery grid",
    "Collections pricing",
    "Booking integration",
    "Contact form",
    "Testimonials",
    "FAQ",
    "Dark mode"
  ],
  "integrations": {
    "booking": {
      "name": "Booking System",
      "description": "Connect Calendly or Cal.com to let couples book an intro call",
      "providers": [
        {
          "id": "calendly",
          "name": "Calendly",
          "field": "calendly_url",
          "placeholder": "https://calendly.com/your-studio/intro-call"
        },
        {
          "id": "calcom",
          "name": "Cal.com",
          "field": "calcom_url",
          "placeholder": "https://cal.com/your-studio/intro-call"
        }
      ],
      "optional": true,
      "configPath": "content/integrations/booking.md"
    },
    "newsletter": {
      "name": "Newsletter",
      "description": "Connect Mailchimp to share recent galleries and seasonal availability",
      "providers": [
        {
          "id": "mailchimp",
          "name": "Mailchimp",
          "field": "mailchimp_url",
          "placeholder": "https://xxx.us1.list-manage.com/subscribe/post?u=xxx&id=xxx"
        },
        {
          "id": "convertkit",
          "name": "ConvertKit",
          "field": "convertkit_form_id",
          "placeholder": "1234567"
        },
        {
          "id": "buttondown",
          "name": "Buttondown",
          "field": "buttondown_username",
          "placeholder": "your-username"
        }
      ],
      "optional": true,
      "configPath": "content/integrations/newsletter.md"
    }
  },
  "fonts": [
    {
      "id": "font-1",
      "name": "Editorial",
      "heading": "Fraunces",
      "body": "Source Sans 3",
      "googleFonts": "Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Source+Sans+3:wght@400;500;600"
    },
    {
      "id": "font-2",
      "name": "Serene",
      "heading": "Cormorant Garamond",
      "body": "Inter",
      "googleFonts": "Cormorant+Garamond:wght@300;400;600&family=Inter:wght@400;500"
    },
    {
      "id": "font-3",
      "name": "Classic",
      "heading": "Playfair Display",
      "body": "Source Sans 3",
      "googleFonts": "Playfair+Display:wght@700&family=Source+Sans+3:wght@400;600"
    },
    {
      "id": "font-4",
      "name": "Modern",
      "heading": "Outfit",
      "body": "Inter",
      "googleFonts": "Outfit:wght@500;600;700&family=Inter:wght@400;500"
    }
  ]
}
