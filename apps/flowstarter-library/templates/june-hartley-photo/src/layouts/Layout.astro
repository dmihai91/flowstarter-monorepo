---
import DSHead from '../../../shared/dorin-ds/components/DSHead.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'June Hartley Photography — Weddings & Portraits in Portland',
  description = 'Documentary wedding, elopement, and portrait photography in Portland and across the Pacific Northwest. Warm, unhurried, shot for the moments you actually want to keep.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <DSHead title={title} description={description} fontPair="playfair-manrope" />
    <script is:inline>
      // Apply stored / system theme before paint to avoid a flash.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t || t === 'system') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          }
          document.documentElement.classList.toggle('theme-dark', t === 'dark');
          document.documentElement.classList.toggle('dark', t === 'dark');
        } catch (_) {}
      })();
    </script>
    <script is:inline>
      // Flowstarter preview iframe bridge — sync theme with the platform.
      (function () {
        if (window.self === window.top) return;
        var root = document.documentElement;
        root.classList.add('fs-preview');
        try {
          window.parent.postMessage(
            { source: 'fs-template', type: 'ready' },
            '*',
          );
        } catch (_) {}
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.source !== 'fs-preview') return;
          var d = e.data;
          if (d.type === 'setTheme') {
            var dark = d.value === 'dark';
            root.classList.toggle('theme-dark', dark);
            root.classList.toggle('dark', dark);
            try {
              localStorage.setItem('theme', d.value);
            } catch (_) {}
          }
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
