---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import StatsRow from '../../../shared/dorin-ds/components/StatsRow.astro';
import QuoteBlock from '../../../shared/dorin-ds/components/QuoteBlock.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import GalleryGrid from '../../../shared/dorin-ds/components/GalleryGrid.astro';
import { frontmatter as galleryData } from '../../content/gallery.md';

interface GalleryContent {
  eyebrow?: string;
  title?: string;
  side_note?: string;
  items?: Array<{
    src: string;
    alt: string;
    span?: string;
    aspect?: string;
    tag?: string;
    caption?: string;
    href?: string;
  }>;
}

const galleryFm = galleryData as GalleryContent;
const galleryItems = galleryFm.items ?? [];

const journey = [
  {
    number: '2017',
    title: 'A friend asked me to shoot her wedding',
    description:
      'I said yes before I really knew what I was doing. It turned out I loved the parts most people dread, the quiet in-between moments, and I have been chasing those ever since.',
  },
  {
    number: '2019',
    title: 'First full season',
    description:
      'A dozen weddings around Oregon while still working a day job. That year taught me how to read a room, stay calm when the timeline slips, and shoot fast without making it feel rushed.',
  },
  {
    number: '2022',
    title: 'Full-time, studio in Portland',
    description:
      'Left the day job and opened a small studio in southeast Portland. I kept the calendar deliberately limited so every couple gets my full attention rather than an assembly line.',
  },
  {
    number: 'Today',
    title: 'A smaller, steadier practice',
    description:
      'Around twenty weddings a year plus portraits and the occasional brand shoot, across the Pacific Northwest and wherever else the day takes me. Same approach as day one: stay out of the way and catch the real thing.',
  },
];

const credentials = [
  '8+ years photographing weddings',
  'Two pro camera bodies, same-day backups',
  'Second shooter available for larger days',
  'Fully insured',
  'Print release on every gallery',
  'Albums and fine prints designed in-house',
];

const stats = [
  { number: '180+', label: 'Weddings photographed' },
  { number: '8 yrs', label: 'Behind the camera' },
  { number: 'PNW', label: 'Based in Portland' },
  { number: '4.9', label: 'Average review' },
];
---

<Layout
  title="About — June Hartley Photography"
  description="A small wedding and portrait photography studio in Portland, Oregon. Documentary, unhurried, available across the Pacific Northwest."
  activeIndex={1}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="tc-about-hero">
      <div class="tc-about-hero__copy">
        <OverlineText text="About" tone="accent" />
        <h1 class="tc-about-hero__title">
          Eight years of<br />
          chasing the<br />
          <em>real moments</em>.
        </h1>
        <p class="tc-about-hero__lede">
          I'm June Hartley, a wedding and portrait photographer in Portland.
          The studio is small on purpose, so every couple gets the same
          unhurried attention rather than a number on a calendar.
        </p>
      </div>
      <div class="tc-about-hero__plate" aria-hidden="true">
        <div class="tc-about-hero__plate-image"></div>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Quote ───────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="compact">
    <Container className="tc-about-quote">
      <QuoteBlock
        quote="I am not there to direct your day. I am there to pay attention to it, so that years from now you remember how it actually felt."
      />
    </Container>
  </SectionBlock>

  <!-- ─── Stats ───────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="The studio in numbers"
        title="Eight years, quietly."
        align="center"
      />
      <StatsRow items={stats} />
    </Container>
  </SectionBlock>

  <!-- ─── Approach ────────────────────────────────────────── -->
  <SectionBlock id="approach" tone="dark" padding="default">
    <Container className="tc-about-approach">
      <div class="tc-about-approach__heading">
        <OverlineText text="The approach" tone="accent" />
        <h2 class="section-title tc-about-approach__title">
          What a day with me<br />actually feels like.
        </h2>
      </div>
      <div class="tc-about-approach__copy">
        <p>
          I show up early, find the light, and then mostly disappear. The
          best frames happen when nobody is performing, so I keep my
          distance and let the day unfold the way you planned it.
        </p>
        <p>
          When portraits roll around I'll step in with <strong>gentle
          direction</strong>, just enough so nobody is stranded wondering
          what to do, never so much that it looks staged.
          <strong>Documentary coverage</strong> for everything else, and a
          <strong>second shooter</strong> when the day is big enough to need
          two sets of eyes.
        </p>
        <p>
          You'll get a few favourites within 48 hours and the full gallery
          within a month, every image yours to print. Photographs should
          feel like the day, not like a catalogue, and that's the bar I
          hold myself to.
        </p>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Journey ─────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="tc-about-journey">
      <div class="tc-about-journey__heading">
        <OverlineText text="How I got here" />
        <h2 class="section-title">A slow, happy accident.</h2>
      </div>
      <div class="tc-about-journey__list">
        {
          journey.map((j) => (
            <NumberedFeatureItem
              number={j.number}
              title={j.title}
              description={j.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── What you can count on ───────────────────────────── -->
  <SectionBlock id="credentials" tone="subtle" padding="default">
    <Container>
      <SectionHeading
        label="What you can count on"
        title="The boring, important stuff."
        align="center"
      />
      <ul class="tc-about-credentials">
        {
          credentials.map((c) => (
            <li class="tc-about-credentials__item">
              <span class="tc-about-credentials__mark" aria-hidden="true">
                ◆
              </span>
              {c}
            </li>
          ))
        }
      </ul>
    </Container>
  </SectionBlock>

  <!-- ─── Gallery ─────────────────────────────────────────── -->
  {
    galleryItems.length > 0 && (
      <SectionBlock tone="subtle" padding="default" topBorder>
        <Container>
          <GalleryGrid
            eyebrow={galleryFm.eyebrow}
            title={galleryFm.title}
            sideNote={galleryFm.side_note}
            items={galleryItems}
          />
        </Container>
      </SectionBlock>
    )
  }

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="tc-about-cta">
      <h2 class="tc-about-cta__title">If this sounds like your kind of thing.</h2>
      <p class="tc-about-cta__lede">
        Send your date and a few details and we'll set up a short call. No
        pressure, no script, just a chance to see whether I'm the right
        person to photograph your day.
      </p>
      <ActionButton
        href="/contact"
        label="Check your date"
        variant="primary-light"
        size="large"
        className="fs-book-btn"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  .tc-about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .tc-about-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    font-weight: var(--fw-headline);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: none;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .tc-about-hero__title em {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.03em;
  }

  .tc-about-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.6;
    max-width: 56ch;
  }

  .tc-about-hero__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tc-about-hero__plate-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1554080353-a576cf803bda?w=900&h=1100&fit=crop');
    background-size: cover;
    background-position: center;
    filter: contrast(1.02) saturate(0.92);
  }

  .tc-about-quote {
    max-width: 920px;
  }

  .tc-about-approach {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 80px;
  }

  .tc-about-approach__heading {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .tc-about-approach__title {
    color: var(--text-on-dark);
    margin-top: 16px;
    max-width: 16ch;
  }

  .tc-about-approach__copy {
    display: grid;
    gap: 24px;
    max-width: 64ch;
  }

  .tc-about-approach__copy p {
    font-size: var(--fs-h5);
    line-height: 1.6;
    color: var(--text-on-dark);
  }

  .tc-about-approach__copy strong {
    color: var(--brand-primary);
    font-weight: var(--fw-semibold);
  }

  .tc-about-journey {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 80px;
    align-items: start;
  }

  .tc-about-journey__heading {
    position: sticky;
    top: 100px;
  }

  .tc-about-journey__heading .section-title {
    margin-top: 16px;
    max-width: 12ch;
  }

  .tc-about-journey__list {
    border-top: 1px solid var(--surface-subtle-border);
  }

  .tc-about-credentials {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 40px;
    max-width: 820px;
    margin: 0 auto;
  }

  .tc-about-credentials__item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 12px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .tc-about-credentials__mark {
    color: var(--brand-primary);
    font-size: 0.75em;
    line-height: 1.5;
  }

  .tc-about-cta {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .tc-about-cta__title {
    font-family: var(--font-title);
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    font-weight: var(--fw-headline);
    text-transform: none;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .tc-about-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--text-nav);
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .tc-about-hero,
    .tc-about-approach,
    .tc-about-journey {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .tc-about-approach__heading,
    .tc-about-journey__heading {
      position: static;
    }

    .tc-about-credentials {
      grid-template-columns: 1fr;
    }
  }
</style>
