---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ContactCard from '../../../shared/dorin-ds/components/ContactCard.astro';
import FormField from '../../../shared/dorin-ds/components/FormField.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface BookingContent {
  enabled?: boolean;
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

const bookingFm = bookingData as BookingContent;
const showBooking = bookingFm.enabled !== false;
---

<Layout
  title="Contact — June Hartley Photography"
  description="Check your date for weddings, elopements, and portraits in Portland and across the Pacific Northwest. I reply to every note personally."
  activeIndex={3}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="tc-contact-hero">
      <OverlineText text="Get in touch" tone="accent" />
      <h1 class="tc-contact-hero__title">
        Let's talk about<br />
        <em>your day</em>.
      </h1>
      <p class="tc-contact-hero__lede">
        Send your date and a few details and we'll set up a short call.
        No hard sell, and no need to have everything figured out yet.
        I only take a handful of weddings each season, so earlier is better.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── Direct booking ──────────────────────────────────── -->
  {
    showBooking && (
      <SectionBlock tone="subtle" padding="default" topBorder>
        <Container>
          <CalBookingBlock
            variant="inline"
            calLink={bookingFm.cal_link}
            eventLabel={bookingFm.cal_event_label}
            title={bookingFm.title}
            subtitle={bookingFm.description}
            durationLabel={bookingFm.cal_duration_label}
            layout={bookingFm.cal_layout}
          />
        </Container>
      </SectionBlock>
    )
  }

  <!-- ─── Contact (form + info) ───────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container className="tc-contact-grid">
      <div class="tc-contact-grid__form-col">
        <h2 class="tc-contact-grid__form-title">Check your date</h2>
        <p class="tc-contact-grid__form-lede">
          Tell me a little about what you're planning. I read every note
          myself and reply within two days, usually sooner.
        </p>

        <div
          id="form-success"
          class="tc-contact-grid__alert tc-contact-grid__alert--success"
          hidden
        >
          Thanks for reaching out. I'll get back to you within two days.
        </div>
        <div
          id="form-error"
          class="tc-contact-grid__alert tc-contact-grid__alert--error"
          hidden
        >
          Something went wrong. Please try again or email me directly.
        </div>

        <form
          id="contact-form"
          data-contact-form
          data-success-message="Thanks for reaching out. I'll get back to you within two days, usually sooner."
          class="tc-contact-grid__form"
        >
          <input type="hidden" name="_template" value="" />
          <input type="hidden" name="_source" value="" />

          <div class="tc-contact-grid__row">
            <FormField
              type="text"
              name="firstName"
              label="First name"
              placeholder="Your first name"
              required
            />
            <FormField
              type="text"
              name="lastName"
              label="Last name"
              placeholder="Your last name"
              required
            />
          </div>

          <FormField
            type="email"
            name="email"
            label="Email"
            placeholder="you@example.com"
            required
          />

          <FormField
            type="text"
            name="event_date"
            label="Date (or rough timing)"
            placeholder="e.g. late September 2026"
          />

          <FormField
            type="textarea"
            name="message"
            label="Tell me about your day"
            placeholder="Where, roughly how many people, and the kind of day you're hoping for. No need to have it all figured out."
            required
          />

          <button type="submit" class="tc-contact-grid__submit">
            Send the details
          </button>

          <p class="tc-contact-grid__note">
            I read every note personally. You'll hear back within two days.
          </p>
        </form>
      </div>

      <aside class="tc-contact-grid__info-col">
        <h3 class="tc-contact-grid__info-title">Or reach out directly</h3>
        <div class="tc-contact-grid__info-cards">
          <ContactCard
            label="Email"
            value="hello@junehartley.com"
            href="mailto:hello@junehartley.com"
            hint="I read every message myself and reply within two days"
          />
          <ContactCard
            label="Phone"
            value="+1 503 555 0147"
            href="tel:+15035550147"
            hint="Tue–Sat — voicemail returned the same day"
          />
          <ContactCard
            label="Studio"
            value="Portland, Oregon"
            hint="A small studio in southeast Portland, by appointment. Available across the Pacific Northwest and for travel."
          />
        </div>

        <div class="tc-contact-grid__hours">
          <span class="tc-contact-grid__hours-label">Studio hours</span>
          <ul class="tc-contact-grid__hours-list">
            <li><span>Tue — Fri</span><span>10:00 — 17:00</span></li>
            <li><span>Saturday</span><span>Shooting / by appt</span></li>
            <li><span>Sun — Mon</span><span>Closed</span></li>
          </ul>
        </div>

        <p class="tc-contact-grid__crisis">
          <strong>Planning a date that's soon?</strong> Say so in your note
          and I'll move you up the list. Weekends in summer and early fall
          book up first, so it's worth reaching out early.
        </p>
      </aside>
    </Container>
  </SectionBlock>
</Layout>

<style>
  .tc-contact-hero {
    max-width: 880px;
  }

  .tc-contact-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    font-weight: var(--fw-headline);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: none;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .tc-contact-hero__title em {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.03em;
  }

  .tc-contact-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.6;
    max-width: 62ch;
  }

  .tc-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .tc-contact-grid__form-title {
    font-family: var(--font-title);
    font-size: var(--fs-h3);
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--bg-dark);
    margin-bottom: 16px;
  }

  .tc-contact-grid__form-lede {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .tc-contact-grid__form {
    display: grid;
    gap: 20px;
  }

  .tc-contact-grid__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .tc-contact-grid__alert {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    margin-bottom: 24px;
  }

  .tc-contact-grid__alert[hidden] {
    display: none;
  }

  .tc-contact-grid__alert--success {
    background: var(--surface-brand-glow);
    color: var(--bg-dark);
    border: 1px solid var(--brand-primary);
  }

  .tc-contact-grid__alert--error {
    background: rgba(220, 80, 80, 0.12);
    color: #8a2a2a;
    border: 1px solid rgba(220, 80, 80, 0.32);
  }

  .tc-contact-grid__submit {
    margin-top: 8px;
    padding: 18px 32px;
    font-family: var(--font-button);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border: 1px solid var(--bg-dark);
    transition: opacity var(--transition);
  }

  .tc-contact-grid__submit:hover {
    opacity: 0.85;
  }

  .tc-contact-grid__note {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
  }

  .tc-contact-grid__info-title {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .tc-contact-grid__info-cards {
    display: grid;
    gap: 16px;
    margin-bottom: 32px;
  }

  .tc-contact-grid__hours {
    padding: 28px 24px;
    background: var(--surface-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 24px;
  }

  .tc-contact-grid__hours-label {
    display: block;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .tc-contact-grid__hours-list {
    display: grid;
    gap: 8px;
  }

  .tc-contact-grid__hours-list li {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    padding: 6px 0;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .tc-contact-grid__hours-list li:last-child {
    border-bottom: none;
  }

  .tc-contact-grid__crisis {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-muted);
    padding: 18px 20px;
    border-left: 2px solid var(--brand-primary);
    background: var(--surface-brand-glow);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .tc-contact-grid__crisis strong {
    color: var(--bg-dark);
    font-weight: var(--fw-semibold);
  }

  @media (max-width: 1024px) {
    .tc-contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 600px) {
    .tc-contact-grid__row {
      grid-template-columns: 1fr;
    }
  }
</style>
