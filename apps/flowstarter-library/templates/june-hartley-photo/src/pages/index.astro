---
import Layout from '../layouts/Layout.astro';

const nav = [
  { label: 'Work', href: '#gallery' },
  { label: 'About', href: '#about' },
  { label: 'Collections', href: '#collections' },
  { label: 'Contact', href: '#contact' },
];

// Editorial gallery — a mix of full-bleed and clustered frames.
const gallery = [
  { src: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=1600&h=1100&fit=crop', cap: 'Maren & Eli — Hoyt Arboretum', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1606216794074-735e91aa2c92?w=900&h=1200&fit=crop', cap: 'First look, Forest Park', span: 'tall' },
  { src: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=900&h=1100&fit=crop', cap: 'The toast', span: 'std' },
  { src: 'https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=900&h=1200&fit=crop', cap: 'Getting ready', span: 'tall' },
  { src: 'https://images.unsplash.com/photo-1469371670807-013ccf25f16a?w=900&h=1100&fit=crop', cap: 'Vows on the coast', span: 'std' },
  { src: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=1600&h=1050&fit=crop', cap: 'Columbia Gorge elopement', span: 'wide' },
  { src: 'https://images.unsplash.com/photo-1537907510278-10acdb198d0f?w=900&h=1200&fit=crop', cap: 'Quiet moment', span: 'tall' },
  { src: 'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=900&h=1100&fit=crop', cap: 'The two of them', span: 'std' },
];

const collections = [
  { k: '01', name: 'Weddings', body: 'Full-day documentary coverage, from the slow morning to the last song. Two photographers, an online gallery, and prints you will actually hold.', price: 'from €2,800' },
  { k: '02', name: 'Elopements', body: 'Just the two of you, somewhere that means something. I help with the timeline and the spots, then stay out of the way and photograph the day as it happens.', price: 'from €1,650' },
  { k: '03', name: 'Portraits & families', body: 'A relaxed hour outdoors - couples, growing families, anyone who wants honest pictures of this season of life.', price: 'from €420' },
];

const film = ['Weddings', 'Elopements', 'Portraits', 'Pacific Northwest', 'Documentary', 'Film & digital'];
---
<Layout>
  <header class="nav">
    <a href="#top" class="brand">June Hartley</a>
    <nav class="nav__links">{nav.map((i) => <a href={i.href}>{i.label}</a>)}</nav>
    <div class="nav__right">
      <button type="button" class="themer" data-themer aria-label="Toggle theme">
        <svg class="ic ic-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
        <svg class="ic ic-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <a href="#contact" class="cta">Inquire</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <img class="hero__img" src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=2000&h=2400&fit=crop" alt="A couple in soft natural light" loading="eager" />
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__copy">
        <p class="kick reveal">Wedding &amp; portrait photographer · Portland, Oregon</p>
        <h1 class="hero__title reveal" style="--d:.08s">The day,<br /><em>exactly as it felt.</em></h1>
        <p class="hero__lede reveal" style="--d:.18s">Warm, unhurried photographs of weddings and the people you love. I travel for the ones worth traveling for.</p>
      </div>
      <span class="hero__scroll reveal" style="--d:.3s" aria-hidden="true">Scroll</span>
    </section>

    <!-- FILM STRIP -->
    <div class="film" aria-hidden="true"><div class="film__row">
      {Array(2).fill(0).map(() => (<>
        {film.map((w) => (<><span>{w}</span><i>✦</i></>))}
      </>))}
    </div></div>

    <!-- GALLERY -->
    <section class="section gal" id="gallery">
      <div class="head">
        <p class="lbl reveal">Selected work</p>
        <h2 class="h2 reveal" style="--d:.06s">A few of my<br /><em>favorite frames.</em></h2>
      </div>
      <div class="mason">
        {gallery.map((g, i) => (
          <figure class={`frame frame--${g.span} reveal`} style={`--d:${(i % 4) * 0.05}s`}>
            <img src={g.src} alt={g.cap} loading="lazy" />
            <figcaption>{g.cap}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section about" id="about">
      <figure class="about__shot reveal">
        <img src="https://images.unsplash.com/photo-1554151228-14d9def656e4?w=900&h=1150&fit=crop" alt="June Hartley, photographer" loading="lazy" />
      </figure>
      <div class="about__copy reveal" style="--d:.1s">
        <p class="lbl">Hello, I'm June</p>
        <h2 class="h2">I shoot the quiet<br /><em>parts too.</em></h2>
        <p>I'm a documentary photographer based in Portland. For me the best frames usually happen in the in-between moments - your dad fixing his tie, the laugh after the vows, the long hug nobody planned.</p>
        <p>I keep things calm and easy on the day. You won't catch me barking poses or staging a fake first look. I just pay attention, and I bring back the way it actually felt. I've been doing this for nine years and I still tear up at most of them.</p>
        <p class="sig">June</p>
      </div>
    </section>

    <!-- COLLECTIONS -->
    <section class="section coll" id="collections">
      <div class="head">
        <p class="lbl reveal">Collections</p>
        <h2 class="h2 reveal" style="--d:.06s">How we can<br /><em>work together.</em></h2>
      </div>
      <ul class="coll__list">
        {collections.map((c, i) => (
          <li class="coll__row reveal" style={`--d:${i * 0.06}s`}>
            <span class="coll__k">{c.k}</span>
            <h3 class="coll__name">{c.name}</h3>
            <p class="coll__body">{c.body}</p>
            <span class="coll__price">{c.price}</span>
          </li>
        ))}
      </ul>
      <p class="coll__note reveal">Every collection includes a private online gallery and a print release. Travel within Oregon and Washington is on me.</p>
    </section>

    <!-- TESTIMONIAL -->
    <section class="testi">
      <figure class="reveal">
        <blockquote>“June felt like a friend who happened to have a camera. We barely noticed her all day, and then the gallery arrived and we cried for an hour. Every photo is so <em>us</em>.”</blockquote>
        <figcaption>Maren &amp; Eli · married in the Gorge, 2025</figcaption>
      </figure>
    </section>

    <!-- CONTACT -->
    <section class="section contact" id="contact">
      <img class="contact__bg" src="https://images.unsplash.com/photo-1519741497674-611481863552?w=2000&h=1300&fit=crop" alt="" aria-hidden="true" loading="lazy" />
      <div class="contact__scrim" aria-hidden="true"></div>
      <div class="contact__inner reveal">
        <p class="kick">Now booking 2026 · a handful of 2027 dates</p>
        <h2 class="contact__title">Let's tell<br /><em>your story.</em></h2>
        <p class="contact__lede">Tell me your date, where you're headed, and a little about the two of you. I reply to every note myself, usually within a day or two.</p>
        <div class="contact__cta">
          <a href="mailto:hello@junehartley.com" class="cta cta--lg">hello@junehartley.com</a>
          <span class="contact__avail">I take a limited number of weddings each year so the days stay unhurried.</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot__word">JUNE HARTLEY</div>
    <div class="foot__cols">
      <div><h4>Photography</h4><a href="#collections">Weddings</a><a href="#collections">Elopements</a><a href="#collections">Portraits</a></div>
      <div><h4>Studio</h4><a href="#gallery">Work</a><a href="#about">About</a><a href="#contact">Contact</a></div>
      <div><h4>Find me</h4><a href="#">Instagram</a><a href="#">Pinterest</a><a href="mailto:hello@junehartley.com">Email</a></div>
    </div>
    <div class="foot__base"><span>© 2026 June Hartley Photography</span><span>Portland, Oregon · Available worldwide</span></div>
  </footer>

  <script is:inline>
    (function () { var b = document.querySelector('[data-themer]'); if (b) b.addEventListener('click', function () { var d = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', d); document.documentElement.classList.toggle('dark', d); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (_) {} }); })();
    (function () { var els = document.querySelectorAll('.reveal'); if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; } var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.1 }); els.forEach(function (e) { io.observe(e); }); })();
  </script>

  <style is:global>
    /* DARK is the default (:root). LIGHT overrides under html:not(.theme-dark):not(.dark). */
    :root {
      --bg: #161311; --raise: #1f1a17; --ink: #f3ece2; --dim: #a99c8e;
      --accent: #c08a6f; --line: rgba(243,236,226,.14);
      --serif: 'Playfair Display', Georgia, serif;
      --body: 'Manrope', -apple-system, system-ui, sans-serif;
    }
    html:not(.theme-dark):not(.dark) {
      --bg: #f7f3ee; --raise: #efe8df; --ink: #2a2320; --dim: #837567; --accent: #b07a62; --line: rgba(42,35,32,.13);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 17px; line-height: 1.7; -webkit-font-smoothing: antialiased; overflow-x: hidden; transition: background .5s, color .5s; }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    em { font-style: italic; }
    ::selection { background: var(--accent); color: #fff; }
    .reveal { opacity: 0; transform: translateY(26px); transition: opacity 1s cubic-bezier(.2,.7,.2,1) var(--d,0s), transform 1s cubic-bezier(.2,.7,.2,1) var(--d,0s); }
    .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce){ .reveal{opacity:1;transform:none;transition:none} }

    .kick { text-transform: uppercase; letter-spacing: .32em; font-size: .68rem; font-weight: 600; color: var(--accent); margin: 0 0 1.4rem; }
    .lbl { text-transform: uppercase; letter-spacing: .3em; font-size: .68rem; font-weight: 600; color: var(--accent); margin: 0 0 1rem; }
    .h2 { font-family: var(--serif); font-weight: 600; font-size: clamp(2.2rem,5vw,4rem); line-height: 1.04; letter-spacing: -.01em; margin: 0; }
    .h2 em { color: var(--accent); }

    .cta { display: inline-flex; align-items: center; font-family: var(--body); letter-spacing: .04em; font-weight: 600; font-size: .82rem; background: var(--accent); color: #fff; padding: .8rem 1.5rem; border: 0; border-radius: 999px; cursor: pointer; transition: transform .25s, opacity .25s; }
    .cta:hover { transform: translateY(-2px); opacity: .92; }
    .cta--lg { padding: 1.05rem 2.1rem; font-size: 1rem; letter-spacing: .02em; }

    /* NAV */
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.1rem clamp(1.2rem,5vw,3.5rem); background: color-mix(in srgb, var(--bg) 72%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
    .brand { font-family: var(--serif); font-weight: 600; font-size: 1.45rem; letter-spacing: .01em; }
    .nav__links { display: flex; gap: 2rem; }
    .nav__links a { text-transform: uppercase; letter-spacing: .16em; font-size: .72rem; font-weight: 600; color: var(--dim); transition: color .25s; }
    .nav__links a:hover { color: var(--ink); }
    .nav__right { display: flex; align-items: center; gap: 1rem; }
    .themer { width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--ink); cursor: pointer; display: grid; place-items: center; transition: border-color .25s, color .25s; }
    .themer:hover { border-color: var(--accent); color: var(--accent); }
    .themer .ic { grid-area: 1 / 1; }
    .themer .ic-moon { display: none; }
    html.theme-dark .themer .ic-sun, html.dark .themer .ic-sun { display: none; }
    html.theme-dark .themer .ic-moon, html.dark .themer .ic-moon { display: block; }

    /* HERO */
    .hero { position: relative; min-height: 100vh; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
    .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
    .hero__scrim { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(18,13,10,.88) 0%, rgba(18,13,10,.55) 30%, rgba(18,13,10,.12) 58%, rgba(18,13,10,.24) 100%); }
    .hero__copy { position: relative; z-index: 2; padding: 0 clamp(1.2rem,5vw,4rem) clamp(3rem,7vw,5.5rem); max-width: 60rem; color: #f6efe6; }
    .hero__copy .kick { color: #f0d2c2; text-shadow: 0 1px 12px rgba(0,0,0,.4); }
    .hero__title { font-family: var(--serif); font-weight: 600; font-size: clamp(2.8rem,8vw,6.5rem); line-height: .98; letter-spacing: -.015em; margin: 0 0 1.4rem; text-shadow: 0 2px 30px rgba(0,0,0,.35); }
    .hero__title em { color: #eccab6; }
    .hero__lede { font-size: clamp(1.05rem,1.6vw,1.3rem); max-width: 46ch; margin: 0; color: rgba(246,239,230,.92); }
    .hero__scroll { position: absolute; right: clamp(1.2rem,5vw,4rem); bottom: clamp(3rem,7vw,5.5rem); z-index: 2; writing-mode: vertical-rl; text-transform: uppercase; letter-spacing: .32em; font-size: .66rem; font-weight: 600; color: rgba(246,239,230,.7); }

    /* FILM STRIP */
    .film { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--raise); overflow: hidden; padding: 1.1rem 0; }
    .film__row { display: flex; gap: 2rem; width: max-content; animation: drift 34s linear infinite; align-items: center; font-family: var(--serif); font-style: italic; font-size: 1.5rem; color: var(--ink); }
    .film__row i { font-style: normal; color: var(--accent); font-size: .9rem; opacity: .8; }
    @keyframes drift { to { transform: translateX(-50%); } }
    @media (prefers-reduced-motion: reduce){ .film__row{animation:none} }

    /* SECTION SHELL */
    .section { max-width: 1480px; margin: 0 auto; padding: clamp(4.5rem,9vw,9rem) clamp(1.2rem,5vw,3.5rem); }
    .head { margin-bottom: clamp(2.5rem,5vw,4rem); }

    /* GALLERY MASONRY */
    .mason { columns: 2; column-gap: clamp(.8rem,1.6vw,1.4rem); }
    .frame { position: relative; margin: 0 0 clamp(.8rem,1.6vw,1.4rem); break-inside: avoid; overflow: hidden; border-radius: 2px; }
    .frame img { width: 100%; height: auto; object-fit: cover; transition: transform 1.4s cubic-bezier(.2,.7,.2,1), filter .6s; filter: saturate(.94); }
    .frame:hover img { transform: scale(1.05); filter: saturate(1.04); }
    .frame figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem 1rem .9rem; font-size: .66rem; text-transform: uppercase; letter-spacing: .2em; font-weight: 600; color: #fff; background: linear-gradient(to top, rgba(20,15,12,.7), transparent); opacity: 0; transform: translateY(8px); transition: opacity .4s, transform .4s; }
    .frame:hover figcaption { opacity: 1; transform: none; }
    .frame--wide { column-span: all; }
    .frame--wide img { aspect-ratio: 16/10; }
    @media (max-width:760px){ .mason{columns:1} .frame--wide img{aspect-ratio:4/3} }

    /* ABOUT */
    .about { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem,5vw,5rem); align-items: center; }
    .about__shot { margin: 0; overflow: hidden; border-radius: 2px; }
    .about__shot img { width: 100%; aspect-ratio: 4/5; object-fit: cover; filter: saturate(.95); }
    .about__copy p { color: var(--dim); margin: 1.2rem 0 0; max-width: 52ch; }
    .about__copy .h2 { margin-top: .3rem; }
    .sig { font-family: var(--serif); font-style: italic; font-size: 2rem; color: var(--ink) !important; margin-top: 1.6rem !important; }
    @media (max-width:860px){ .about{grid-template-columns:1fr} .about__shot{max-width:420px} }

    /* COLLECTIONS */
    .coll__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .coll__row { display: grid; grid-template-columns: 3rem 1fr 2.2fr auto; gap: 1.8rem; align-items: baseline; padding: 2rem .4rem; border-bottom: 1px solid var(--line); transition: padding .3s, background .3s; }
    .coll__row:hover { background: var(--raise); padding-left: 1.4rem; padding-right: 1.4rem; }
    .coll__k { font-family: var(--serif); font-style: italic; font-size: 1.1rem; color: var(--accent); }
    .coll__name { font-family: var(--serif); font-weight: 600; font-size: clamp(1.5rem,2.6vw,2.1rem); margin: 0; line-height: 1; }
    .coll__body { color: var(--dim); font-size: .98rem; margin: 0; }
    .coll__price { font-family: var(--serif); font-style: italic; font-size: 1.25rem; white-space: nowrap; color: var(--ink); }
    .coll__note { color: var(--dim); font-size: .92rem; margin: 2rem 0 0; max-width: 56ch; }
    @media (max-width:820px){ .coll__row{grid-template-columns:2.2rem 1fr; row-gap:.6rem} .coll__body{grid-column:2} .coll__price{grid-column:2; padding-top:.2rem} }

    /* TESTIMONIAL */
    .testi { max-width: 1000px; margin: 0 auto; padding: clamp(3.5rem,8vw,8rem) clamp(1.2rem,5vw,3.5rem); text-align: center; }
    .testi blockquote { font-family: var(--serif); font-style: italic; font-weight: 500; font-size: clamp(1.6rem,3.4vw,2.7rem); line-height: 1.3; margin: 0 auto; max-width: 24ch; }
    .testi blockquote em { color: var(--accent); }
    .testi figcaption { margin-top: 2rem; text-transform: uppercase; letter-spacing: .2em; font-size: .7rem; font-weight: 600; color: var(--dim); }

    /* CONTACT */
    .contact { position: relative; max-width: none; padding: 0; overflow: hidden; }
    .contact__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
    .contact__scrim { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to right, rgba(20,15,12,.82), rgba(20,15,12,.45)); }
    .contact__inner { position: relative; z-index: 2; max-width: 1480px; margin: 0 auto; padding: clamp(5rem,11vw,10rem) clamp(1.2rem,5vw,3.5rem); color: #f6efe6; }
    .contact__inner .kick { color: #e8c3b0; }
    .contact__title { font-family: var(--serif); font-weight: 600; font-size: clamp(2.8rem,7vw,5.5rem); line-height: 1; margin: 0 0 1.5rem; text-shadow: 0 2px 30px rgba(0,0,0,.3); }
    .contact__title em { color: #eccab6; }
    .contact__lede { font-size: 1.1rem; max-width: 48ch; margin: 0 0 2.4rem; color: rgba(246,239,230,.9); }
    .contact__cta { display: flex; align-items: center; gap: 1.8rem; flex-wrap: wrap; }
    .contact__avail { font-size: .86rem; color: rgba(246,239,230,.7); max-width: 30ch; }

    /* FOOTER */
    .foot { border-top: 1px solid var(--line); max-width: 1480px; margin: 0 auto; padding: clamp(3.5rem,7vw,5.5rem) clamp(1.2rem,5vw,3.5rem) 2.5rem; }
    .foot__word { font-family: var(--serif); font-weight: 600; font-size: clamp(2.6rem,11vw,8rem); line-height: .9; letter-spacing: -.01em; margin-bottom: 2.5rem; }
    .foot__cols { display: flex; gap: clamp(2rem,5vw,5rem); flex-wrap: wrap; }
    .foot__cols h4 { text-transform: uppercase; letter-spacing: .18em; font-size: .68rem; color: var(--accent); margin: 0 0 1rem; font-weight: 600; }
    .foot__cols a { display: block; color: var(--dim); font-size: .92rem; margin-bottom: .55rem; transition: color .25s; }
    .foot__cols a:hover { color: var(--ink); }
    .foot__base { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--line); font-size: .76rem; color: var(--dim); text-transform: uppercase; letter-spacing: .12em; }

    @media (max-width:860px){ .nav__links{display:none} }
  </style>
</Layout>
