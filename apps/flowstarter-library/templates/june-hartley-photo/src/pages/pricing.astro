---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import PricingCard from '../../../shared/dorin-ds/components/PricingCard.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';
import { frontmatter as siteData } from '../../content/site.md';
import { frontmatter as pricingData } from '../../content/pricing.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface SiteContent {
  name?: string;
  description?: string;
}

interface PricingPlan {
  name: string;
  price: number | string;
  period?: string;
  description?: string;
  features?: string[];
  cta?: string;
  popular?: boolean;
}

interface PricingContent {
  title?: string;
  subtitle?: string;
  plans?: PricingPlan[];
  guarantee?: string;
}

interface BookingContent {
  enabled?: boolean;
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

const site = siteData as SiteContent;
const pricingFm = pricingData as PricingContent;
const bookingFm = bookingData as BookingContent;
const showBooking = bookingFm.enabled === true && Boolean(bookingFm.cal_link);

const siteName = site.name ?? 'June Hartley Photography';
const siteDescription =
  site.description ??
  'Documentary wedding and portrait photography in Portland and across the Pacific Northwest.';
const plans = pricingFm.plans ?? [];
---

<Layout
  title={`Pricing — ${siteName}`}
  description={siteDescription}
  activeIndex={2}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="tc-pricing-hero">
      <OverlineText text="Investment" tone="accent" />
      <h1 class="tc-pricing-hero__title" set:html={pricingFm.title ?? ''} />
      <p class="tc-pricing-hero__lede">
        {pricingFm.subtitle ?? ''}
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── Plans ─────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <div class="tc-pricing-grid">
        {
          plans.map((plan) => (
            <PricingCard
              name={plan.name}
              price={
                typeof plan.price === 'number'
                  ? `$${plan.price}`
                  : `${plan.price}`
              }
              cadence={plan.period ?? ''}
              description={plan.description ?? ''}
              features={plan.features ?? []}
              ctaLabel={plan.cta ?? 'Get started'}
              ctaHref="/contact"
              featured={!!plan.popular}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Guarantee ─────────────────────────────────────── -->
  {
    pricingFm.guarantee && (
      <SectionBlock tone="accent-light" padding="compact" topBorder>
        <Container className="tc-pricing-guarantee">
          <span class="tc-pricing-guarantee__mark" aria-hidden="true">
            ◆
          </span>
          <p class="tc-pricing-guarantee__text">{pricingFm.guarantee}</p>
        </Container>
      </SectionBlock>
    )
  }

  <!-- ─── Final CTA ─────────────────────────────────────── -->
  {
    showBooking && (
      <SectionBlock tone="dark" padding="default">
        <Container>
          <CalBookingBlock
            variant="cta"
            calLink={bookingFm.cal_link}
            eventLabel={bookingFm.cal_event_label}
            title={bookingFm.title}
            subtitle={bookingFm.description}
            durationLabel={bookingFm.cal_duration_label}
            layout={bookingFm.cal_layout}
          />
        </Container>
      </SectionBlock>
    )
  }
</Layout>

<style>
  .tc-pricing-hero {
    max-width: 880px;
  }

  .tc-pricing-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    font-weight: var(--fw-headline);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .tc-pricing-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.6;
    max-width: 60ch;
  }

  .tc-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .tc-pricing-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .tc-pricing-guarantee__mark {
    color: var(--brand-primary);
    font-size: 1.1em;
    line-height: 1;
  }

  .tc-pricing-guarantee__text {
    font-family: var(--font-title);
    font-size: var(--fs-h5);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    color: var(--bg-dark);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .tc-pricing-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .tc-pricing-guarantee {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
