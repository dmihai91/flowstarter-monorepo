---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import PricingCard from '../../../shared/dorin-ds/components/PricingCard.astro';
import FaqAccordionItem from '../../../shared/dorin-ds/components/FaqAccordionItem.astro';
import ProcessStep from '../../../shared/dorin-ds/components/ProcessStep.astro';
import { frontmatter as servicesData } from '../../content/services.md';
import { frontmatter as pricingData } from '../../content/pricing.md';

interface ServicesContent {
  title?: string;
  subtitle?: string;
  services?: Array<{
    icon?: string;
    title: string;
    description: string;
    price?: string;
  }>;
}

interface PricingPlan {
  name: string;
  price: number | string;
  period?: string;
  description?: string;
  features?: string[];
  cta?: string;
  popular?: boolean;
}

interface PricingContent {
  title?: string;
  subtitle?: string;
  plans?: PricingPlan[];
  guarantee?: string;
}

const servicesFm = servicesData as ServicesContent;
const pricingFm = pricingData as PricingContent;

const programs = (servicesFm.services ?? []).map((service, index) => ({
  number: String(index + 1).padStart(2, '0'),
  title: service.title,
  description: service.description,
}));

const pricing = (pricingFm.plans ?? []).map((plan) => ({
  name: plan.name,
  price: typeof plan.price === 'number' ? `$${plan.price}` : `${plan.price}`,
  cadence: plan.period ?? '',
  description: plan.description ?? '',
  features: plan.features ?? [],
  ctaLabel: plan.cta ?? 'Get started',
  ctaHref: '/contact',
  featured: !!plan.popular,
}));

const process = [
  {
    step: 'Step 1',
    title: 'Check your date',
    description:
      'Send a note with your date and a few details. If I am free, we hop on a quick call so I can hear about the day and you can decide whether I am your person.',
  },
  {
    step: 'Step 2',
    title: 'Lock it in',
    description:
      'A simple agreement and a retainer hold the date. From there it is yours, and I stop taking other inquiries for that day.',
  },
  {
    step: 'Step 3',
    title: 'The lead-up',
    description:
      'We sort the timeline together, fit in an engagement session if it is part of your collection, and make a loose plan for light and locations. No spreadsheets required.',
  },
  {
    step: 'Step 4',
    title: 'The day, then your gallery',
    description:
      'I show up, shoot quietly, and stay until the moments you care about are done. A sneak peek lands within 48 hours and the full gallery within four weeks.',
  },
];

const faqs = [
  {
    question: 'How many photos do we get, and when?',
    answer:
      'A full wedding day usually delivers 500 to 800 edited images. You will see a sneak peek within 48 hours and the complete gallery within four weeks. Portrait sessions deliver 40 or more images within two weeks.',
  },
  {
    question: 'Do you travel?',
    answer:
      'Often. I am based in Portland and shoot all over the Pacific Northwest with no travel fee. For weddings further afield I add travel at cost, no markup, and we sort the details on our call.',
  },
  {
    question: 'What happens if it rains, or gear fails?',
    answer:
      'Rain is fine, some of my favourite frames happen under umbrellas. I shoot on two camera bodies and back up every card on the day, so a single failure never costs you the photos. For larger weddings I bring a second shooter.',
  },
  {
    question: 'Do we need an engagement session?',
    answer:
      'No, but it helps. An hour together beforehand gets you comfortable in front of the camera, so the wedding photos feel more like you. It is included in the full-day collection.',
  },
  {
    question: 'How do we book?',
    answer:
      'Send your date through the contact form and we will set up a call. If it feels right, a signed agreement and a retainer hold the date. I only take a limited number of weddings each season so the calendar fills early.',
  },
];
---

<Layout
  title="Work — June Hartley Photography"
  description="Weddings, elopements, engagements, and portraits in Portland and across the Pacific Northwest. Documentary coverage with clear, honest pricing."
  activeIndex={0}
>
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <SectionBlock tone="light" padding="hero">
    <Container className="tc-services-hero">
      <OverlineText text="What I photograph" tone="accent" />
      <h1 class="tc-services-hero__title">
        Weddings, portraits,<br />
        <em>and everything</em><br />
        in between.
      </h1>
      <p class="tc-services-hero__lede">
        A short, honest list of ways to work together, with pricing to
        match. Most couples land somewhere between collections, so every
        booking gets a written quote after a quick call.
      </p>
      <div class="tc-services-hero__actions">
        <ActionButton
          href="/contact"
          label="Check your date"
          variant="primary"
          size="large"
        />
        <ActionButton
          href="#pricing"
          label="See pricing"
          variant="outline-dark"
          size="large"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Programs list ────────────────────────────────────── -->
  <SectionBlock id="programs" tone="light" padding="default" topBorder>
    <Container className="tc-services-list">
      <div class="tc-services-list__heading">
        <OverlineText text="Offerings" />
        <h2 class="section-title">Six ways to work together.</h2>
      </div>
      <div class="tc-services-list__items">
        {
          programs.map((p) => (
            <NumberedFeatureItem
              number={p.number}
              title={p.title}
              description={p.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Process ─────────────────────────────────────────── -->
  <SectionBlock tone="subtle" padding="default">
    <Container>
      <SectionHeading
        label="From first note to final gallery"
        title="How booking actually works."
        maxWidth="22ch"
      />
      <div class="tc-services-process">
        {
          process.map((s) => (
            <ProcessStep
              step={s.step}
              title={s.title}
              description={s.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Pricing ─────────────────────────────────────────── -->
  <SectionBlock id="pricing" tone="light" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="Investment"
        title="Three starting points."
        align="center"
        maxWidth="22ch"
      />
      <div class="tc-services-pricing">
        {pricing.map((p) => <PricingCard {...p} />)}
      </div>
      <p class="tc-services-pricing-note">
        Every wedding gets a written quote after a quick call. Extra hours,
        a second shooter, albums, and fine prints can be added to any
        collection.
      </p>
    </Container>
  </SectionBlock>

  <!-- ─── FAQ ─────────────────────────────────────────────── -->
  <SectionBlock id="faq" tone="subtle" padding="default">
    <Container className="tc-services-faq">
      <SectionHeading label="Common questions" title="The things couples usually ask." />
      <div class="tc-services-faq__list">
        {faqs.map((f) => <FaqAccordionItem question={f.question} answer={f.answer} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA ─────────────────────────────────────────────── -->
  <SectionBlock tone="dark" padding="default">
    <Container className="tc-services-cta">
      <h2 class="tc-services-cta__title">Not sure which collection fits?</h2>
      <p class="tc-services-cta__lede">
        That is what the first call is for. Tell me about your day and I
        will point you to the right starting point, no pressure either way.
      </p>
      <ActionButton
        href="/contact"
        label="Check your date"
        variant="primary-light"
        size="large"
        className="fs-book-btn"
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  .tc-services-hero {
    max-width: 880px;
  }

  .tc-services-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    font-weight: var(--fw-headline);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: none;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .tc-services-hero__title em {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.03em;
  }

  .tc-services-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: 36px;
  }

  .tc-services-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .tc-services-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 80px;
    align-items: start;
  }

  .tc-services-list__heading {
    position: sticky;
    top: 100px;
  }

  .tc-services-list__heading .section-title {
    margin-top: 16px;
    max-width: 14ch;
  }

  .tc-services-list__items {
    border-top: 1px solid var(--surface-subtle-border);
  }

  .tc-services-process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .tc-services-pricing {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .tc-services-pricing-note {
    margin-top: 40px;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 64ch;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .tc-services-faq {
    max-width: 920px;
  }

  .tc-services-faq__list {
    display: grid;
    gap: 12px;
  }

  .tc-services-cta {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .tc-services-cta__title {
    font-family: var(--font-title);
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    font-weight: var(--fw-headline);
    text-transform: none;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .tc-services-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--text-nav);
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .tc-services-list {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .tc-services-list__heading {
      position: static;
    }

    .tc-services-process {
      grid-template-columns: repeat(2, 1fr);
    }

    .tc-services-pricing {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .tc-services-process {
      grid-template-columns: 1fr;
    }
  }
</style>
