---
import { withBase } from '../lib/base.ts';

interface Props {
  label: string;
  href?: string;
  className?: string;
  variant?: 'light' | 'dark';
}

const { label, href = '/', className = '', variant = 'light' } = Astro.props;
const resolvedHref = withBase(href);
---

<a
  href={resolvedHref}
  class={`ds-brand-logo ds-brand-logo--${variant} ${className}`.trim()}
  aria-label={label}
>
  <span class="ds-brand-logo__mark" aria-hidden="true"></span>
  <span class="ds-brand-logo__label">{label}</span>
</a>

<style>
  .ds-brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    transition: opacity var(--transition);
  }

  .ds-brand-logo--dark {
    color: var(--bg-dark);
  }

  .ds-brand-logo:hover {
    opacity: 0.78;
  }

  .ds-brand-logo__mark {
    display: inline-block;
    width: 14px;
    height: 14px;
    background: var(--brand-primary);
    border-radius: 999px;
    transform: translateY(-1px);
  }

  .ds-brand-logo__label {
    line-height: 1;
  }

  @media (max-width: 768px) {
    .ds-brand-logo {
      font-size: 0.95rem;
      gap: 10px;
    }

    .ds-brand-logo__mark {
      width: 12px;
      height: 12px;
    }
  }
</style>
