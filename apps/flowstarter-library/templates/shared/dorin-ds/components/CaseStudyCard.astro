---
import { withBase } from '../lib/base.ts';

interface Props {
  title: string;
  category: string;
  color?: string;
  imageSrc?: string;
  imageScale?: number;
  href?: string;
  className?: string;
  index?: string;
}

const {
  title,
  category,
  color = 'var(--surface-subtle)',
  imageSrc,
  imageScale = 1,
  href = '#',
  className = '',
  index,
} = Astro.props;
const resolvedHref = withBase(href);
---

<a href={resolvedHref} class={`ds-case-card ${className}`.trim()}>
  <div
    class="ds-case-card__image"
    style={imageSrc ? undefined : `background-color: ${color};`}
  >
    {
      imageSrc && (
        <img
          class="ds-case-card__media"
          src={imageSrc}
          alt={title}
          loading="lazy"
          style={`transform: scale(${imageScale});`}
        />
      )
    }
    {index && <span class="ds-case-card__index">{index}</span>}
  </div>
  <div class="ds-case-card__info">
    <div class="ds-case-card__title-row">
      <h3 class="ds-case-card__title">{title}</h3>
      <span class="ds-case-card__headline-arrow" aria-hidden="true">↗</span>
    </div>
    <span class="ds-case-card__category">{category}</span>
  </div>
</a>

<style>
  .ds-case-card {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition);
  }

  .ds-case-card:hover {
    transform: translateY(-6px);
  }

  .ds-case-card__image {
    aspect-ratio: 161 / 140;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .ds-case-card__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: center;
    transition: transform 0.6s var(--ease-emphasized);
  }

  .ds-case-card:hover .ds-case-card__media {
    transform: scale(1.04) !important;
  }

  .ds-case-card__index {
    position: absolute;
    top: 16px;
    left: 16px;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--bg-dark);
    background: var(--surface-base);
    padding: 4px 10px;
  }

  .ds-case-card__info {
    padding: 18px 4px 4px;
  }

  .ds-case-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .ds-case-card__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--transition);
    line-height: 1.1;
  }

  .ds-case-card:hover .ds-case-card__title {
    text-decoration-color: var(--bg-dark);
  }

  .ds-case-card__headline-arrow {
    font-size: 1.5rem;
    color: var(--bg-dark);
    line-height: 1;
    flex-shrink: 0;
    transition: transform var(--transition);
  }

  .ds-case-card:hover .ds-case-card__headline-arrow {
    transform: translate(2px, -2px);
  }

  .ds-case-card__category {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
</style>
