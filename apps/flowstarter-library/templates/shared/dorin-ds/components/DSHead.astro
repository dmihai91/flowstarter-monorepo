---
import { withBase } from '../lib/base.ts';

type FontPair =
  | 'clash-inter'
  | 'fraunces-inter'
  | 'manrope-anton'
  | 'space-grotesk-jet'
  | 'cormorant-inter';

interface Props {
  title: string;
  description?: string;
  fontPair?: FontPair;
}

const { title, description = '', fontPair = 'clash-inter' } = Astro.props;

// Build the Google Fonts <link> URL based on the chosen pair.
const googleFontsHref = (() => {
  switch (fontPair) {
    case 'fraunces-inter':
      return 'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap';
    case 'manrope-anton':
      return 'https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap';
    case 'space-grotesk-jet':
      return 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap';
    case 'cormorant-inter':
      return 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap';
    case 'clash-inter':
    default:
      return 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap';
  }
})();

// Clash Grotesk is hosted by Fontshare, not Google. Only load it when needed.
const includesClash = fontPair === 'clash-inter';

const faviconHref = withBase('/favicon.svg');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{description && <meta name="description" content={description} />}
<link rel="icon" type="image/svg+xml" href={faviconHref} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{includesClash && <link rel="preconnect" href="https://api.fontshare.com" crossorigin />}
<link href={googleFontsHref} rel="stylesheet" />
{
  includesClash && (
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@400,500,600,700&display=swap"
      rel="stylesheet"
    />
  )
}
<script is:inline>
  document.documentElement.classList.add('js');
  try {
    const stored = localStorage.getItem('theme');
    if (stored === 'dark') {
      document.documentElement.classList.add('theme-dark');
    } else if (stored === 'light') {
      document.documentElement.classList.add('theme-light');
    }
  } catch (_) {
    /* localStorage may be unavailable */
  }
</script>
<title>{title}</title>
