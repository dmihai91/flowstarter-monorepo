---
interface Props {
  text: string;
  enabled?: boolean;
}

const { text, enabled = true } = Astro.props;
---

{
  enabled && (
    <div class="ds-hero-intro" aria-hidden="true">
      <span class="ds-hero-intro__text">{text}</span>
    </div>
  )
}

<style>
  .ds-hero-intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--bg-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 clamp(20px, 5vw, 80px);
    pointer-events: none;
    animation: ds-hero-intro-exit 600ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: 1100ms;
  }

  .ds-hero-intro__text {
    font-family: var(--font-title);
    font-weight: var(--fw-headline);
    text-transform: var(--title-text-transform, uppercase);
    letter-spacing: var(--title-tracking, -0.03em);
    color: var(--text-on-dark);
    text-align: center;
    line-height: var(--title-line-height, 1.05);
    font-size: clamp(3rem, 11vw, 10rem);
    opacity: 0;
    animation: ds-hero-intro-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 80ms;
  }

  @keyframes ds-hero-intro-enter {
    from {
      opacity: 0;
      filter: blur(24px);
      transform: scale(0.88);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  @keyframes ds-hero-intro-exit {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-hero-intro,
    .ds-hero-intro__text {
      animation: none;
      display: none;
    }
  }
</style>
