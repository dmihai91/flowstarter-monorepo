---
import { withBase } from '../lib/base.ts';

interface Props {
  name: string;
  price: string;
  cadence?: string;
  description?: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  featured?: boolean;
  className?: string;
}

const {
  name,
  price,
  cadence = '',
  description = '',
  features,
  ctaLabel,
  ctaHref,
  featured = false,
  className = '',
} = Astro.props;
const resolvedCtaHref = withBase(ctaHref);
---

<div
  class={`ds-pricing-card ${featured ? 'ds-pricing-card--featured' : ''} ${className}`.trim()}
>
  {
    featured && (
      <span class="ds-pricing-card__badge">Most popular</span>
    )
  }
  <div class="ds-pricing-card__head">
    <h3 class="ds-pricing-card__name">{name}</h3>
    {description && <p class="ds-pricing-card__desc">{description}</p>}
  </div>
  <div class="ds-pricing-card__price">
    <span class="ds-pricing-card__amount">{price}</span>
    {cadence && <span class="ds-pricing-card__cadence">{cadence}</span>}
  </div>
  <ul class="ds-pricing-card__features">
    {
      features.map((f) => (
        <li class="ds-pricing-card__feature">
          <span class="ds-pricing-card__check" aria-hidden="true">
            ─
          </span>
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  <a
    href={resolvedCtaHref}
    class={`ds-pricing-card__cta ${featured ? 'ds-pricing-card__cta--featured' : ''}`}
  >
    {ctaLabel}
  </a>
</div>

<style>
  .ds-pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 40px 32px;
    background: var(--surface-base);
    border: 1px solid var(--surface-subtle-border);
    border-radius: var(--radius-lg);
    transition:
      transform var(--transition),
      border-color var(--transition);
  }

  .ds-pricing-card:hover {
    transform: translateY(-4px);
    border-color: var(--bg-dark);
  }

  .ds-pricing-card--featured {
    background: var(--bg-dark);
    border-color: var(--bg-dark);
    color: var(--text-on-dark);
  }

  .ds-pricing-card--featured .ds-pricing-card__name,
  .ds-pricing-card--featured .ds-pricing-card__amount {
    color: var(--text-on-dark);
  }

  .ds-pricing-card--featured .ds-pricing-card__desc,
  .ds-pricing-card--featured .ds-pricing-card__cadence,
  .ds-pricing-card--featured .ds-pricing-card__feature {
    color: var(--text-nav);
  }

  .ds-pricing-card__badge {
    position: absolute;
    top: -14px;
    left: 32px;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    background: var(--brand-primary);
    color: var(--bg-dark);
    padding: 6px 14px;
    border-radius: 0;
  }

  .ds-pricing-card__name {
    font-family: var(--font-title);
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    margin-bottom: 8px;
  }

  .ds-pricing-card__desc {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 36ch;
  }

  .ds-pricing-card__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--surface-subtle-border);
  }

  .ds-pricing-card--featured .ds-pricing-card__price {
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }

  .ds-pricing-card__amount {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--bg-dark);
  }

  .ds-pricing-card__cadence {
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ds-pricing-card__features {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ds-pricing-card__feature {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 12px;
    align-items: flex-start;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--text-primary);
  }

  .ds-pricing-card__check {
    color: var(--brand-primary);
    font-weight: var(--fw-bold);
    line-height: 1.5;
  }

  .ds-pricing-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    margin-top: auto;
    font-family: var(--font-button);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 2px solid var(--bg-dark);
    color: var(--bg-dark);
    background: transparent;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .ds-pricing-card__cta:hover {
    background: var(--bg-dark);
    color: var(--text-on-dark);
  }

  .ds-pricing-card__cta--featured {
    border-color: var(--brand-primary);
    background: var(--brand-primary);
    color: var(--bg-dark);
  }

  .ds-pricing-card__cta--featured:hover {
    background: var(--text-on-dark);
    color: var(--bg-dark);
    border-color: var(--text-on-dark);
  }
</style>
