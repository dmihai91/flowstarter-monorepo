---
interface Props {
  number: string;
  label: string;
  className?: string;
  align?: 'center' | 'left';
}

const { number, label, className = '', align = 'center' } = Astro.props;
---

<div
  class={`ds-stat-item ds-stat-item--${align} ${className}`.trim()}
>
  <span
    class="ds-stat-item__number"
    data-stat-number
    data-target={number}
  >
    {number}
  </span>
  <span class="ds-stat-item__label">{label}</span>
</div>

<style>
  .ds-stat-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ds-stat-item--center {
    align-items: center;
    text-align: center;
  }

  .ds-stat-item--left {
    align-items: flex-start;
    text-align: left;
  }

  .ds-stat-item__number {
    display: inline-block;
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--bg-dark);
    transform: translateY(18px);
    opacity: 0;
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 500ms ease;
  }

  .ds-stat-item__number.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  html:not(.js) .ds-stat-item__number {
    transform: translateY(0);
    opacity: 1;
  }

  .ds-stat-item__label {
    font-size: var(--fs-body);
    line-height: 1.4;
    color: var(--bg-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-stat-item__number {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }
</style>
