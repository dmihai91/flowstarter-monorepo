---
interface Props {
  quote: string;
  author: string;
  role?: string;
  result?: string;
  initials?: string;
  className?: string;
  layout?: 'inline' | 'spotlight';
}

const {
  quote,
  author,
  role,
  result,
  initials,
  className = '',
  layout = 'inline',
} = Astro.props;

const computedInitials =
  initials ??
  author
    .split(' ')
    .map((part) => part[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<figure
  class={`ds-testimonial ds-testimonial--${layout} ${className}`.trim()}
>
  <p class="ds-testimonial__quote">"{quote}"</p>
  <figcaption class="ds-testimonial__caption">
    <span class="ds-testimonial__avatar" aria-hidden="true">
      {computedInitials}
    </span>
    <span class="ds-testimonial__meta">
      <span class="ds-testimonial__author">{author}</span>
      {role && <span class="ds-testimonial__role">{role}</span>}
    </span>
    {result && <span class="ds-testimonial__result">{result}</span>}
  </figcaption>
</figure>

<style>
  .ds-testimonial {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 36px 32px;
    background: var(--surface-base);
    border: 1px solid var(--surface-subtle-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition),
      transform var(--transition);
  }

  .ds-testimonial:hover {
    border-color: var(--bg-dark);
    transform: translateY(-2px);
  }

  .ds-testimonial--spotlight {
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border-color: var(--bg-dark);
    padding: 56px 48px;
  }

  .ds-testimonial__quote {
    font-family: var(--font-title);
    font-size: var(--fs-h5);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--bg-dark);
    letter-spacing: -0.01em;
  }

  .ds-testimonial--spotlight .ds-testimonial__quote {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    color: var(--text-on-dark);
  }

  .ds-testimonial__caption {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--surface-subtle-border);
  }

  .ds-testimonial--spotlight .ds-testimonial__caption {
    border-top-color: rgba(255, 255, 255, 0.16);
  }

  .ds-testimonial__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--brand-primary);
    color: var(--bg-dark);
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.5px;
  }

  .ds-testimonial__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ds-testimonial__author {
    font-family: var(--font-title);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
    line-height: 1.2;
  }

  .ds-testimonial--spotlight .ds-testimonial__author {
    color: var(--text-on-dark);
  }

  .ds-testimonial__role {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.2;
  }

  .ds-testimonial--spotlight .ds-testimonial__role {
    color: var(--text-nav);
  }

  .ds-testimonial__result {
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--brand-primary);
    text-align: right;
    max-width: 14ch;
    line-height: 1.3;
  }

  @media (max-width: 600px) {
    .ds-testimonial__caption {
      grid-template-columns: 44px 1fr;
      grid-template-rows: auto auto;
      gap: 12px;
    }
    .ds-testimonial__result {
      grid-column: 1 / -1;
      text-align: left;
      max-width: none;
      padding-top: 12px;
      border-top: 1px solid var(--surface-subtle-border);
    }
    .ds-testimonial--spotlight .ds-testimonial__result {
      border-top-color: rgba(255, 255, 255, 0.16);
    }
  }
</style>
