---
import '../../../shared/dorin-ds/tokens.css';
import '../../../shared/dorin-ds/reset.css';
import DSHead from '../../../shared/dorin-ds/components/DSHead.astro';
import Header from '../../../shared/dorin-ds/components/Header.astro';
import Footer from '../../../shared/dorin-ds/components/Footer.astro';
import ContactScript from '../../../shared/ContactScript.astro';
import { frontmatter as contactFormData } from '../../content/integrations/contact-form.md';

interface Props {
  title?: string;
  description?: string;
  activeIndex?: number;
}

interface ContactFormContent {
  action_url?: string | null;
  success_message?: string | null;
}

const {
  title = 'Sarah Mitchell, LMFT — Licensed Marriage & Family Therapist',
  description = 'Compassionate, evidence-based therapy for individuals, couples, and families in the San Francisco Bay Area. Licensed Marriage & Family Therapist.',
  activeIndex = -1,
} = Astro.props;

const contactForm = contactFormData as ContactFormContent;
const contactFormActionUrl =
  typeof contactForm.action_url === 'string' ? contactForm.action_url : '';
const contactFormSuccessMessage =
  typeof contactForm.success_message === 'string'
    ? contactForm.success_message
    : "Thank you. I'll respond within 24 hours — all communications are confidential.";

const navLinks = [
  { label: 'Practice', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Contact', href: '/contact' },
];

const footerColumns = [
  {
    heading: 'Practice',
    links: [
      { label: 'Individual therapy', href: '/services#individual' },
      { label: 'Couples & family', href: '/services#couples' },
      { label: 'Trauma & EMDR', href: '/services#trauma' },
      { label: 'Teletherapy', href: '/services#tele' },
      { label: 'Pricing', href: '/pricing' },
    ],
  },
  {
    heading: 'About',
    links: [
      { label: 'My approach', href: '/about#approach' },
      { label: 'Credentials', href: '/about#credentials' },
      { label: 'FAQ', href: '/services#faq' },
    ],
  },
  {
    heading: 'Get in touch',
    links: [
      { label: 'Schedule a consultation', href: '/contact' },
      {
        label: 'hello@sarahmitchell-lmft.com',
        href: 'mailto:hello@sarahmitchell-lmft.com',
      },
      { label: '(415) 555-0184', href: 'tel:+14155550184' },
    ],
  },
];

const socials = [
  {
    href: '#',
    ariaLabel: 'LinkedIn',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  },
  {
    href: '#',
    ariaLabel: 'Psychology Today',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 0-7 7c0 2.6 1.4 4.9 3.5 6.1V20l3.5-2 3.5 2v-4.9C17.6 13.9 19 11.6 19 9a7 7 0 0 0-7-7Z"/></svg>',
  },
  {
    href: '#',
    ariaLabel: 'Email',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
  },
];
---

<!doctype html>
<html lang="en" data-template="therapist-care">
  <head>
    <DSHead title={title} description={description} fontPair="fraunces-source" />
    <script is:inline>
      // Flowstarter preview iframe bridge
      (function () {
        if (window.self === window.top) return;
        document.documentElement.classList.add('fs-preview');
        window.parent.postMessage(
          { source: 'fs-template', type: 'ready' },
          '*',
        );
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.source !== 'fs-preview') return;
          var d = e.data;
          var root = document.documentElement;
          if (d.type === 'setTheme') {
            root.classList.toggle('theme-dark', d.value === 'dark');
            try {
              localStorage.setItem('theme', d.value);
            } catch (_) {}
          } else if (d.type === 'setPalette') {
            if (d.dark !== undefined) {
              root.classList.toggle('theme-dark', !!d.dark);
            }
            if (d.vars) {
              Object.keys(d.vars).forEach(function (k) {
                root.style.setProperty(k, d.vars[k]);
              });
            }
          } else if (d.type === 'setFont') {
            var existing = document.getElementById('fs-font-override');
            if (existing) existing.remove();
            if (d.url) {
              var link = document.createElement('link');
              link.id = 'fs-font-override';
              link.rel = 'stylesheet';
              link.href = d.url;
              document.head.appendChild(link);
            }
            if (d.heading)
              root.style.setProperty('--font-title', d.heading);
            if (d.body) root.style.setProperty('--font-body', d.body);
          }
        });
      })();
    </script>
  </head>
  <body>
    <Header
      brandLabel="Sarah Mitchell, LMFT"
      links={navLinks}
      ctaLabel="Schedule a consultation"
      ctaHref="/contact"
      activeIndex={activeIndex}
    />
    <main class="ds-main">
      <slot />
    </main>
    <Footer
      brandLabel="Sarah Mitchell, LMFT"
      tagline="Compassionate, evidence-based psychotherapy for individuals, couples, and families navigating life's most difficult chapters."
      columns={footerColumns}
      socials={socials}
      copyrightSuffix="Sarah Mitchell, LMFT. All rights reserved. License #87654."
    />
    <ContactScript
      actionUrl={contactFormActionUrl}
      successMessage={contactFormSuccessMessage}
      templateName="therapist-care"
    />

    <style is:global>
      .ds-main {
        padding-top: 72px;
      }
    </style>
  </body>
</html>
