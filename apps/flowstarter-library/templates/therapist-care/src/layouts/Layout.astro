---
import DSHead from '../../../shared/dorin-ds/components/DSHead.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Elena Marin Therapy — Psychotherapy in Barcelona & online',
  description = 'Individual and couples therapy for anxiety, burnout, grief, and life transitions. Calm, evidence-based, and without jargon. In person in Barcelona and online across Spain.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <DSHead title={title} description={description} fontPair="fraunces-source" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t || t === 'system') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          }
          document.documentElement.classList.toggle('theme-dark', t === 'dark');
          document.documentElement.classList.toggle('dark', t === 'dark');
        } catch (_) {}
      })();
    </script>
    <script is:inline>
      (function () {
        if (window.self === window.top) return;
        var root = document.documentElement;
        root.classList.add('fs-preview');
        try {
          window.parent.postMessage({ source: 'fs-template', type: 'ready' }, '*');
        } catch (_) {}
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.source !== 'fs-preview') return;
          if (e.data.type === 'setTheme') {
            var dark = e.data.value === 'dark';
            root.classList.toggle('theme-dark', dark);
            root.classList.toggle('dark', dark);
            try { localStorage.setItem('theme', e.data.value); } catch (_) {}
          }
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
