---
import Layout from '../layouts/Layout.astro';

const nav = [
  { label: 'How I help', href: '#help' },
  { label: 'How it works', href: '#works' },
  { label: 'Fees', href: '#fees' },
  { label: 'Questions', href: '#faq' },
  { label: 'Contact', href: '#contact' },
];

const help = [
  {
    t: 'Anxiety',
    b: 'The racing thoughts, the tight chest, the sense of always bracing for something. We slow it down and find what helps you feel steadier, day to day.',
  },
  {
    t: 'Trauma',
    b: 'Careful, paced, trauma-informed work, including EMDR when it genuinely fits. Nothing is rushed, and you stay in control of how far we go.',
  },
  {
    t: 'Relationships',
    b: 'Recurring conflict, distance, the same argument on a loop. A calm space to understand the patterns and find a gentler way to be together.',
  },
  {
    t: 'Burnout',
    b: 'For people who look fine on the outside but feel quietly depleted. We make room to rest, set limits, and reconnect with what matters to you.',
  },
];

const steps = [
  {
    n: '1',
    t: 'Reach out',
    b: 'Send a short message about what is going on. There is no form to fill in and nothing you need to figure out first.',
  },
  {
    n: '2',
    t: 'A free first call',
    b: 'We talk for 15 minutes, no charge, so you can get a feel for me and ask anything. No pressure to book after.',
  },
  {
    n: '3',
    t: 'Ongoing sessions',
    b: 'If it feels right, we meet weekly, in person in Barcelona or online. We go at a pace that suits you.',
  },
];

const faqs = [
  {
    q: 'How long does therapy take?',
    a: 'It depends on what you are bringing and what you are hoping for. Some people come for a few months around a specific difficulty, others stay longer. We review how things are going together, and you are free to stop whenever you like.',
  },
  {
    q: 'In person or online?',
    a: 'Both. I see people in person at my practice in Barcelona, and online across Spain. Online sessions work well for most things, and we can always mix the two.',
  },
  {
    q: 'Is what I say kept private?',
    a: 'Yes. Everything we talk about is confidential. I will only ever break that in the rare situations where there is a serious risk to your safety or someone else, and I would talk it through with you first.',
  },
  {
    q: 'What if I am not sure therapy is for me?',
    a: 'That is completely normal, and the free first call is there for exactly this. There is no commitment, and if I am not the right fit I am glad to point you toward someone who might be.',
  },
];
---

<Layout>
  <header class="nav">
    <a href="#top" class="brand"><span class="brand__dot" aria-hidden="true"></span>Elena&nbsp;Marin</a>
    <nav class="nav__links" aria-label="Primary">
      {nav.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>
    <div class="nav__right">
      <button type="button" class="themer" data-themer aria-label="Toggle theme">
        <svg class="ic ic-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
        <svg class="ic ic-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <a href="#contact" class="btn btn--sm">Book a first call</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <p class="eyebrow reveal">Psychotherapy in Barcelona &amp; online</p>
      <h1 class="hero__title reveal" style="--d:.06s">A calmer place<br />to <em>begin again.</em></h1>
      <p class="hero__lede reveal" style="--d:.14s">
        I'm Elena, a psychotherapist. I work with anxiety, trauma, relationships,
        and burnout, gently and at the pace that feels right for you.
      </p>
      <div class="hero__cta reveal" style="--d:.2s">
        <a href="#contact" class="btn btn--lg">Book a first call</a>
        <a href="#works" class="link-soft">How it works</a>
      </div>
      <figure class="hero__plate reveal" style="--d:.26s">
        <img src="https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=1500&h=940&fit=crop" alt="Soft morning light through green leaves and flowers" loading="eager" />
      </figure>
    </section>

    <!-- HOW I CAN HELP -->
    <section class="section" id="help">
      <div class="block-head reveal">
        <p class="eyebrow">How I can help</p>
        <h2 class="h2">Whatever brought you here,<br />you don't have to hold it alone.</h2>
      </div>
      <div class="cards">
        {help.map((h, i) => (
          <article class="card reveal" style={`--d:${i * 0.07}s`}>
            <span class="card__mark" aria-hidden="true"></span>
            <h3 class="card__t">{h.t}</h3>
            <p class="card__b">{h.b}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- HOW SESSIONS WORK -->
    <section class="section steps-wrap" id="works">
      <div class="block-head block-head--center reveal">
        <p class="eyebrow">How sessions work</p>
        <h2 class="h2">A gentle way to start.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i * 0.09}s`}>
            <span class="step__n">{s.n}</span>
            <h3 class="step__t">{s.t}</h3>
            <p class="step__b">{s.b}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ABOUT / PORTRAIT -->
    <section class="section about">
      <figure class="about__img reveal">
        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=1000&h=1200&fit=crop" alt="Elena Marin, psychotherapist" loading="lazy" />
      </figure>
      <div class="about__copy reveal" style="--d:.1s">
        <p class="eyebrow">A little about me</p>
        <h2 class="h2">I listen first,<br />and we move at the speed of trust.</h2>
        <p>
          The early sessions are about getting to know you, not following a
          script. Your history, what you have already tried, how the trouble
          shows up in an ordinary week. We go slowly enough for the work to
          actually settle.
        </p>
        <p>
          I draw on a few different approaches, cognitive and somatic work,
          EMDR, and attachment-based thinking, but the work always follows the
          person in front of me, never the other way around.
        </p>
        <p class="sig">— Elena</p>
      </div>
    </section>

    <!-- FEES -->
    <section class="section fees" id="fees">
      <div class="block-head block-head--center reveal">
        <p class="eyebrow">Fees</p>
        <h2 class="h2">Simple, transparent.</h2>
      </div>
      <div class="fees__card reveal">
        <div class="fees__price">
          <span class="fees__num">from €80</span>
          <span class="fees__unit">/ 50-minute session</span>
        </div>
        <p class="fees__line">The first call is a free 15-minute conversation, with no obligation to book.</p>
        <p class="fees__line">A few reduced-fee places open up each season on a sliding scale. If cost is a barrier, please just say so on our call, it stays between us.</p>
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section class="quote reveal">
      <p class="quote__eyebrow">In her words</p>
      <blockquote>I didn't need someone to perform empathy at me. I needed a calm, steady place to untangle what had been building for years. That is what these sessions have been.</blockquote>
      <cite>Laura, in therapy since 2024</cite>
    </section>

    <!-- FAQ -->
    <section class="section faq" id="faq">
      <div class="block-head block-head--center reveal">
        <p class="eyebrow">A few questions</p>
        <h2 class="h2">In case you're wondering.</h2>
      </div>
      <div class="faq__list">
        {faqs.map((f, i) => (
          <details class="faq__item reveal" style={`--d:${i * 0.05}s`} open={i === 0}>
            <summary class="faq__q">{f.q}<span class="faq__sign" aria-hidden="true"></span></summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact">
      <div class="contact__inner reveal">
        <p class="eyebrow eyebrow--accent">A free 15-minute call</p>
        <h2 class="contact__title">Ready, when you are.</h2>
        <p class="contact__lede">
          The first conversation is unhurried and confidential, with no pressure
          to commit. Tell me a little about what's going on, and we'll see
          together whether this is the right room for the work.
        </p>
        <div class="contact__actions">
          <a href="mailto:hello@elenamarintherapy.com" class="btn btn--lg">Book a first call</a>
          <a href="tel:+34611482903" class="link-soft">+34 611 482 903</a>
        </div>
        <p class="contact__note">In person in Barcelona, or online across Spain.</p>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot__top">
      <span class="foot__brand"><span class="brand__dot" aria-hidden="true"></span>Elena&nbsp;Marin</span>
      <nav class="foot__links" aria-label="Footer">
        <a href="#help">How I help</a>
        <a href="#works">How it works</a>
        <a href="#fees">Fees</a>
        <a href="#faq">Questions</a>
        <a href="mailto:hello@elenamarintherapy.com">Email</a>
      </nav>
    </div>
    <div class="foot__base">
      <span>© 2026 Elena Marin, psychotherapist</span>
      <span>Barcelona, Spain · Online across Spain</span>
    </div>
  </footer>

  <script is:inline>
    (function () { var b = document.querySelector('[data-themer]'); if (b) b.addEventListener('click', function () { var d = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', d); document.documentElement.classList.toggle('dark', d); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (_) {} }); })();
    (function () { var els = document.querySelectorAll('.reveal'); if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; } var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.1 }); els.forEach(function (e) { io.observe(e); }); })();
  </script>

  <style is:global>
    /* DARK is the default on :root; LIGHT overrides when no theme-dark/dark class. */
    :root {
      --bg: #14181a; --bg-2: #191e1f; --surface: #1d2422;
      --ink: #edf0e9; --ink-soft: #cdd4c9; --muted: #93a094;
      --accent: #88ac96; --accent-2: #a3c4ae;
      --clay: #c79e89;
      --line: rgba(237,240,233,0.13); --line-soft: rgba(237,240,233,0.07);
      --shadow: 0 40px 90px -40px rgba(0,0,0,0.7);
      --serif: 'Fraunces','Cormorant Garamond',Georgia,serif;
      --sans: 'Source Sans 3','Inter',-apple-system,system-ui,sans-serif;
    }
    html:not(.theme-dark):not(.dark) {
      --bg: #f6f5f1; --bg-2: #efeee7; --surface: #fffefb;
      --ink: #2e3a33; --ink-soft: #4f5d52; --muted: #84907f;
      --accent: #7f9c86; --accent-2: #5d7d68;
      --clay: #c08e74;
      --line: rgba(46,58,51,0.13); --line-soft: rgba(46,58,51,0.07);
      --shadow: 0 40px 90px -45px rgba(46,58,51,0.32);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 17px; line-height: 1.68; -webkit-font-smoothing: antialiased; overflow-x: hidden; transition: background .6s ease, color .6s ease; }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    ::selection { background: var(--accent); color: var(--surface); }

    .reveal { opacity: 0; transform: translateY(22px); transition: opacity 1s cubic-bezier(.19,1,.22,1) var(--d,0s), transform 1s cubic-bezier(.19,1,.22,1) var(--d,0s); }
    .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

    /* TYPE */
    .eyebrow { font-size: .74rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin: 0 0 1.3rem; font-weight: 600; }
    .eyebrow--accent { color: var(--accent); }
    .h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.9rem,4vw,3rem); line-height: 1.12; letter-spacing: -.015em; margin: 0; font-optical-sizing: auto; }

    /* BUTTONS / LINKS */
    .btn { display: inline-flex; align-items: center; gap: .5rem; background: var(--accent); color: var(--surface); font-weight: 600; font-size: .94rem; padding: 1rem 1.7rem; border-radius: 100px; border: 1px solid var(--accent); transition: transform .3s, background .35s, border-color .35s; }
    .btn:hover { transform: translateY(-2px); background: var(--accent-2); border-color: var(--accent-2); }
    .btn--sm { padding: .62rem 1.15rem; font-size: .84rem; }
    .btn--lg { padding: 1.1rem 2.1rem; font-size: 1rem; }
    .link-soft { font-weight: 600; font-size: .94rem; color: var(--ink-soft); border-bottom: 1px solid var(--line); padding-bottom: 3px; transition: color .3s, border-color .3s; }
    .link-soft:hover { color: var(--accent); border-color: var(--accent); }

    /* NAV */
    .nav { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.1rem clamp(1.2rem,5vw,4rem); background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(16px) saturate(150%); -webkit-backdrop-filter: blur(16px) saturate(150%); border-bottom: 1px solid var(--line-soft); }
    .brand { font-family: var(--serif); font-size: 1.32rem; font-weight: 500; display: flex; align-items: center; gap: .55rem; letter-spacing: -.01em; }
    .brand__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); flex: none; }
    .nav__links { display: flex; gap: 1.9rem; }
    .nav__links a { font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); transition: color .25s; }
    .nav__links a:hover { color: var(--accent); }
    .nav__right { display: flex; align-items: center; gap: 1rem; }
    .themer { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; display: grid; place-items: center; transition: border-color .25s, color .25s; }
    .themer:hover { border-color: var(--accent); color: var(--accent); }
    .themer .ic { grid-area: 1 / 1; }
    .themer .ic-moon { display: none; }
    html.theme-dark .themer .ic-sun, html.dark .themer .ic-sun { display: none; }
    html.theme-dark .themer .ic-moon, html.dark .themer .ic-moon { display: block; }

    /* HERO */
    .hero { max-width: 920px; margin: 0 auto; padding: clamp(3.5rem,9vw,7rem) clamp(1.2rem,5vw,2rem) clamp(2rem,5vw,3rem); text-align: center; }
    .hero__title { font-family: var(--serif); font-weight: 380; font-size: clamp(2.8rem,8vw,5.6rem); line-height: 1.02; letter-spacing: -.025em; margin: 0 0 1.8rem; font-optical-sizing: auto; }
    .hero__title em { font-style: italic; color: var(--accent); font-weight: 400; }
    .hero__lede { font-size: clamp(1.1rem,2.2vw,1.3rem); color: var(--ink-soft); max-width: 46ch; margin: 0 auto 2.4rem; line-height: 1.55; }
    .hero__cta { display: flex; align-items: center; justify-content: center; gap: 1.6rem; flex-wrap: wrap; margin-bottom: clamp(2.5rem,6vw,4rem); }
    .hero__plate { margin: 0; }
    .hero__plate img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 28px; box-shadow: var(--shadow); filter: saturate(.97); }

    /* SECTION SHELL */
    .section { max-width: 1100px; margin: 0 auto; padding: clamp(3.5rem,8vw,7rem) clamp(1.2rem,5vw,2.5rem); }
    .block-head { max-width: 30ch; margin-bottom: clamp(2.2rem,4vw,3.2rem); }
    .block-head--center { margin-left: auto; margin-right: auto; text-align: center; max-width: 40ch; }

    /* HOW I CAN HELP — soft rounded cards */
    .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1rem,2vw,1.6rem); }
    .card { background: var(--surface); border: 1px solid var(--line-soft); border-radius: 24px; padding: clamp(1.8rem,3vw,2.6rem); transition: transform .4s cubic-bezier(.19,1,.22,1), box-shadow .4s; }
    .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
    .card__mark { display: block; width: 30px; height: 4px; border-radius: 4px; background: var(--accent); margin-bottom: 1.5rem; }
    .card__t { font-family: var(--serif); font-weight: 420; font-size: 1.55rem; margin: 0 0 .7rem; letter-spacing: -.01em; }
    .card__b { color: var(--ink-soft); margin: 0; font-size: 1rem; }

    /* HOW SESSIONS WORK — 3 steps */
    .steps-wrap { }
    .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem,3vw,3rem); }
    .step { text-align: center; padding: 0 .5rem; }
    .step__n { display: inline-grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent); font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 1.3rem; }
    .step__t { font-family: var(--serif); font-weight: 420; font-size: 1.45rem; margin: 0 0 .7rem; letter-spacing: -.01em; }
    .step__b { color: var(--ink-soft); margin: 0; font-size: 1rem; max-width: 32ch; margin-inline: auto; }

    /* ABOUT */
    .about { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem,6vw,5rem); align-items: center; }
    .about__img { margin: 0; }
    .about__img img { width: 100%; aspect-ratio: 5/6; object-fit: cover; border-radius: 200px 200px 24px 24px; box-shadow: var(--shadow); filter: saturate(.97); }
    .about__copy p { color: var(--ink-soft); margin: 1.3rem 0 0; max-width: 54ch; }
    .about__copy .h2 { margin-bottom: .5rem; }
    .sig { font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--ink) !important; margin-top: 1.8rem !important; }

    /* FEES */
    .fees__card { max-width: 640px; margin: 0 auto; background: var(--surface); border: 1px solid var(--line-soft); border-radius: 28px; padding: clamp(2.2rem,4vw,3.4rem); text-align: center; box-shadow: var(--shadow); }
    .fees__price { display: flex; flex-direction: column; align-items: center; gap: .3rem; margin-bottom: 1.8rem; padding-bottom: 1.8rem; border-bottom: 1px solid var(--line-soft); }
    .fees__num { font-family: var(--serif); font-size: clamp(2.4rem,6vw,3.6rem); font-weight: 400; line-height: 1; letter-spacing: -.02em; }
    .fees__unit { font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
    .fees__line { color: var(--ink-soft); margin: 0 auto 1rem; max-width: 46ch; font-size: 1rem; }
    .fees__line:last-child { margin-bottom: 0; }

    /* TESTIMONIAL */
    .quote { max-width: 820px; margin: 0 auto; padding: clamp(3rem,7vw,6rem) clamp(1.2rem,5vw,2.5rem); text-align: center; }
    .quote__eyebrow { font-size: .74rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin: 0 0 1.6rem; font-weight: 600; }
    .quote blockquote { font-family: var(--serif); font-weight: 380; font-style: italic; font-size: clamp(1.5rem,3.4vw,2.4rem); line-height: 1.35; letter-spacing: -.01em; margin: 0 0 1.6rem; color: var(--ink); }
    .quote cite { font-style: normal; font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }

    /* FAQ */
    .faq__list { max-width: 760px; margin: 0 auto; }
    .faq__item { border-bottom: 1px solid var(--line-soft); }
    .faq__item:first-child { border-top: 1px solid var(--line-soft); }
    .faq__q { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.5rem .2rem; font-family: var(--serif); font-size: clamp(1.15rem,2.2vw,1.4rem); font-weight: 420; letter-spacing: -.01em; transition: color .25s; }
    .faq__q::-webkit-details-marker { display: none; }
    .faq__item:hover .faq__q { color: var(--accent); }
    .faq__sign { position: relative; flex: none; width: 16px; height: 16px; }
    .faq__sign::before, .faq__sign::after { content: ''; position: absolute; background: var(--accent); border-radius: 2px; transition: transform .3s, opacity .3s; }
    .faq__sign::before { top: 7px; left: 0; width: 16px; height: 2px; }
    .faq__sign::after { top: 0; left: 7px; width: 2px; height: 16px; }
    .faq__item[open] .faq__sign::after { transform: scaleY(0); opacity: 0; }
    .faq__a { color: var(--ink-soft); margin: 0 0 1.6rem; max-width: 60ch; font-size: 1rem; }

    /* CONTACT */
    .contact { padding: clamp(2rem,5vw,4rem) clamp(1.2rem,5vw,2.5rem) clamp(4rem,8vw,6rem); }
    .contact__inner { max-width: 900px; margin: 0 auto; background: var(--bg-2); border: 1px solid var(--line-soft); border-radius: 32px; padding: clamp(3rem,7vw,5.5rem) clamp(1.4rem,5vw,3rem); text-align: center; }
    .contact__title { font-family: var(--serif); font-weight: 380; font-size: clamp(2.2rem,6vw,4rem); line-height: 1.05; letter-spacing: -.025em; margin: 0 0 1.4rem; }
    .contact__lede { color: var(--ink-soft); max-width: 48ch; margin: 0 auto 2.4rem; font-size: 1.1rem; line-height: 1.55; }
    .contact__actions { display: flex; gap: 1.6rem; align-items: center; justify-content: center; flex-wrap: wrap; }
    .contact__note { color: var(--muted); font-size: .9rem; margin: 2rem 0 0; letter-spacing: .02em; }

    /* FOOTER */
    .foot { border-top: 1px solid var(--line-soft); max-width: 1100px; margin: 0 auto; padding: clamp(2.5rem,5vw,3.5rem) clamp(1.2rem,5vw,2.5rem) 2.4rem; }
    .foot__top { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; margin-bottom: 2.2rem; }
