---
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../../../shared/dorin-ds/components/SectionBlock.astro';
import Container from '../../../shared/dorin-ds/components/Container.astro';
import SectionHeading from '../../../shared/dorin-ds/components/SectionHeading.astro';
import OverlineText from '../../../shared/dorin-ds/components/OverlineText.astro';
import ActionButton from '../../../shared/dorin-ds/components/ActionButton.astro';
import ServiceCard from '../../../shared/dorin-ds/components/ServiceCard.astro';
import StatsRow from '../../../shared/dorin-ds/components/StatsRow.astro';
import NumberedFeatureItem from '../../../shared/dorin-ds/components/NumberedFeatureItem.astro';
import TestimonialBlock from '../../../shared/dorin-ds/components/TestimonialBlock.astro';
import FaqAccordionItem from '../../../shared/dorin-ds/components/FaqAccordionItem.astro';
import TagPill from '../../../shared/dorin-ds/components/TagPill.astro';
import HeroIntro from '../../../shared/dorin-ds/components/HeroIntro.astro';
import VideoBlock from '../../../shared/dorin-ds/components/VideoBlock.astro';
import CalBookingBlock from '../../../shared/dorin-ds/components/CalBookingBlock.astro';
import { frontmatter as servicesData } from '../../content/services.md';
import { frontmatter as testimonialsData } from '../../content/testimonials.md';
import { frontmatter as videoData } from '../../content/video.md';
import { frontmatter as bookingData } from '../../content/integrations/booking.md';

interface ServicesContent {
  title?: string;
  subtitle?: string;
  services?: Array<{
    icon?: string;
    title: string;
    description: string;
    price?: string;
  }>;
}

interface TestimonialsContent {
  title?: string;
  subtitle?: string;
  testimonials?: Array<{
    quote: string;
    author: string;
    role: string;
    result?: string;
  }>;
}

interface VideoContent {
  eyebrow?: string;
  title: string;
  duration?: string;
  caption?: string;
  poster?: string;
  src: string;
  aspect?: '21/9' | '16/9' | '4/3' | '1/1';
}

interface BookingContent {
  enabled?: boolean;
  cal_link?: string;
  cal_event_label?: string;
  cal_duration_label?: string;
  cal_layout?: 'month_view' | 'week_view' | 'column_view';
  title?: string;
  description?: string;
}

const servicesFm = servicesData as ServicesContent;
const testimonialsFm = testimonialsData as TestimonialsContent;
const videoFm = videoData as VideoContent;
const bookingFm = bookingData as BookingContent;

const heroStats = [
  { number: '15+', label: 'Years in practice' },
  { number: '1,200+', label: 'Clients supported' },
  { number: '92%', label: 'Client retention' },
  { number: '4.9', label: 'Average rating' },
];

// Hand-built SVG icons stay hardcoded so we don't try to render lucide names
// at runtime. Order pairs with services.md `services[]` by index.
const serviceIcons = [
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.5 4.04 3 5.5l7 7Z"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="3" y="5" rx="2"/><path d="m22 8-6 4 6 4Z"/></svg>',
];

const services = (servicesFm.services ?? []).map((service, index) => ({
  icon: serviceIcons[index] ?? serviceIcons[serviceIcons.length - 1],
  title: service.title,
  description: service.description,
  meta: service.price ?? '',
}));

const testimonials = testimonialsFm.testimonials ?? [];

const approach = [
  {
    number: '01',
    title: 'Listen first',
    description:
      'The opening sessions are about context, not protocols. I want to understand your history, what you have already tried, and how the trouble actually shows up in your week. We move slowly so the work has somewhere to root.',
  },
  {
    number: '02',
    title: 'Evidence-based, matched to you',
    description:
      'CBT, EMDR, attachment-based work, ACT, and mindfulness are tools I draw from — but the modality follows the person, never the other way around. We adjust together as we learn what is helping.',
  },
  {
    number: '03',
    title: 'Pace at trust',
    description:
      'Therapy moves at the speed of what feels safe. When the nervous system is bracing, we slow down. When readiness arrives, we lean in. Either is fine; both are part of the work.',
  },
  {
    number: '04',
    title: 'Whole-person care',
    description:
      'Mind, body, relationships, and context. Healing rarely lives in only one of them, so the work touches all of them — gently, and without pretending the other parts of your life are not there.',
  },
];

const faqs = [
  {
    question: 'What can I expect from the first session?',
    answer:
      "The first session is gentle — mostly your story, in your own words, at your own pace. I will ask about what brings you in, the history that feels relevant, and what you are hoping for. There is nothing to prepare. By the end, you will have a sense of how I work and whether I feel like the right fit.",
  },
  {
    question: 'How long does therapy usually last?',
    answer:
      'It depends on what you are bringing. Some clients feel meaningfully steadier after 8–12 sessions; others choose longer-term work because the questions are bigger or older. We review progress every few months together, and you are always free to pause, slow, or close out.',
  },
  {
    question: 'Do you accept insurance?',
    answer:
      "I am out-of-network for most insurance plans, but I provide superbills you can submit for partial reimbursement (typically 50–80%, depending on your plan). A small number of sliding-scale slots are available — please mention this on the consultation if relevant.",
  },
  {
    question: 'What is your cancellation policy?',
    answer:
      'I ask for 24 hours notice for cancellations. Sessions cancelled within 24 hours are billed at the full rate, except in genuine emergencies. The boundary keeps the work consistent and protects the time we have set aside for you.',
  },
  {
    question: 'Are virtual sessions just as effective?',
    answer:
      'For most concerns, yes — research and my own caseload both bear this out. Some kinds of trauma processing and somatic work are slightly stronger in person, and we can talk through which mode would suit you best on the consultation.',
  },
];

const credentials = [
  'Licensed Marriage & Family Therapist (LMFT #87654)',
  'EMDR Certified Therapist',
  'Masters in Clinical Psychology, Stanford University',
  'Member, California Association of Marriage and Family Therapists',
];
---

<Layout
  title="Sarah Mitchell, LMFT — Compassionate Therapy in the Bay Area"
  description="Compassionate, evidence-based therapy for individuals, couples, and families across the San Francisco Bay Area. Licensed Marriage & Family Therapist offering in-person and telehealth sessions."
  activeIndex={-1}
>
  <HeroIntro text="Sarah Mitchell, LMFT" />

  <!-- ─── Hero ──────────────────────────────────────────────── -->
  <SectionBlock id="home" tone="light" padding="hero" className="tc-hero">
    <Container className="tc-hero__inner">
      <div class="tc-hero__copy">
        <OverlineText text="LMFT · San Francisco Bay Area" tone="accent" />
        <h1 class="tc-hero__title">
          A considered space<br />
          to <span class="tc-hero__title-accent">begin again</span>.
        </h1>
        <p class="tc-hero__lede">
          I'm <strong>Sarah Mitchell</strong> — a licensed marriage and family
          therapist offering quietly held, evidence-based therapy for
          individuals, couples, and families across the Bay Area and
          throughout California by telehealth.
        </p>
        <div class="tc-hero__actions">
          <ActionButton
            href="/contact"
            label="Schedule a consultation"
            variant="primary"
            size="large"
          />
          <ActionButton
            href="/services"
            label="Explore the practice"
            variant="outline-dark"
            size="large"
          />
        </div>
        <div class="tc-hero__pills">
          <TagPill label="In-person & telehealth" />
          <TagPill label="Sliding scale available" />
          <TagPill label="EMDR certified" />
        </div>
      </div>

      <div class="tc-hero__plate" aria-hidden="true">
        <div class="tc-hero__plate-image"></div>
        <span class="tc-hero__index">№ 01 — Practice</span>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Stats ────────────────────────────────────────────── -->
  <SectionBlock tone="accent-light" padding="compact" topBorder>
    <Container>
      <StatsRow items={heroStats} />
    </Container>
  </SectionBlock>

  <!-- ─── About ────────────────────────────────────────────── -->
  <SectionBlock id="about" tone="light" padding="default">
    <Container className="tc-about">
      <div class="tc-about__heading">
        <OverlineText text="About" />
        <h2 class="section-title tc-about__title">
          Therapy held with<br />
          <em>care &amp; clarity</em>.
        </h2>
      </div>
      <div class="tc-about__body">
        <p class="tc-about__intro">
          For more than fifteen years I have sat with people through
          some of the most difficult chapters of their lives. The work is
          unhurried, considered, and grounded in what the research
          actually supports — but most of it lives in the room, between two
          people doing honest work.
        </p>
        <p class="tc-about__copy">
          I specialise in anxiety, trauma, grief, relationship repair,
          life transitions, and the quieter sense that something is off
          even when everything is technically fine. We will work at the
          pace that feels right to you, with as much structure or as much
          space as the moment needs.
        </p>
        <ul class="tc-about__credentials" id="credentials">
          {
            credentials.map((c) => (
              <li class="tc-about__credential">
                <span class="tc-about__credential-mark" aria-hidden="true">
                  ◆
                </span>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Services ─────────────────────────────────────────── -->
  <SectionBlock id="services" tone="subtle" padding="default" topBorder>
    <Container>
      <SectionHeading
        label="The practice"
        title="Six considered ways to work together."
        maxWidth="22ch"
      />
      <div class="tc-services-grid">
        {
          services.map((s) => (
            <ServiceCard
              icon={s.icon}
              title={s.title}
              description={s.description}
              meta={s.meta}
            />
          ))
        }
      </div>
      <div class="tc-services-cta">
        <ActionButton
          href="/services"
          label="See the full practice"
          variant="outline-dark"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Approach ─────────────────────────────────────────── -->
  <SectionBlock id="approach" tone="dark" padding="default">
    <Container className="tc-approach">
      <div class="tc-approach__heading">
        <OverlineText text="How I work" tone="accent" />
        <h2 class="section-title tc-approach__title">
          A gentle, evidence-based way of working.
        </h2>
      </div>
      <div class="tc-approach__list">
        {
          approach.map((a) => (
            <NumberedFeatureItem
              number={a.number}
              title={a.title}
              description={a.description}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Video ────────────────────────────────────────────── -->
  <SectionBlock id="invitation" tone="light" padding="default" topBorder>
    <Container className="tc-video">
      <VideoBlock
        src={videoFm.src}
        poster={videoFm.poster}
        title={videoFm.title}
        caption={videoFm.caption}
        eyebrow={videoFm.eyebrow}
        duration={videoFm.duration}
        aspect={videoFm.aspect ?? '16/9'}
      />
    </Container>
  </SectionBlock>

  <!-- ─── Testimonials ─────────────────────────────────────── -->
  <SectionBlock id="testimonials" tone="light" padding="default">
    <Container>
      <SectionHeading label="Stories from clients" title="Quiet, lasting work." />
      <div class="tc-testimonials">
        {
          testimonials.map((t) => (
            <TestimonialBlock
              quote={t.quote}
              author={t.author}
              role={t.role}
              result={t.result}
            />
          ))
        }
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── FAQ ──────────────────────────────────────────────── -->
  <SectionBlock id="faq" tone="light" padding="default" topBorder>
    <Container className="tc-faq">
      <SectionHeading label="Common questions" title="Before the first session." />
      <div class="tc-faq__list">
        {faqs.map((f) => <FaqAccordionItem question={f.question} answer={f.answer} />)}
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── CTA ──────────────────────────────────────────────── -->
  <SectionBlock id="contact" tone="dark" padding="default">
    <Container className="tc-cta">
      <h2 class="tc-cta__title">
        Ready, when you are.
      </h2>
      <p class="tc-cta__lede">
        The first conversation is a free 20-minute phone consultation —
        unhurried, confidential, and with no pressure to commit. Tell me
        what is going on, and we will see together whether this is the
        right room for the work.
      </p>
      <div class="tc-cta__actions">
        <ActionButton
          href="/contact"
          label="Schedule a consultation"
          variant="primary-light"
          size="large"
          className="fs-book-btn"
        />
        <ActionButton
          href="mailto:hello@sarahmitchell-lmft.com"
          label="Send a private email"
          variant="outline-light"
          size="large"
        />
      </div>
    </Container>
  </SectionBlock>

  <!-- ─── Direct booking ───────────────────────────────────── -->
  <SectionBlock tone="light" padding="default" topBorder>
    <Container>
      <CalBookingBlock
        variant="cta"
        calLink={bookingFm.cal_link}
        eventLabel={bookingFm.cal_event_label}
        title={bookingFm.title}
        subtitle={bookingFm.description}
        durationLabel={bookingFm.cal_duration_label}
        layout={bookingFm.cal_layout}
      />
    </Container>
  </SectionBlock>
</Layout>

<style>
  .tc-hero {
    position: relative;
    overflow: clip;
  }

  .tc-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 44%);
    gap: 64px;
    align-items: center;
    min-height: 76vh;
  }

  .tc-hero__copy {
    max-width: 620px;
  }

  .tc-hero__title {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: var(--fw-headline);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 24px 0 28px;
    color: var(--bg-dark);
  }

  .tc-hero__title-accent {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .tc-hero__lede {
    font-size: var(--fs-h5);
    line-height: 1.6;
    color: var(--text-primary);
    max-width: 540px;
    margin-bottom: 36px;
  }

  .tc-hero__lede strong {
    font-weight: var(--fw-semibold);
  }

  .tc-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .tc-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tc-hero__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tc-hero__plate-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=900&h=1100&fit=crop');
    background-size: cover;
    background-position: center 30%;
    filter: contrast(1.02) saturate(0.9);
    transition: transform 1.4s var(--ease-emphasized);
  }

  .tc-hero:hover .tc-hero__plate-image {
    transform: scale(1.02);
  }

  .tc-hero__index {
    position: absolute;
    top: 18px;
    left: 18px;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-on-dark);
    background: var(--bg-dark);
    padding: 6px 10px;
    z-index: 1;
  }

  .tc-about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 80px;
    align-items: start;
  }

  .tc-about__heading {
    position: sticky;
    top: 100px;
  }

  .tc-about__title {
    margin-top: 16px;
  }

  .tc-about__title em {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--brand-primary);
    text-transform: none;
    letter-spacing: -0.04em;
  }

  .tc-about__intro {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--bg-dark);
    margin-bottom: 24px;
    max-width: 56ch;
  }

  .tc-about__copy {
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--text-primary);
    max-width: 60ch;
    margin-bottom: 36px;
  }

  .tc-about__credentials {
    display: grid;
    gap: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--surface-subtle-border);
  }

  .tc-about__credential {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bg-dark);
  }

  .tc-about__credential-mark {
    color: var(--brand-primary);
    font-size: 0.8em;
    line-height: 1.5;
  }

  .tc-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .tc-services-cta {
    margin-top: 56px;
    text-align: center;
  }

  .tc-approach {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 80px;
  }

  .tc-approach__heading {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .tc-approach__title {
    color: var(--text-on-dark);
    margin-top: 16px;
    max-width: 18ch;
  }

  .tc-testimonials {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .tc-faq {
    max-width: 920px;
  }

  .tc-faq__list {
    display: grid;
    gap: 12px;
  }

  .tc-cta {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .tc-cta__title {
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: var(--fw-headline);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    margin-bottom: 28px;
  }

  .tc-cta__lede {
    font-size: var(--fs-h5);
    line-height: 1.55;
    color: var(--text-nav);
    margin-bottom: 40px;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }

  .tc-cta__actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .tc-hero__inner {
      grid-template-columns: 1fr;
      gap: 48px;
      min-height: auto;
    }

    .tc-hero__plate {
      aspect-ratio: 16 / 11;
      max-width: 720px;
    }

    .tc-about,
    .tc-approach {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .tc-about__heading,
    .tc-approach__heading {
      position: static;
    }

    .tc-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .tc-testimonials {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .tc-services-grid {
      grid-template-columns: 1fr;
    }

    .tc-hero__title {
      font-size: 2.5rem;
    }
  }
</style>
