---
import type { JourneyItem } from '../../lib/site-data';

interface Props {
  journey: {
    title: string;
    intro: string;
    items: JourneyItem[];
  };
}

const { journey } = Astro.props;
---

<section class="about-journey-section container">
  <div class="about-journey-section__intro" data-about-reveal>
    <h2 class="about-journey-section__title">{journey.title}</h2>
    <p class="about-journey-section__intro-text">{journey.intro}</p>
  </div>

  <ol class="about-journey-section__list" aria-label="Studio timeline">
    {journey.items.map((item, index) => (
      <li
        class="about-journey-section__row"
        data-about-reveal
        style={`--about-reveal-delay: ${index * 90}ms;`}
      >
        <div class="about-journey-section__year-col">
          <span class="about-journey-section__year">{item.year}</span>
          <span class="about-journey-section__index">{String(index + 1).padStart(2, '0')}</span>
        </div>
        <div class="about-journey-section__rail" aria-hidden="true">
          <span class="about-journey-section__dot"></span>
        </div>
        <div class="about-journey-section__body">
          <h3 class="about-journey-section__row-title">{item.title}</h3>
          <p class="about-journey-section__row-desc">{item.description}</p>
          <div class="about-journey-section__meta">
            {item.keyMoment && (
              <div class="about-journey-section__meta-item">
                <span class="about-journey-section__meta-label">Turning point</span>
                <span class="about-journey-section__meta-value">{item.keyMoment}</span>
              </div>
            )}
            {item.achievement && (
              <div class="about-journey-section__meta-item">
                <span class="about-journey-section__meta-label">What changed</span>
                <span class="about-journey-section__meta-value">{item.achievement}</span>
              </div>
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .about-journey-section {
    display: grid;
    gap: 64px;
    width: 100%;
  }

  .about-journey-section__intro {
    display: grid;
    gap: 18px;
    max-width: 640px;
  }

  .about-journey-section__title {
    color: var(--bg-dark);
    line-height: 1;
  }

  .about-journey-section__intro-text {
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.3vw, 1.22rem);
    line-height: 1.55;
  }

  .about-journey-section__list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--surface-panel-border);
  }

  .about-journey-section__row {
    display: grid;
    grid-template-columns: 168px 28px 1fr;
    gap: 0 32px;
    padding: 44px 0;
    border-bottom: 1px solid var(--surface-panel-border);
  }

  .about-journey-section__year-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about-journey-section__year {
    font-family: var(--font-title);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 340;
    font-style: italic;
    line-height: 1;
    color: var(--bg-dark);
  }

  .about-journey-section__index {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.22em;
    color: var(--signal);
  }

  .about-journey-section__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .about-journey-section__rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -44px;
    width: 1px;
    background: var(--surface-panel-border);
  }

  .about-journey-section__row:last-child .about-journey-section__rail::before {
    bottom: 0;
  }

  .about-journey-section__dot {
    position: relative;
    z-index: 1;
    width: 11px;
    height: 11px;
    margin-top: 8px;
    background: var(--signal);
    border-radius: 50%;
  }

  .about-journey-section__body {
    display: grid;
    gap: 16px;
    max-width: 46rem;
  }

  .about-journey-section__row-title {
    font-size: var(--fs-h3);
    font-weight: 360;
    color: var(--bg-dark);
    line-height: 1.12;
  }

  .about-journey-section__row-desc {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .about-journey-section__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 40px;
    margin-top: 6px;
    padding-top: 20px;
    border-top: 1px solid var(--surface-panel-border);
  }

  .about-journey-section__meta-item {
    display: grid;
    gap: 6px;
  }

  .about-journey-section__meta-label {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--signal);
  }

  .about-journey-section__meta-value {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--bg-dark);
  }

  @media (max-width: 768px) {
    .about-journey-section {
      gap: 40px;
    }

    .about-journey-section__row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 32px 0;
    }

    .about-journey-section__rail {
      display: none;
    }

    .about-journey-section__year-col {
      flex-direction: row;
      align-items: baseline;
      gap: 14px;
    }

    .about-journey-section__meta {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
