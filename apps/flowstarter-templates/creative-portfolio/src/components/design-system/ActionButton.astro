---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'outline';
  className?: string;
}

const { href, label, variant = 'primary', className = '' } = Astro.props;
const hasPrefix = Astro.slots.has('prefix');
const hasSuffix = Astro.slots.has('suffix');
---

<a
  href={href}
  class={`ds-action-button ds-action-button--${variant} ${hasPrefix || hasSuffix ? 'ds-action-button--adorned' : ''} ${className}`.trim()}
>
  {hasPrefix && (
    <span class="ds-action-button__prefix" aria-hidden="true">
      <slot name="prefix" />
    </span>
  )}
  <span class="ds-action-button__label">{label}</span>
  {hasSuffix && (
    <span class="ds-action-button__suffix" aria-hidden="true">
      <slot name="suffix" />
    </span>
  )}
</a>

<style>
  .ds-action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 0;
    border: 1px solid transparent;
    transition: opacity var(--transition), border-color var(--transition);
  }

  .ds-action-button--adorned {
    gap: 16px;
  }

  .ds-action-button__prefix,
  .ds-action-button__suffix {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ds-action-button--primary {
    background: var(--bg-dark);
    color: var(--text-on-dark);
  }

  .ds-action-button--primary-light {
    background: var(--text-on-dark);
    color: var(--bg-dark);
  }

  .ds-action-button--primary:hover {
    opacity: 0.85;
  }

  .ds-action-button--outline {
    --outline-fill: var(--text-primary);
    --outline-hover-text: var(--text-on-dark);
    border-width: 2px;
    border-style: solid;
    background-color: transparent;
    background-image: linear-gradient(var(--outline-fill), var(--outline-fill));
    background-repeat: no-repeat;
    background-position: left top;
    background-size: 0 100%;
    color: var(--outline-fill);
    border-color: var(--border-color);
    transition:
      color var(--transition),
      border-color var(--transition),
      background-size var(--transition);
  }

  .ds-action-button--outline-dark {
    --outline-fill: var(--bg-dark);
    --outline-hover-text: var(--text-on-dark);
    border-color: var(--bg-dark);
    color: var(--bg-dark);
  }

  .ds-action-button--outline-light {
    --outline-fill: var(--text-on-dark);
    --outline-hover-text: var(--bg-dark);
    border-color: var(--text-on-dark);
    color: var(--text-on-dark);
  }

  .ds-action-button--outline-thick {
    border-width: 2px;
  }

  .ds-action-button--weight-medium {
    font-weight: var(--fw-medium);
  }

  .ds-action-button--outline:hover {
    color: var(--outline-hover-text);
    border-color: var(--outline-fill);
    background-size: 100% 100%;
  }
</style>
