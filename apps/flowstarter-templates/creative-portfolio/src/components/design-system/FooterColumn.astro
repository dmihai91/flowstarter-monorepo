---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  heading: string;
  links: LinkItem[];
  className?: string;
}

const { heading, links, className = '' } = Astro.props;
---

<div class={`ds-footer-column ${className}`.trim()}>
  <h5 class="ds-footer-column__heading">{heading}</h5>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} class="ds-footer-column__link">{link.label}</a>
      </li>
    ))}
  </ul>
</div>

<style>
  .ds-footer-column__heading {
    font-size: var(--fs-h5);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-on-dark);
    margin-bottom: 20px;
  }

  .ds-footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ds-footer-column__link {
    font-size: var(--fs-small);
    /* Footer is a dark surface in both schemes; --text-nav is tuned for the
       light header and a palette may legally make it dark. Use on-dark ink. */
    color: var(--text-on-dark);
    transition: color var(--transition);
  }

  .ds-footer-column__link:hover {
    color: var(--accent);
  }
</style>
