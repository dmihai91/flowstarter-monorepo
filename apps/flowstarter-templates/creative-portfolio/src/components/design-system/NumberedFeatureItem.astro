---
interface Props {
  number: string;
  title: string;
  description: string;
  className?: string;
}

const { number, title, description, className = '' } = Astro.props;
---

<div class={`ds-numbered-feature ${className}`.trim()}>
  <span class="ds-numbered-feature__number">{number}</span>
  <div class="ds-numbered-feature__content">
    <h3 class="ds-numbered-feature__title">{title}</h3>
    <p class="ds-numbered-feature__desc">{description}</p>
  </div>
</div>

<style>
  .ds-numbered-feature {
    display: flex;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border-color);
    align-items: flex-start;
  }

  .ds-numbered-feature__number {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-weight: var(--fw-medium);
    min-width: 28px;
    padding-top: 2px;
  }

  .ds-numbered-feature__content {
    flex: 1;
    filter: none;
    opacity: 1;
    transition:
      opacity 260ms ease,
      transform 260ms ease;
    transform: translateX(0);
  }

  .ds-numbered-feature:hover .ds-numbered-feature__content,
  .ds-numbered-feature:focus-within .ds-numbered-feature__content {
    transform: translateX(8px);
  }

  .ds-numbered-feature:hover .ds-numbered-feature__desc,
  .ds-numbered-feature:focus-within .ds-numbered-feature__desc {
    color: var(--bg-dark);
  }

  .ds-numbered-feature__title {
    font-size: var(--fs-h3);
    font-weight: 360;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
    color: var(--bg-dark);
  }

  .ds-numbered-feature__desc {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-muted);
    transition: color 260ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-numbered-feature__content {
      transition: none;
      transform: none;
    }

    .ds-numbered-feature:hover .ds-numbered-feature__content,
    .ds-numbered-feature:focus-within .ds-numbered-feature__content {
      transform: none;
    }
  }
</style>
