---
interface Props {
  text: string;
  className?: string;
  tone?: 'primary' | 'secondary';
}

const { text, className = '', tone = 'primary' } = Astro.props;
---

<p class={`ds-overline-text ds-overline-text--${tone} ${className}`.trim()}>{text}</p>

<style>
  .ds-overline-text {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .ds-overline-text--primary {
    color: var(--text-primary);
  }

  .ds-overline-text--secondary {
    color: var(--text-primary);
  }
</style>
