---
interface Props {
  label: string;
  name: string;
  placeholder?: string;
  required?: boolean;
  rows?: number;
  className?: string;
}

const { label, name, placeholder = '', required = false, rows = 7, className = '' } = Astro.props;
---

<label class={`text-area-field ${className}`.trim()}>
  <span class="text-area-field__label">{label}</span>
  <textarea name={name} rows={rows} placeholder={placeholder} required={required}></textarea>
</label>

<style>
  .text-area-field {
    display: grid;
    gap: var(--form-field-gap, 10px);
  }

  .text-area-field__label {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    color: var(--bg-dark);
  }

  .text-area-field textarea {
    width: 100%;
    min-height: 180px;
    padding: 18px;
    border: 1px solid var(--surface-field-border);
    border-radius: 8px;
    background: var(--surface-field);
    color: var(--bg-dark);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 1.4;
    resize: vertical;
  }

  .text-area-field textarea::placeholder {
    color: var(--surface-placeholder);
  }

  .text-area-field textarea:focus {
    outline: none;
    border: 1.5px solid var(--bg-dark);
  }
</style>
