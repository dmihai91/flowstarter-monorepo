---
interface Props {
  title: string;
  category: string;
  color: string;
  imageSrc?: string;
  imageScale?: number;
  href?: string;
  className?: string;
}

const { title, category, color, imageSrc, imageScale = 1, href = '#', className = '' } = Astro.props;
---

<a href={href} class={`ds-case-card ${className}`.trim()}>
  <div
    class:list={['ds-case-card__image', { 'ds-case-card__image--blank': !imageSrc }]}
    style={imageSrc ? undefined : `--block-color: ${color};`}
  >
    {imageSrc ? (
      <img
        class="ds-case-card__media"
        src={imageSrc}
        alt={title}
        loading="lazy"
        style={`transform: scale(${imageScale});`}
      />
    ) : (
      <>
        <span class="ds-case-card__grain" aria-hidden="true"></span>
        <span class="ds-case-card__tag">{category}</span>
        <span class="ds-case-card__plus" aria-hidden="true">View job &#8599;</span>
      </>
    )}
  </div>
  <div class="ds-case-card__info">
    <div class="ds-case-card__title-row">
      <h3 class="ds-case-card__title">{title}</h3>
      <span class="ds-case-card__headline-arrow" aria-hidden="true">&#8599;</span>
    </div>
    <span class="ds-case-card__category">{category}</span>
  </div>
</a>

<style>
  .ds-case-card {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition);
  }

  .ds-case-card:hover {
    transform: translateY(-4px);
  }

  .ds-case-card__image {
    aspect-ratio: 161 / 140;
    position: relative;
    overflow: hidden;
  }

  /* Textured colour-block for jobs without a photo yet */
  .ds-case-card__image--blank {
    background-color: var(--block-color, #b96d28);
    background-image:
      radial-gradient(circle at 82% 14%, rgba(255, 255, 255, 0.16), transparent 44%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(0, 0, 0, 0.22));
  }

  .ds-case-card__grain {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      94deg,
      rgba(0, 0, 0, 0.13) 0px,
      rgba(0, 0, 0, 0.13) 2px,
      transparent 2px,
      transparent 22px
    );
    opacity: 0.7;
  }

  .ds-case-card__tag {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 1;
    padding: 7px 14px;
    background: rgba(20, 16, 13, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    font-family: var(--font-title);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    backdrop-filter: blur(4px);
  }

  .ds-case-card__plus {
    position: absolute;
    bottom: 20px;
    left: 20px;
    z-index: 1;
    color: #fff;
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition), transform var(--transition);
  }

  .ds-case-card:hover .ds-case-card__plus {
    opacity: 1;
    transform: translateY(0);
  }

  .ds-case-card__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform-origin: center;
  }

  .ds-case-card__info {
    padding: 16px 4px;
  }

  .ds-case-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .ds-case-card__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    margin-bottom: 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--transition);
  }

  .ds-case-card:hover .ds-case-card__title {
    text-decoration-color: var(--bg-dark);
  }

  .ds-case-card__headline-arrow {
    font-size: 1.75rem;
    color: var(--bg-dark);
    line-height: 1;
    margin-left: auto;
    flex-shrink: 0;
    transition: transform var(--transition);
  }

  .ds-case-card:hover .ds-case-card__headline-arrow {
    transform: translate(2px, -2px);
  }

  .ds-case-card__category {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
