---
interface CircleText {
  line1: string;
  line2?: string;
}

interface Props {
  circles: CircleText[];
  className?: string;
}

const { circles = [], className = '' } = Astro.props;
const toneClasses = [
  'ds-venn-statement__circle--think-more',
  'ds-venn-statement__circle--ask-a-lot',
  'ds-venn-statement__circle--design-less',
];
---

<div class={`ds-venn-statement ${className}`.trim()} data-venn-statement>
  {circles.map((circle, index) => (
    <div
      class={`ds-venn-statement__circle ${toneClasses[index % toneClasses.length]}`}
      data-venn-circle
      style="--circle-opacity: 1; --circle-y: 0px; --circle-scale-x: 1; --circle-scale-y: 1;"
    >
      <span>
        {circle.line1}
        {circle.line2 && <><br />{circle.line2}</>}
      </span>
    </div>
  ))}
</div>

<style>
  .ds-venn-statement {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    padding: 16px 24px;
    margin: 60px auto;
    max-width: 760px;
  }

  .ds-venn-statement__circle {
    width: 190px;
    height: 190px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: var(--fw-black);
    letter-spacing: 1.5px;
    line-height: 1.3;
    opacity: var(--circle-opacity, 0);
    transform:
      translateY(var(--circle-y, -96px))
      scaleX(var(--circle-scale-x, 0.94))
      scaleY(var(--circle-scale-y, 0.94));
    will-change: transform, opacity;
    transition:
      opacity 90ms linear,
      transform 90ms linear;
  }

  .ds-venn-statement__circle--think-more {
    background: var(--about-circle-think-more);
    color: var(--bg-dark);
  }

  .ds-venn-statement__circle--ask-a-lot {
    background: var(--about-circle-ask-a-lot);
    color: var(--bg-dark);
  }

  .ds-venn-statement__circle--design-less {
    background: var(--about-circle-design-less);
    color: var(--bg-dark);
  }

  @media (max-width: 768px) {
    .ds-venn-statement {
      gap: 12px;
      padding: 8px 0;
      margin: 40px auto;
    }

    .ds-venn-statement__circle {
      width: 110px;
      height: 110px;
      font-size: 0.78rem;
      letter-spacing: 0.8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-venn-statement__circle {
      opacity: 1;
      transform: none;
    }
  }
</style>
