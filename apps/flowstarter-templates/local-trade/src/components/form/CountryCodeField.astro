---
import type { CountryCodeOption } from '../../lib/contact-country-codes';

interface Props {
  label: string;
  name: string;
  options: CountryCodeOption[];
  defaultOption: CountryCodeOption;
}

const { label, name, options = [], defaultOption } = Astro.props;
---

<div
  class="country-code-field"
  data-country-picker
  data-default-label={`${defaultOption.flag} ${defaultOption.name} (${defaultOption.dial})`}
  data-default-code={defaultOption.dial}
>
  <span class="country-code-field__label">{label}</span>
  <input type="hidden" name={name} value={defaultOption.dial} data-country-input />
  <button type="button" class="country-code-field__trigger" data-country-trigger aria-expanded="false">
    <span data-country-label><span class="country-code-field__flag">{defaultOption.flag}</span> {defaultOption.name} ({defaultOption.dial})</span>
    <svg class="country-code-field__caret" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <div class="country-code-field__panel" data-country-panel hidden>
    <label class="country-code-field__search">
      <span class="country-code-field__sr-only">Search country code</span>
      <input type="search" placeholder="Search country or code" data-country-search />
    </label>
    <div class="country-code-field__options">
      {options.map((country) => (
        <button
          type="button"
          class="country-code-field__option"
          data-country-option
          data-country={country.name}
          data-code={country.dial}
          data-search={`${country.name.toLowerCase()} ${country.dial.toLowerCase()}`}
        >
          <span><span class="country-code-field__flag">{country.flag}</span> {country.name}</span>
          <span>{country.dial}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .country-code-field {
    position: relative;
    display: grid;
    gap: var(--form-field-gap, 10px);
  }

  .country-code-field__label {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    color: var(--bg-dark);
  }

  .country-code-field__trigger,
  .country-code-field__search input {
    width: 100%;
    min-height: var(--field-height, 58px);
    padding: 0 18px;
    border: 1px solid var(--surface-field-border);
    background: var(--surface-field);
    color: var(--bg-dark);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 1.4;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .country-code-field__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    text-align: left;
  }

  .country-code-field__flag {
    font-style: normal;
    font-size: 1.2em;
  }

  .country-code-field__caret {
    flex-shrink: 0;
    display: block;
    transition: transform var(--transition);
  }

  .country-code-field__trigger:focus,
  .country-code-field__search input:focus {
    outline: none;
    border-color: var(--bg-dark);
  }

  .country-code-field__search input::placeholder {
    color: var(--surface-placeholder);
  }

  .country-code-field__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 20;
    padding: 12px;
    background: var(--surface-base);
    border: 1px solid var(--surface-panel-border);
    box-shadow: var(--shadow-float);
  }

  .country-code-field__search {
    display: block;
    margin-bottom: 10px;
  }

  .country-code-field__options {
    display: grid;
    gap: 6px;
    max-height: 240px;
    overflow-y: auto;
  }

  .country-code-field__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid transparent;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--bg-dark);
    text-align: left;
    transition: background-color var(--transition), border-color var(--transition);
  }

  .country-code-field__option:hover,
  .country-code-field__option:focus-visible {
    background: var(--surface-selected);
    border-color: var(--surface-panel-border);
  }

  .country-code-field__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
