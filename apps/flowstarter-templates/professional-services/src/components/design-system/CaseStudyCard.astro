---
interface Props {
  title: string;
  category: string;
  color: string;
  imageSrc?: string;
  imageScale?: number;
  href?: string;
  className?: string;
}

const { title, category, color, imageSrc, imageScale = 1, href = '#', className = '' } = Astro.props;
---

<a href={href} class={`ds-case-card ${className}`.trim()}>
  <div class="ds-case-card__image" style={imageSrc ? undefined : `background-color: ${color};`}>
    {imageSrc && (
      <img
        class="ds-case-card__media"
        src={imageSrc}
        alt={title}
        loading="lazy"
        style={`transform: scale(${imageScale});`}
      />
    )}
  </div>
  <div class="ds-case-card__info">
    <div class="ds-case-card__title-row">
      <h3 class="ds-case-card__title">{title}</h3>
      <span class="ds-case-card__headline-arrow" aria-hidden="true">&#8599;</span>
    </div>
    <span class="ds-case-card__category">{category}</span>
  </div>
</a>

<style>
  .ds-case-card {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition);
  }

  .ds-case-card:hover {
    transform: translateY(-4px);
  }

  .ds-case-card__image {
    aspect-ratio: 161 / 140;
    position: relative;
    overflow: hidden;
  }

  .ds-case-card__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform-origin: center;
  }

  .ds-case-card__info {
    padding: 16px 4px;
  }

  .ds-case-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .ds-case-card__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    margin-bottom: 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--transition);
  }

  .ds-case-card:hover .ds-case-card__title {
    text-decoration-color: var(--bg-dark);
  }

  .ds-case-card__headline-arrow {
    font-size: 1.75rem;
    color: var(--bg-dark);
    line-height: 1;
    margin-left: auto;
    flex-shrink: 0;
    transition: transform var(--transition);
  }

  .ds-case-card:hover .ds-case-card__headline-arrow {
    transform: translate(2px, -2px);
  }

  .ds-case-card__category {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
