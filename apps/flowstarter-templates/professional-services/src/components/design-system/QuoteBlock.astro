---
interface Props {
  quote: string;
  className?: string;
}

const { quote, className = '' } = Astro.props;
---

<p class={`ds-quote-block ${className}`.trim()}>
  {quote}
</p>

<style>
  .ds-quote-block {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    color: var(--bg-dark);
    margin-bottom: 40px;
    font-style: normal;
  }
</style>
