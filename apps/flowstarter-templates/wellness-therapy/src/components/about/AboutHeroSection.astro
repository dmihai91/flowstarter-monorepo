---
import type { TitleLine } from '../../lib/site-data';
import AnimatedWordTitle from '../shared/AnimatedWordTitle.astro';

interface Props {
  heroLines: TitleLine[];
}

const { heroLines } = Astro.props;
---

<section class="about-hero-section container">
  <div class="about-hero-section__copy">
    <AnimatedWordTitle
      as="h1"
      lines={heroLines}
      autoplay={true}
      centered={true}
      className="about-hero-section__title"
    />
  </div>
</section>

<style>
  .about-hero-section {
    --hero-top-space: 72px;
    --hero-max-width: 1440px;
    max-width: var(--hero-max-width);
    padding-top: var(--hero-top-space);
  }

  .about-hero-section__copy {
    margin: 0 auto;
    text-align: center;
  }

  :global(.about-hero-section__title) {
    font-family: var(--font-title);
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  :global(.about-hero-section__title) :global(.animated-word-title__line) {
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .about-hero-section {
      max-width: var(--container-width);
      padding-top: 48px;
    }

    :global(.about-hero-section__title) {
      font-size: 2.5rem;
    }

    :global(.about-hero-section__title) :global(.animated-word-title__line) {
      white-space: normal;
    }
  }
</style>
