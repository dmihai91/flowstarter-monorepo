---
import OrganicVisual from './OrganicVisual.astro';

interface Props {
  title: string;
  category: string;
  color: string;
  imageSrc?: string;
  imageScale?: number;
  description?: string;
  href?: string;
  className?: string;
}

const {
  title,
  category,
  color,
  imageSrc,
  imageScale = 1,
  description = '',
  href = '#',
  className = '',
} = Astro.props;

const hasImage = typeof imageSrc === 'string' && imageSrc.trim() !== '';
---

<a href={href} class={`ds-case-card ${className}`.trim()}>
  <div class="ds-case-card__image">
    {hasImage ? (
      <img
        class="ds-case-card__media"
        src={imageSrc}
        alt={title}
        loading="lazy"
        style={`transform: scale(${imageScale});`}
      />
    ) : (
      <div class="ds-case-card__visual" style={`--card-tint: ${color};`}>
        <OrganicVisual tone="deep" bare={true} breathe={false} ariaLabel={category} className="ds-case-card__organic" />
        <span class="ds-case-card__badge">{category}</span>
      </div>
    )}
  </div>
  <div class="ds-case-card__info">
    <div class="ds-case-card__title-row">
      <h3 class="ds-case-card__title">{title}</h3>
      <span class="ds-case-card__headline-arrow" aria-hidden="true">&#8599;</span>
    </div>
    {description ? (
      <p class="ds-case-card__desc">{description}</p>
    ) : (
      <span class="ds-case-card__category">{category}</span>
    )}
  </div>
</a>

<style>
  .ds-case-card {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition);
  }

  .ds-case-card:hover {
    transform: translateY(-4px);
  }

  .ds-case-card__image {
    aspect-ratio: 161 / 140;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .ds-case-card__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform-origin: center;
  }

  .ds-case-card__visual {
    position: absolute;
    inset: 0;
  }

  .ds-case-card__visual :global(.ds-case-card__organic) {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 78% 12%, color-mix(in srgb, var(--card-tint, #3f5147) 55%, transparent), transparent 60%),
      linear-gradient(160deg,
        color-mix(in srgb, var(--card-tint, #3f5147) 88%, #1b211c) 0%,
        color-mix(in srgb, var(--card-tint, #3f5147) 70%, #1b211c) 100%);
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ds-case-card:hover .ds-case-card__visual :global(.ds-case-card__organic) {
    transform: scale(1.04);
  }

  .ds-case-card__badge {
    position: absolute;
    left: 18px;
    top: 18px;
    z-index: 4;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    padding: 7px 14px;
    border: 1px solid rgba(244, 241, 234, 0.32);
    border-radius: 999px;
    backdrop-filter: blur(2px);
  }

  .ds-case-card__info {
    padding: 20px 4px 4px;
  }

  .ds-case-card__desc {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text-body);
    margin-top: 8px;
    max-width: 38ch;
  }

  .ds-case-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .ds-case-card__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    margin-bottom: 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--transition);
  }

  .ds-case-card:hover .ds-case-card__title {
    text-decoration-color: var(--bg-dark);
  }

  .ds-case-card__headline-arrow {
    font-size: 1.75rem;
    color: var(--bg-dark);
    line-height: 1;
    margin-left: auto;
    flex-shrink: 0;
    transition: transform var(--transition);
  }

  .ds-case-card:hover .ds-case-card__headline-arrow {
    transform: translate(2px, -2px);
  }

  .ds-case-card__category {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
