---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  links: LinkItem[];
  className?: string;
  linkClassName?: string;
  targetBlank?: boolean;
}

const {
  links,
  className = '',
  linkClassName = '',
  targetBlank = false,
} = Astro.props;

const rel = targetBlank ? 'noopener noreferrer' : undefined;
const target = targetBlank ? '_blank' : undefined;
---

<div class={`ds-social-text-list ${className}`.trim()}>
  {links.map((item) => (
    <a href={item.href} class={`ds-social-text-link ${linkClassName}`.trim()} target={target} rel={rel}>
      {item.label}
    </a>
  ))}
</div>

<style>
  .ds-social-text-list {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ds-social-text-link {
    font-size: var(--fs-small);
    color: var(--text-secondary);
    transition: color var(--transition);
    letter-spacing: 0.5px;
  }

  .ds-social-text-link:hover {
    color: var(--accent);
  }
</style>
