---
import type { TitleLine } from '../../lib/site-data';

interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5';
  lines: TitleLine[];
  className?: string;
  revealName?: string;
  autoplay?: boolean;
  centered?: boolean;
}

const { as = 'h1', lines = [], className = '', revealName, autoplay = false, centered = false } = Astro.props;
const Tag = as;
const splitWords = (value = '') => value.split(' ').filter(Boolean);
let wordIndex = 0;
---

<Tag
  class={`animated-word-title ${autoplay ? 'animated-word-title--autoplay' : ''} ${centered ? 'animated-word-title--centered' : ''} ${className}`.trim()}
  data-reveal={revealName}
>
  {lines.map((line) => (
    <span class="animated-word-title__line">
      {splitWords(line.text).map((word) => {
        const delay = wordIndex * 70;
        wordIndex += 1;
        return (
          <span class="animated-word-title__word" style={`--word-delay:${delay}ms;`}>
            {word}
          </span>
        );
      })}
      {splitWords(line.accent).map((word) => {
        const delay = wordIndex * 70;
        wordIndex += 1;
        return (
          <span class="animated-word-title__word animated-word-title__word--accent" style={`--word-delay:${delay}ms;`}>
            {word}
          </span>
        );
      })}
    </span>
  ))}
</Tag>

<style>
  .animated-word-title {
    text-transform: uppercase;
    color: var(--bg-dark);
  }

  .animated-word-title__line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    line-height: inherit;
  }

  .animated-word-title--centered .animated-word-title__line {
    justify-content: center;
  }

  .animated-word-title__word {
    display: inline-block;
    margin-right: 0;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--word-delay, 0ms);
    will-change: transform, opacity;
  }

  .animated-word-title.is-observing:not(.is-visible) .animated-word-title__word {
    opacity: 0;
    transform: translateY(18px);
  }

  .animated-word-title__word--accent {
    color: var(--brand-primary);
  }

  .animated-word-title.is-visible .animated-word-title__word {
    opacity: 1;
    transform: translateY(0);
  }

  .animated-word-title--autoplay .animated-word-title__word {
    opacity: 0;
    transform: translateY(18px);
    animation: animated-word-title-enter 560ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--word-delay, 0ms);
  }

  @keyframes animated-word-title-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animated-word-title__word {
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
    }
  }
</style>
