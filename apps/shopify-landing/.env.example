# Which site config to build — resolves sites/<VITE_SITE>.ts. Default: lebadusul
VITE_SITE=lebadusul

# Publishable key for the workspace's Clerk instance (the SAME instance the
# editor uses). Public by design — baked into the SPA. Enables the live "edits
# this month" tile by minting a session token for /api/clerk/usage. Omit for a
# static, no-auth build (the tile then shows a neutral "—").
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
