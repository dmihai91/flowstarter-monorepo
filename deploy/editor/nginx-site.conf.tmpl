# Per-workspace editor vhost TEMPLATE. onboard-client.sh renders this
# (substituting __SLUG__ / __PORT__ / __BASE_DOMAIN__) into
# /etc/nginx/sites-available/flowstarter-editor-__SLUG__.conf and
# symlinks it into sites-enabled.
#
# Requires the shared map + CF real-ip from
# deploy/editor/nginx-shared.conf (installed once in conf.d).
#
# TLS: Cloudflare Origin Certificate (SSL mode = Full (strict)). Adjust
# the cert paths to your install. The cert can be a single wildcard
# (*.app.__BASE_DOMAIN__) reused by every per-slug vhost.

server {
    listen 80;
    listen [::]:80;
    server_name __SLUG__.app.__BASE_DOMAIN__;
    # CF talks to the origin over 443; bounce any plaintext.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __SLUG__.app.__BASE_DOMAIN__;

    # Cloudflare Origin Certificate (wildcard for *.app.__BASE_DOMAIN__).
    ssl_certificate     /etc/ssl/flowstarter/origin.pem;
    ssl_certificate_key /etc/ssl/flowstarter/origin.key;

    # The editor is an app, not a cacheable site: never let an
    # intermediary cache it. (Cloudflare cache rule for *.app.* should
    # also be Bypass — see docs/EDITOR_DEPLOYMENT.md.)
    add_header Cache-Control "no-store" always;

    # Generous bodies for image/file uploads into the workspace.
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;

        # WebSocket upgrade (editor live channel).
        proxy_set_header Upgrade            $http_upgrade;
        proxy_set_header Connection         $connection_upgrade;

        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  https;
        proxy_set_header X-Forwarded-Host   $host;

        # Long-lived: websockets + multi-minute agent jobs. Don't let
        # nginx kill an in-flight `claude` turn.
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering     off;
    }
}
