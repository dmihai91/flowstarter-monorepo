{
  "name": "flowstarter",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "mprocs",
    "dev:main": "pnpm nx run flowstarter-main:dev --output-style=stream",
    "docker:dev:main:up": "docker compose -f docker-compose.flowstarter-main-dev.yml up -d --build",
    "docker:dev:main:down": "docker compose -f docker-compose.flowstarter-main-dev.yml down",
    "docker:dev:main:logs": "docker compose -f docker-compose.flowstarter-main-dev.yml logs -f flowstarter-main-dev",
    "docker:dev:main:restart": "docker compose -f docker-compose.flowstarter-main-dev.yml restart flowstarter-main-dev",
    "build:all": "pnpm nx run-many -t build --output-style=stream",
    "lint:all": "pnpm nx run-many -t lint --output-style=stream --fix",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "stripe:setup:dry": "tsx scripts/stripe-setup.ts --dry-run",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "dev:deploy-agent": "DEPLOY_AGENT_SHARED_SECRET=dev-secret DEPLOY_AGENT_SITES_ROOT=/tmp/fs-sites DEPLOY_AGENT_CADDY_SITES_DIR=/tmp/fs-caddy-sites DEPLOY_AGENT_CADDY_RELOAD_CMD='echo reloaded' pnpm --dir apps/deploy-agent dev",
    "dev:editor": "bash scripts/dev-editor.sh",
    "dev:editor:hmr": "bash scripts/dev-editor-hmr.sh",
    "dev:editor:plain": "pnpm --dir apps/flowstarter-editor dev",
    "dev:editor:full": "pnpm --dir apps/flowstarter-editor dev:full",
    "dev:editor:server": "pnpm --dir apps/flowstarter-editor dev:server",
    "dev:editor:web": "pnpm --dir apps/flowstarter-editor dev:web",
    "build:editor:web": "pnpm --dir apps/flowstarter-editor build:web",
    "supabase:login": "pnpm dlx supabase login",
    "db:link": "pnpm dlx supabase link --project-ref avptvzherjxymmbtbbbr",
    "db:start": "pnpm dlx supabase start",
    "db:stop": "pnpm dlx supabase stop",
    "db:pull": "pnpm dlx supabase db pull",
    "db:push": "pnpm dlx supabase db push",
    "db:reset": "pnpm dlx supabase db reset",
    "db:rollback": "pnpm dlx supabase db rollback",
    "dev:supabase": "pnpm run db:start",
    "staging:start": "pnpm --filter flowstarter-main build && pm2 startOrReload ecosystem.config.cjs && pm2 list",
    "staging:stop": "pm2 stop ecosystem.config.cjs",
    "staging:restart": "pm2 reload ecosystem.config.cjs",
    "staging:delete": "pm2 delete ecosystem.config.cjs",
    "staging:status": "pm2 list",
    "staging:monit": "pm2 monit",
    "staging:logs": "pm2 logs",
    "staging:logs:main": "pm2 logs flowstarter-main",
    "staging:save": "pm2 save",
    "staging:flush": "pm2 flush",
    "ci:lint": "pnpm --dir apps/flowstarter-main lint || true",
    "ci:typecheck": "pnpm nx run-many -t build --projects=flow-design-system --output-style=stream-without-prefixes && pnpm nx run flowstarter-main:typecheck",
    "ci:test": "pnpm nx run flowstarter-main:test",
    "ci:quality-gate": "pnpm run ci:lint && pnpm run ci:typecheck && pnpm run ci:test",
    "ci:smoke:platform": "pnpm exec playwright test --config playwright.config.ts",
    "ci:smoke": "pnpm run ci:smoke:platform",
    "prepare": "husky"
  },
  "devDependencies": {
    "@nx/eslint": "^22.4.5",
    "@nx/eslint-plugin": "22.4.5",
    "@nx/js": "^22.4.5",
    "@nx/next": "^22.4.5",
    "@nx/node": "^22.4.5",
    "@nx/react": "^22.4.5",
    "@playwright/test": "^1.58.2",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "concurrently": "^7.6.0",
    "dotenv": "^17.3.0",
    "husky": "^9.1.7",
    "mprocs": "^0.8.3",
    "nx": "22.7.7",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "stripe": "^20.4.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.0",
      "@types/react-dom": "19.1.2",
      "jsondiffpatch": "^0.7.2",
      "@effect/platform": "0.96.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    },
    "onlyBuiltDependencies": [
      "node-pty",
      "bufferutil",
      "utf-8-validate",
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "@swc/core",
      "msgpackr-extract"
    ]
  }
}
