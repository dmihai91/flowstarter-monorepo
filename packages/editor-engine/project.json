{
  "name": "@flowstarter/editor-engine",
  "projectType": "library",
  "tags": ["pkg:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "packages/editor-engine"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/editor-engine"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
